@model HousingAllotmentManagementSystem.Models.Allotment

@{
    ViewData["Title"] = "Create Allotment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-house-add text-primary me-2"></i>
                Create Allotment
            </h2>

            <p class="text-muted mb-0">
                Create a new property allotment record.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Allotments

        </a>

    </div>


    <!-- MAIN CARD -->
    <div class="row justify-content-center">

        <div class="col-xl-10 col-lg-11">

            <div class="card border-0 shadow-sm">

                <!-- CARD HEADER -->
                <div class="card-header bg-primary text-white py-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">

                            <i class="bi bi-house-check fs-5"></i>

                        </div>

                        <div>

                            <h5 class="mb-0">
                                Allotment Information
                            </h5>

                            <small class="opacity-75">
                                Enter the details of the property allotment
                            </small>

                        </div>

                    </div>

                </div>


                <!-- CARD BODY -->
                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- VALIDATION SUMMARY -->
                        <div asp-validation-summary="All"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- APPLICATION & PROPERTY -->
                        <div class="mb-4">

                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-4">

                                <i class="bi bi-link-45deg me-2"></i>
                                Application & Property

                            </h6>


                            <div class="row g-4">

                                <!-- APPLICATION -->
                                <div class="col-md-6">

                                    <label asp-for="ApplicationId"
                                           class="form-label fw-semibold">

                                        <i class="bi bi-file-earmark-text me-1"></i>
                                        Application

                                    </label>

                                    <select asp-for="ApplicationId"
                                            asp-items="ViewBag.ApplicationId"
                                            class="form-select">

                                        <option value="">
                                            -- Select Application --
                                        </option>

                                    </select>

                                    <span asp-validation-for="ApplicationId"
                                          class="text-danger">
                                    </span>

                                    <small class="text-muted">
                                        Select the approved housing application.
                                    </small>

                                </div>


                                <!-- PROPERTY -->
                                <div class="col-md-6">

                                    <label for="PropertyId"
                                           class="form-label fw-semibold">

                                        <i class="bi bi-house me-1"></i>
                                        Property

                                    </label>

                                    <select id="PropertyId"
                                            name="PropertyId"
                                            class="form-select">

                                        <option value="0">
                                            -- Select Property --
                                        </option>

                                        @foreach (var property in ViewBag.PropertyId as SelectList)
                                        {
                                            <option value="@property.Value"
                                                    selected="@(property.Selected ? "selected" : null)">

                                                Property #@property.Value

                                            </option>
                                        }

                                    </select>

                                    <span asp-validation-for="PropertyId"
                                          class="text-danger">
                                    </span>

                                    <small class="text-muted">
                                        Select the property being allotted.
                                    </small>

                                </div>

                        <!-- ALLOTMENT DETAILS -->
                        <div class="mb-4">

                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-4">

                                <i class="bi bi-clipboard-check me-2"></i>
                                Allotment Details

                            </h6>


                            <div class="row g-4">

                                <!-- ALLOTMENT NUMBER -->
                                <div class="col-md-6">

                                    <label asp-for="AllotmentNumber"
                                           class="form-label fw-semibold">

                                        <i class="bi bi-hash me-1"></i>
                                        Allotment Number

                                    </label>

                                    <input asp-for="AllotmentNumber"
                                           class="form-control"
                                           placeholder="Example: ALT-0001"
                                           autocomplete="off" />

                                    <span asp-validation-for="AllotmentNumber"
                                          class="text-danger">
                                    </span>

                                    <small class="text-muted">
                                        This number must be unique.
                                    </small>

                                </div>


                                <!-- ALLOTMENT DATE -->
                                <div class="col-md-6">

                                    <label asp-for="AllotmentDate"
                                           class="form-label fw-semibold">

                                        <i class="bi bi-calendar3 me-1"></i>
                                        Allotment Date

                                    </label>

                                    <input asp-for="AllotmentDate"
                                           type="date"
                                           class="form-control" />

                                    <span asp-validation-for="AllotmentDate"
                                          class="text-danger">
                                    </span>

                                </div>


                                <!-- BOOKING AMOUNT -->
                                <div class="col-md-6">

                                    <label asp-for="BookingAmount"
                                           class="form-label fw-semibold">

                                        <i class="bi bi-currency-rupee me-1"></i>
                                        Booking Amount

                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            ₹
                                        </span>

                                        <input asp-for="BookingAmount"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control"
                                               placeholder="0.00" />

                                    </div>

                                    <span asp-validation-for="BookingAmount"
                                          class="text-danger">
                                    </span>

                                </div>


                                <!-- STATUS -->
                                <div class="col-md-6">

                                    <label asp-for="AllotmentStatus"
                                           class="form-label fw-semibold">

                                        <i class="bi bi-toggle-on me-1"></i>
                                        Allotment Status

                                    </label>

                                    <select asp-for="AllotmentStatus"
                                            class="form-select">

                                        <option value="">
                                            -- Select Status --
                                        </option>

                                        <option value="Pending">
                                            Pending
                                        </option>

                                        <option value="Active">
                                            Active
                                        </option>

                                        <option value="Completed">
                                            Completed
                                        </option>

                                        <option value="Cancelled">
                                            Cancelled
                                        </option>

                                    </select>

                                    <span asp-validation-for="AllotmentStatus"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- REMARKS -->
                        <div class="mb-4">

                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-4">

                                <i class="bi bi-chat-left-text me-2"></i>
                                Additional Information

                            </h6>

                            <label asp-for="Remarks"
                                   class="form-label fw-semibold">

                                Remarks

                            </label>

                            <textarea asp-for="Remarks"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter any additional remarks or notes..."></textarea>

                            <span asp-validation-for="Remarks"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- INFORMATION BOX -->
                        <div class="alert alert-info border-0">

                            <div class="d-flex align-items-start">

                                <i class="bi bi-info-circle-fill fs-5 me-3"></i>

                                <div>

                                    <strong>
                                        Important
                                    </strong>

                                    <p class="mb-0 mt-1">

                                        Make sure the selected Application
                                        and Property are correct.
                                        The Allotment Number must be unique.

                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- BUTTONS -->
                        <div class="border-top pt-4 mt-4">

                            <div class="d-flex justify-content-end gap-2">

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary px-4">

                                    <i class="bi bi-x-circle me-1"></i>
                                    Cancel

                                </a>


                                <button type="reset"
                                        class="btn btn-outline-warning px-4">

                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                    Reset

                                </button>


                                <button type="submit"
                                        class="btn btn-primary px-4">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Create Allotment

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}