@model HousingAllotmentManagementSystem.Models.Allotment

@{
    ViewData["Title"] = "Edit Allotment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- PAGE HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-pencil-square text-primary me-2"></i>
            Edit Allotment
        </h2>

        <p class="text-muted mb-0">
            Update the details of the property allotment.
        </p>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Allotments

        </a>

        <a asp-action="Details"
           asp-route-id="@Model.AllotmentId"
           class="btn btn-outline-info">

            <i class="bi bi-eye me-1"></i>
            View Details

        </a>

    </div>

</div>


<!-- MAIN CARD -->
<div class="row justify-content-center">

    <div class="col-xl-10 col-lg-11">

        <div class="card border-0 shadow-sm">

            <!-- CARD HEADER -->
            <div class="card-header bg-primary text-white py-3">

                <div class="d-flex align-items-center">

                    <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">

                        <i class="bi bi-pencil-square fs-5"></i>

                    </div>

                    <div>

                        <h5 class="mb-0">
                            Edit Allotment
                        </h5>

                        <small class="opacity-75">
                            Allotment ID: #@Model.AllotmentId
                        </small>

                    </div>

                </div>

            </div>


            <!-- CARD BODY -->
            <div class="card-body p-4">

                <form asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- IMPORTANT HIDDEN ID -->
                    <input type="hidden"
                           asp-for="AllotmentId" />


                    <!-- VALIDATION SUMMARY -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>


                    <!-- APPLICATION & PROPERTY -->
                    <div class="mb-4">

                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-4">

                            <i class="bi bi-link-45deg me-2"></i>
                            Application & Property

                        </h6>


                        <div class="row g-4">

                            <!-- APPLICATION -->
                            <div class="col-md-6">

                                <label for="ApplicationId"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-file-earmark-text me-1"></i>
                                    Application

                                </label>


                                <select id="ApplicationId"
                                        name="ApplicationId"
                                        class="form-select">

                                    <option value="0">
                                        -- Select Application --
                                    </option>


                                    @foreach (var application in ViewBag.ApplicationId as Microsoft.AspNetCore.Mvc.Rendering.SelectList)
                                    {
                                        if (application.Value == Model.ApplicationId.ToString())
                                        {
                                            <option value="@application.Value"
                                                    selected>

                                                Application #@application.Value

                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@application.Value">

                                                Application #@application.Value

                                            </option>
                                        }
                                    }

                                </select>


                                <span asp-validation-for="ApplicationId"
                                      class="text-danger">
                                </span>


                                <small class="text-muted">
                                    Select the application for this allotment.
                                </small>

                            </div>


                            <!-- PROPERTY -->
                            <div class="col-md-6">

                                <label for="PropertyId"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-house me-1"></i>
                                    Property

                                </label>


                                <select id="PropertyId"
                                        name="PropertyId"
                                        class="form-select">

                                    <option value="0">
                                        -- Select Property --
                                    </option>


                                    @foreach (var property in ViewBag.PropertyId as Microsoft.AspNetCore.Mvc.Rendering.SelectList)
                                    {
                                        if (property.Value == Model.PropertyId.ToString())
                                        {
                                            <option value="@property.Value"
                                                    selected>

                                                Property #@property.Value

                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@property.Value">

                                                Property #@property.Value

                                            </option>
                                        }
                                    }

                                </select>


                                <span asp-validation-for="PropertyId"
                                      class="text-danger">
                                </span>


                                <small class="text-muted">
                                    Select the property being allotted.
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- ALLOTMENT DETAILS -->
                    <div class="mb-4">

                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-4">

                            <i class="bi bi-clipboard-check me-2"></i>
                            Allotment Details

                        </h6>


                        <div class="row g-4">

                            <!-- ALLOTMENT NUMBER -->
                            <div class="col-md-6">

                                <label asp-for="AllotmentNumber"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-hash me-1"></i>
                                    Allotment Number

                                </label>


                                <input asp-for="AllotmentNumber"
                                       class="form-control"
                                       placeholder="Enter allotment number" />


                                <span asp-validation-for="AllotmentNumber"
                                      class="text-danger">
                                </span>


                                <small class="text-muted">
                                    Allotment number must be unique.
                                </small>

                            </div>


                            <!-- ALLOTMENT DATE -->
                            <div class="col-md-6">

                                <label asp-for="AllotmentDate"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-calendar3 me-1"></i>
                                    Allotment Date

                                </label>


                                <input asp-for="AllotmentDate"
                                       type="date"
                                       class="form-control" />


                                <span asp-validation-for="AllotmentDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- BOOKING AMOUNT -->
                            <div class="col-md-6">

                                <label asp-for="BookingAmount"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-currency-rupee me-1"></i>
                                    Booking Amount

                                </label>


                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>


                                    <input asp-for="BookingAmount"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="0.00" />

                                </div>


                                <span asp-validation-for="BookingAmount"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- STATUS -->
                            <div class="col-md-6">

                                <label asp-for="AllotmentStatus"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-toggle-on me-1"></i>
                                    Allotment Status

                                </label>


                                <select asp-for="AllotmentStatus"
                                        class="form-select">

                                    <option value="">
                                        -- Select Status --
                                    </option>

                                    <option value="Pending">
                                        Pending
                                    </option>

                                    <option value="Active">
                                        Active
                                    </option>

                                    <option value="Completed">
                                        Completed
                                    </option>

                                    <option value="Cancelled">
                                        Cancelled
                                    </option>

                                </select>


                                <span asp-validation-for="AllotmentStatus"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- REMARKS -->
                    <div class="mb-4">

                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-4">

                            <i class="bi bi-chat-left-text me-2"></i>
                            Additional Information

                        </h6>


                        <div>

                            <label asp-for="Remarks"
                                   class="form-label fw-semibold">

                                Remarks

                            </label>


                            <textarea asp-for="Remarks"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter additional remarks..."></textarea>


                            <span asp-validation-for="Remarks"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- CREATED DATE -->
                    <div class="alert alert-light border">

                        <div class="d-flex align-items-center">

                            <i class="bi bi-calendar-plus text-primary fs-5 me-3"></i>

                            <div>

                                <strong>
                                    Record Created
                                </strong>

                                <div class="text-muted small">

                                    @Model.CreatedDate.ToString(
                                        "dd MMM yyyy, hh:mm tt"
                                    )

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- BUTTONS -->
                    <div class="border-top pt-4 mt-4">

                        <div class="d-flex justify-content-between">

                            <!-- DELETE -->
                            <a asp-action="Delete"
                               asp-route-id="@Model.AllotmentId"
                               class="btn btn-outline-danger px-4">

                                <i class="bi bi-trash me-1"></i>
                                Delete

                            </a>


                            <div class="d-flex gap-2">

                                <!-- CANCEL -->
                                <a asp-action="Index"
                                   class="btn btn-outline-secondary px-4">

                                    <i class="bi bi-x-circle me-1"></i>
                                    Cancel

                                </a>


                                <!-- SAVE -->
                                <button type="submit"
                                        class="btn btn-primary px-4">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Save Changes

                                </button>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}