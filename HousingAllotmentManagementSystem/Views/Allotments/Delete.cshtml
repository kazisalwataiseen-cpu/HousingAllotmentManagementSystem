@model HousingAllotmentManagementSystem.Models.Allotment

@{
    ViewData["Title"] = "Delete Allotment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-trash text-danger me-2"></i>
                Delete Allotment
            </h2>

            <p class="text-muted mb-0">
                Review the allotment before permanently deleting it.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Allotments

        </a>

    </div>


    <!-- DELETE CARD -->
    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm">

                <!-- CARD HEADER -->
                <div class="card-header bg-danger text-white py-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">

                            <i class="bi bi-trash fs-5"></i>

                        </div>

                        <div>

                            <h5 class="mb-0">
                                Confirm Deletion
                            </h5>

                            <small class="opacity-75">
                                Allotment ID: #@Model.AllotmentId
                            </small>

                        </div>

                    </div>

                </div>


                <!-- CARD BODY -->
                <div class="card-body p-4">

                    <!-- WARNING -->
                    <div class="alert alert-danger border-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                            <div>

                                <h6 class="fw-bold mb-1">
                                    Are you sure you want to delete this allotment?
                                </h6>

                                <p class="mb-0">
                                    This action cannot be undone. Please review
                                    the allotment information before continuing.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- ALLOTMENT INFORMATION -->
                    <div class="border rounded p-4 mt-4">

                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-4">

                            <i class="bi bi-house-check me-2"></i>
                            Allotment Information

                        </h6>


                        <div class="row g-4">

                            <!-- ALLOTMENT NUMBER -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">

                                    <i class="bi bi-hash me-1"></i>
                                    Allotment Number

                                </div>

                                <div class="fw-bold fs-5">

                                    @Model.AllotmentNumber

                                </div>

                            </div>


                            <!-- ALLOTMENT ID -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">

                                    <i class="bi bi-fingerprint me-1"></i>
                                    Allotment ID

                                </div>

                                <div class="fw-semibold fs-5">

                                    #@Model.AllotmentId

                                </div>

                            </div>


                            <!-- APPLICATION -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">

                                    <i class="bi bi-file-earmark-text me-1"></i>
                                    Application

                                </div>

                                <div class="fw-semibold">

                                    Application #@Model.ApplicationId

                                </div>

                            </div>


                            <!-- PROPERTY -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">

                                    <i class="bi bi-house me-1"></i>
                                    Property

                                </div>

                                <div class="fw-semibold">

                                    Property #@Model.PropertyId

                                </div>

                            </div>


                            <!-- DATE -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">

                                    <i class="bi bi-calendar3 me-1"></i>
                                    Allotment Date

                                </div>

                                <div class="fw-semibold">

                                    @Model.AllotmentDate.ToString("dd MMM yyyy")

                                </div>

                            </div>


                            <!-- BOOKING AMOUNT -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">

                                    <i class="bi bi-currency-rupee me-1"></i>
                                    Booking Amount

                                </div>

                                <div class="fw-bold fs-5 text-success">

                                    ₹@Model.BookingAmount.ToString("N2")

                                </div>

                            </div>


                            <!-- STATUS -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-2">

                                    <i class="bi bi-toggle-on me-1"></i>
                                    Status

                                </div>

                                @if (Model.AllotmentStatus.Equals(
                                "Active",
                                StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2">

                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        Active

                                    </span>
                                }
                                else if (Model.AllotmentStatus.Equals(
                                "Pending",
                                StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-warning-subtle text-warning px-3 py-2">

                                        <i class="bi bi-hourglass-split me-1"></i>
                                        Pending

                                    </span>
                                }
                                else if (Model.AllotmentStatus.Equals(
                                "Completed",
                                StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-info-subtle text-info px-3 py-2">

                                        <i class="bi bi-check2-all me-1"></i>
                                        Completed

                                    </span>
                                }
                                else if (Model.AllotmentStatus.Equals(
                                "Cancelled",
                                StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2">

                                        <i class="bi bi-x-circle-fill me-1"></i>
                                        Cancelled

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-3 py-2">

                                        @Model.AllotmentStatus

                                    </span>
                                }

                            </div>


                            <!-- CREATED DATE -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">

                                    <i class="bi bi-calendar-plus me-1"></i>
                                    Created Date

                                </div>

                                <div class="fw-semibold">

                                    @Model.CreatedDate.ToString("dd MMM yyyy")

                                </div>

                                <small class="text-muted">

                                    @Model.CreatedDate.ToString("hh:mm tt")

                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- REMARKS -->
                    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                    {
                        <div class="alert alert-light border mt-4">

                            <div class="d-flex align-items-start">

                                <i class="bi bi-chat-left-text text-primary fs-5 me-3"></i>

                                <div>

                                    <strong>
                                        Remarks
                                    </strong>

                                    <p class="mb-0 mt-1">
                                        @Model.Remarks
                                    </p>

                                </div>

                            </div>

                        </div>
                    }


                    <!-- LOAN WARNING -->
                    @if (Model.Loans != null && Model.Loans.Any())
                    {
                        <div class="alert alert-warning border-0 mt-4">

                            <div class="d-flex align-items-start">

                                <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>

                                <div>

                                    <strong>
                                        Related Loan Records Found
                                    </strong>

                                    <p class="mb-0 mt-1">

                                        This allotment has
                                        <strong>@Model.Loans.Count</strong>
                                        related loan record(s).
                                        The database may prevent deletion
                                        until the related records are handled.

                                    </p>

                                </div>

                            </div>

                        </div>
                    }

                </div>


                <!-- CARD FOOTER -->
                <div class="card-footer bg-white border-0 p-4">

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="AllotmentId" />


                        <div class="d-flex justify-content-between align-items-center">

                            <!-- LEFT -->
                            <div>

                                <a asp-action="Details"
                                   asp-route-id="@Model.AllotmentId"
                                   class="btn btn-outline-info px-4">

                                    <i class="bi bi-eye me-1"></i>
                                    View Details

                                </a>

                            </div>


                            <!-- RIGHT -->
                            <div class="d-flex gap-2">

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary px-4">

                                    <i class="bi bi-x-circle me-1"></i>
                                    Cancel

                                </a>


                                <button type="submit"
                                        class="btn btn-danger px-4">

                                    <i class="bi bi-trash me-1"></i>
                                    Delete Allotment

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>