@model IEnumerable<HousingAllotmentManagementSystem.Models.Allotment>

@{
    ViewData["Title"] = "Allotments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

var allotments =
    Model?.ToList()
    ?? new List<HousingAllotmentManagementSystem.Models.Allotment>();

    var totalAllotments = allotments.Count;

    var activeAllotments = allotments.Count(a =>
        !string.IsNullOrEmpty(a.AllotmentStatus) &&
        a.AllotmentStatus.Equals(
            "Active",
            StringComparison.OrdinalIgnoreCase));

    var pendingAllotments = allotments.Count(a =>
        !string.IsNullOrEmpty(a.AllotmentStatus) &&
        a.AllotmentStatus.Equals(
            "Pending",
            StringComparison.OrdinalIgnoreCase));

    var completedAllotments = allotments.Count(a =>
        !string.IsNullOrEmpty(a.AllotmentStatus) &&
        a.AllotmentStatus.Equals(
            "Completed",
            StringComparison.OrdinalIgnoreCase));

    var totalBookingAmount =
        allotments.Sum(a => a.BookingAmount);

}

<!-- ========================================================= -->
<!-- PAGE HEADER -->
<!-- ========================================================= -->

<div class="d-flex justify-content-between align-items-center mb-4">

  
    <div>

        <h2 class="fw-bold mb-1">

            <i class="bi bi-house-check text-primary me-2"></i>

            Allotments

        </h2>

        <p class="text-muted mb-0">

            Manage property allotments with client and
            property information.

        </p>

    </div>


    <a asp-action="Create"
       class="btn btn-primary px-4">

        <i class="bi bi-plus-circle me-1"></i>

        Create Allotment

    </a>
   

</div>

<!-- ========================================================= -->
<!-- ALERTS -->
<!-- ========================================================= -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm"
         role="alert">

        ```
        <i class="bi bi-check-circle-fill me-2"></i>

        <strong>
            @TempData["SuccessMessage"]
        </strong>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>


}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm"
         role="alert">

        
        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        <strong>
            @TempData["ErrorMessage"]
        </strong>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>


}

<!-- ========================================================= -->
<!-- SUMMARY CARDS -->
<!-- ========================================================= -->

<div class="row g-4 mb-4">

   
    <!-- TOTAL -->

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="text-muted small">
                            Total Allotments
                        </span>

                        <h3 class="fw-bold mb-0 mt-1">
                            @totalAllotments
                        </h3>

                    </div>

                    <div class="bg-primary-subtle text-primary rounded-circle p-3">

                        <i class="bi bi-house-check fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ACTIVE -->

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="text-muted small">
                            Active Allotments
                        </span>

                        <h3 class="fw-bold mb-0 mt-1">
                            @activeAllotments
                        </h3>

                    </div>

                    <div class="bg-success-subtle text-success rounded-circle p-3">

                        <i class="bi bi-check-circle fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PENDING -->

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="text-muted small">
                            Pending
                        </span>

                        <h3 class="fw-bold mb-0 mt-1">
                            @pendingAllotments
                        </h3>

                    </div>

                    <div class="bg-warning-subtle text-warning rounded-circle p-3">

                        <i class="bi bi-hourglass-split fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- BOOKING AMOUNT -->

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="text-muted small">
                            Total Booking Amount
                        </span>

                        <h4 class="fw-bold mb-0 mt-1">

                            ₹@totalBookingAmount.ToString("N2")

                        </h4>

                    </div>

                    <div class="bg-info-subtle text-info rounded-circle p-3">

                        <i class="bi bi-currency-rupee fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>
    ```

</div>

<!-- ========================================================= -->
<!-- ALLOTMENT TABLE -->
<!-- ========================================================= -->

<div class="card border-0 shadow-sm">

   
    <!-- HEADER -->

    <div class="card-header bg-white border-0 py-3">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h5 class="fw-bold mb-1">

                    Allotment Records

                </h5>

                <small class="text-muted">

                    Client, property and allotment information

                </small>

            </div>


            <span class="badge bg-primary-subtle text-primary px-3 py-2">

                @totalAllotments Records

            </span>

        </div>

    </div>


    <!-- BODY -->

    <div class="card-body p-0">

        @if (allotments.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <!-- ALLOTMENT ID -->

                            <th class="ps-4">
                                Allotment ID
                            </th>


                            <!-- CLIENT ID -->

                            <th>
                                Client ID
                            </th>


                            <!-- CLIENT NAME -->

                            <th>
                                Client Name
                            </th>


                            <!-- PROPERTY -->

                            <th>
                                Property
                            </th>


                            <!-- APPLICATION -->

                            <th>
                                Application
                            </th>


                            <!-- ALLOTMENT NUMBER -->

                            <th>
                                Allotment Number
                            </th>


                            <!-- DATE -->

                            <th>
                                Allotment Date
                            </th>


                            <!-- BOOKING AMOUNT -->

                            <th>
                                Booking Amount
                            </th>


                            <!-- STATUS -->

                            <th>
                                Status
                            </th>


                            <!-- ACTIONS -->

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in allotments)
                        {
                            var client =
                                item.Application?.User;

                            var property =
                                item.Property;


                            <tr>

                                <!-- ================================================= -->
                                <!-- ALLOTMENT ID -->
                                <!-- ================================================= -->

                                <td class="ps-4">

                                    <span class="fw-semibold">

                                        #@item.AllotmentId

                                    </span>

                                </td>


                                <!-- ================================================= -->
                                <!-- CLIENT ID -->
                                <!-- ================================================= -->

                                <td>

                                    @if (client != null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary">

                                            #@client.UserId

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            #@item.Application?.UserId

                                        </span>
                                    }

                                </td>


                                <!-- ================================================= -->
                                <!-- CLIENT NAME -->
                                <!-- ================================================= -->

                                <td>

                                    @if (client != null)
                                    {
                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary-subtle text-primary rounded-circle p-2 me-2">

                                                <i class="bi bi-person-fill"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">

                                                    @client.FullName

                                                </div>

                                            </div>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold">

                                            Client not found

                                        </span>
                                    }

                                </td>


                                <!-- ================================================= -->
                                <!-- PROPERTY -->
                                <!-- ================================================= -->
                                <!-- ================================================= -->
                                <!-- PROPERTY -->
                                <!-- ================================================= -->

                                <td>

                                    @if (item.Property != null)
                                    {
                                        <div>

                                            <!-- SCHEME / PROPERTY NAME -->

                                            <div class="fw-semibold text-primary">

                                                <i class="bi bi-house-fill me-1"></i>

                                                @(item.Property.Scheme?.SchemeName ?? "Property")

                                            </div>


                                            <!-- UNIT NUMBER -->
                                            @if (!string.IsNullOrWhiteSpace(item.Property.UnitNumber))
                                            {
                                                <div class="small text-muted">

                                                    Unit:
                                                    @item.Property.UnitNumber

                                                </div>
                                            }


                                            <!-- PLOT NUMBER -->
                                            @if (!string.IsNullOrWhiteSpace(item.Property.PlotNumber))
                                            {
                                                <div class="small text-muted">

                                                    Plot:
                                                    @item.Property.PlotNumber

                                                </div>
                                            }


                                            <!-- PROPERTY TYPE -->
                                            @if (!string.IsNullOrWhiteSpace(item.Property.PropertyType))
                                            {
                                                <div class="small text-muted">

                                                    Type:
                                                    @item.Property.PropertyType

                                                </div>
                                            }


                                            <!-- PROPERTY ID -->

                                            <div class="small text-muted">

                                                Property ID:
                                                @item.PropertyId

                                            </div>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold">
                                            Property not found
                                        </span>

                                        <div class="small text-muted">
                                            Property ID: @item.PropertyId
                                        </div>
                                    }

                                </td>


                                <!-- ================================================= -->
                                <!-- APPLICATION -->
                                <!-- ================================================= -->

                                <td>

                                    <span class="badge bg-light text-dark border">

                                        <i class="bi bi-file-earmark-text me-1"></i>

                                        #@item.ApplicationId

                                    </span>

                                </td>


                                <!-- ================================================= -->
                                <!-- ALLOTMENT NUMBER -->
                                <!-- ================================================= -->

                                <td>

                                    <span class="fw-bold">

                                        @item.AllotmentNumber

                                    </span>

                                </td>


                                <!-- ================================================= -->
                                <!-- DATE -->
                                <!-- ================================================= -->

                                <td>

                                    @item.AllotmentDate.ToString(
                                        "dd MMM yyyy")

                                </td>


                                <!-- ================================================= -->
                                <!-- BOOKING AMOUNT -->
                                <!-- ================================================= -->

                                <td>

                                    <span class="fw-semibold text-success">

                                        ₹@item.BookingAmount.ToString("N2")

                                    </span>

                                </td>


                                <!-- ================================================= -->
                                <!-- STATUS -->
                                <!-- ================================================= -->

                                <td>

                                    @if (string.Equals(
                                        item.AllotmentStatus,
                                        "Active",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle-fill me-1"></i>

                                            Active

                                        </span>
                                    }
                                    else if (string.Equals(
                                        item.AllotmentStatus,
                                        "Pending",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="bi bi-hourglass-split me-1"></i>

                                            Pending

                                        </span>
                                    }
                                    else if (string.Equals(
                                        item.AllotmentStatus,
                                        "Completed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-primary">

                                            <i class="bi bi-check2-all me-1"></i>

                                            Completed

                                        </span>
                                    }
                                    else if (string.Equals(
                                        item.AllotmentStatus,
                                        "Cancelled",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-x-circle-fill me-1"></i>

                                            Cancelled

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            @item.AllotmentStatus

                                        </span>
                                    }

                                </td>


                                <!-- ================================================= -->
                                <!-- ACTIONS -->
                                <!-- ================================================= -->

                                <td class="text-center">

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.AllotmentId"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <a asp-action="Edit"
                                           asp-route-id="@item.AllotmentId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@item.AllotmentId"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- ================================================= -->
            <!-- EMPTY STATE -->
            <!-- ================================================= -->

            <div class="text-center py-5">

                <i class="bi bi-house-x display-4 text-muted"></i>

                <h5 class="fw-bold mt-3">

                    No Allotments Found

                </h5>

                <p class="text-muted mb-4">

                    There are currently no property allotment
                    records.

                </p>


                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle me-1"></i>

                    Create First Allotment

                </a>

            </div>
        }

    </div>
    

</div>
