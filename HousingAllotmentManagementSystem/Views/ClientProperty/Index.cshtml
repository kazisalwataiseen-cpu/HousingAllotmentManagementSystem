@model IEnumerable<HousingAllotmentManagementSystem.Models.Allotment>

@{
    ViewData["Title"] = "My Properties";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-houses me-2 text-primary"></i>
                My Properties
            </h2>
            <p class="text-muted mb-0">
                View properties allotted to your account and their allotment details.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="ClientProperty"
               asp-action="Schemes"
               class="btn btn-outline-primary">
                <i class="bi bi-buildings me-1"></i>
                My Schemes
            </a>
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Home
            </a>
        </div>
    </div>

    <!-- ALERT MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var allotment in Model)
            {
                var property = allotment.Property;
                var scheme = property?.Scheme;

                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">

                        <!-- CARD HEADER -->
                        <div class="card-header bg-primary text-white p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="opacity-75">Housing Scheme</small>
                                    <h5 class="mb-0 fw-bold">
                                        @(scheme?.SchemeName ?? "Housing Scheme")
                                    </h5>
                                </div>
                                <span class="badge bg-light text-primary">
                                    Allotment #@allotment.AllotmentNumber
                                </span>
                            </div>
                        </div>

                        <!-- CARD BODY -->
                        <div class="card-body p-4">

                            <!-- UNIT & LOCATION INFO -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Unit / Plot Number</small>
                                    <h5 class="fw-bold mt-1 text-primary">
                                        @if (!string.IsNullOrEmpty(property?.UnitNumber))
                                        {
                                            <span>Unit @property.UnitNumber</span>
                                        }
                                        @if (!string.IsNullOrEmpty(property?.PlotNumber))
                                        {
                                            <span class="ms-1 text-muted fs-6">(Plot: @property.PlotNumber)</span>
                                        }
                                        @if (string.IsNullOrEmpty(property?.UnitNumber) && string.IsNullOrEmpty(property?.PlotNumber))
                                        {
                                            <span>Property #@property?.PropertyId</span>
                                        }
                                    </h5>
                                </div>

                                <div class="col-md-6">
                                    <small class="text-muted d-block">Property Type</small>
                                    <h6 class="fw-semibold mt-1">
                                        @(property?.PropertyType ?? "Residential")
                                        @if (property?.Bedrooms.HasValue == true)
                                        {
                                            <span class="text-muted">(@property.Bedrooms BHK)</span>
                                        }
                                    </h6>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Location</small>
                                    <span class="fw-semibold">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                        @(scheme?.Location ?? $"{scheme?.City}, {scheme?.State}" ?? "N/A")
                                    </span>
                                </div>

                                <div class="col-md-6">
                                    <small class="text-muted d-block">Allotment Date</small>
                                    <span class="fw-semibold">
                                        <i class="bi bi-calendar-check text-success me-1"></i>
                                        @allotment.AllotmentDate.ToString("dd MMM yyyy")
                                    </span>
                                </div>
                            </div>

                            <hr class="my-3" />

                            <!-- FINANCIALS & AREAS -->
                            <div class="row g-3 text-center mb-3">
                                <div class="col-4 border-end">
                                    <small class="text-muted d-block">Carpet Area</small>
                                    <strong>@(property?.CarpetArea.HasValue == true ? $"{property.CarpetArea:N0} sq.ft" : "N/A")</strong>
                                </div>

                                <div class="col-4 border-end">
                                    <small class="text-muted d-block">Property Price</small>
                                    <strong class="text-success">@(property?.Price.HasValue == true ? $"₹{property.Price.Value:N2}" : "N/A")</strong>
                                </div>

                                <div class="col-4">
                                    <small class="text-muted d-block">Booking Paid</small>
                                    <strong class="text-primary">₹@allotment.BookingAmount.ToString("N2")</strong>
                                </div>
                            </div>

                            <!-- ALLOTMENT STATUS -->
                            <div class="d-flex justify-content-between align-items-center pt-2">
                                <div>
                                    <small class="text-muted me-2">Status:</small>
                                    @if (allotment.AllotmentStatus == "Booked" || allotment.AllotmentStatus == "Active")
                                    {
                                        <span class="badge bg-success">@allotment.AllotmentStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@allotment.AllotmentStatus</span>
                                    }
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-controller="ClientProperty"
                                       asp-action="Details"
                                       asp-route-id="@allotment.PropertyId"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye me-1"></i>
                                        View Details
                                    </a>

                                    <a asp-controller="ClientAllotment"
                                       asp-action="Details"
                                       asp-route-id="@allotment.AllotmentId"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-file-earmark-check me-1"></i>
                                        Allotment
                                    </a>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-houses display-1 text-muted"></i>
                <h4 class="fw-bold mt-3">No Properties Found</h4>
                <p class="text-muted mb-4">
                    You currently do not have any allotted properties. Properties will appear here once an application submitted by you is approved and allotted.
                </p>
                <a asp-controller="Applications"
                   asp-action="MyApplications"
                   class="btn btn-primary">
                    <i class="bi bi-file-earmark-text me-1"></i>
                    Check My Applications
                </a>
            </div>
        </div>
    }

</div>
