@model HousingAllotmentManagementSystem.Models.Allotment

@{
    ViewData["Title"] = "Property Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var property = Model.Property;
    var scheme = property?.Scheme;
    var loans = Model.Loans?.ToList() ?? new List<HousingAllotmentManagementSystem.Models.Loan>();
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-house-door me-2 text-primary"></i>
                Property Details
            </h2>
            <p class="text-muted mb-0">
                Detailed information about your allotted property.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="ClientProperty"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to My Properties
            </a>
        </div>
    </div>

    <!-- MAIN PROPERTY SUMMARY -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-buildings me-2"></i>
                    @(scheme?.SchemeName ?? "Housing Scheme") - @(property?.PropertyType ?? "Residential")
                </h5>
                <span class="badge bg-light text-primary fs-6">
                    Allotment #@Model.AllotmentNumber
                </span>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-md-3">
                    <small class="text-muted d-block">Unit Number</small>
                    <h5 class="fw-bold text-primary mt-1">
                        @(string.IsNullOrEmpty(property?.UnitNumber) ? "N/A" : property.UnitNumber)
                    </h5>
                </div>

                <div class="col-md-3">
                    <small class="text-muted d-block">Plot Number</small>
                    <h5 class="fw-bold mt-1">
                        @(string.IsNullOrEmpty(property?.PlotNumber) ? "N/A" : property.PlotNumber)
                    </h5>
                </div>

                <div class="col-md-3">
                    <small class="text-muted d-block">Property Price</small>
                    <h5 class="fw-bold text-success mt-1">
                        @(property?.Price.HasValue == true ? $"₹{property.Price.Value:N2}" : "N/A")
                    </h5>
                </div>

                <div class="col-md-3">
                    <small class="text-muted d-block">Booking Amount</small>
                    <h5 class="fw-bold text-dark mt-1">
                        ₹@Model.BookingAmount.ToString("N2")
                    </h5>
                </div>

            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- PROPERTY SPECIFICATIONS -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-sliders me-2"></i>
                        Property Specifications
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6 text-muted">Property ID</div>
                        <div class="col-6 fw-bold">#@(property?.PropertyId)</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Property Type</div>
                        <div class="col-6 fw-bold">@(property?.PropertyType ?? "N/A")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Bedrooms</div>
                        <div class="col-6 fw-bold">@(property?.Bedrooms.HasValue == true ? $"{property.Bedrooms} BHK" : "N/A")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Bathrooms</div>
                        <div class="col-6 fw-bold">@(property?.Bathrooms.HasValue == true ? $"{property.Bathrooms}" : "N/A")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Carpet Area</div>
                        <div class="col-6 fw-bold">@(property?.CarpetArea.HasValue == true ? $"{property.CarpetArea:N2} sq.ft" : "N/A")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Built-up Area</div>
                        <div class="col-6 fw-bold">@(property?.BuiltupArea.HasValue == true ? $"{property.BuiltupArea:N2} sq.ft" : "N/A")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Facing</div>
                        <div class="col-6 fw-bold">@(property?.Facing ?? "N/A")</div>
                    </div>

                    <div class="row">
                        <div class="col-6 text-muted">Description</div>
                        <div class="col-6">@(property?.Description ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SCHEME & ALLOTMENT DETAILS -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-check me-2"></i>
                        Scheme & Allotment Information
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6 text-muted">Housing Scheme</div>
                        <div class="col-6 fw-bold text-primary">@(scheme?.SchemeName ?? "N/A")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Scheme Location</div>
                        <div class="col-6 fw-bold">@(scheme?.Location ?? "N/A")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">City / State</div>
                        <div class="col-6 fw-bold">@(scheme?.City), @(scheme?.State)</div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Allotment Number</div>
                        <div class="col-6 fw-bold text-success">@Model.AllotmentNumber</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Allotment Date</div>
                        <div class="col-6 fw-bold">@Model.AllotmentDate.ToString("dd MMMM yyyy")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Allotment Status</div>
                        <div class="col-6">
                            <span class="badge bg-success">@Model.AllotmentStatus</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Remarks))
                    {
                        <div class="mt-3">
                            <small class="text-muted d-block mb-1">Remarks</small>
                            <div class="alert alert-light border mb-0">@Model.Remarks</div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- RELATED LOAN -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-secondary text-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-bank me-2"></i>
                Housing Loan & EMI
            </h5>
        </div>

        <div class="card-body p-4">
            @if (loans.Any())
            {
                var loan = loans.First();

                <div class="row g-4 align-items-center">
                    <div class="col-md-3">
                        <small class="text-muted d-block">Loan Number</small>
                        <h6 class="fw-bold mb-0">@loan.LoanNumber</h6>
                    </div>

                    <div class="col-md-3">
                        <small class="text-muted d-block">Loan Amount</small>
                        <h6 class="fw-bold text-primary mb-0">₹@loan.LoanAmount.ToString("N2")</h6>
                    </div>

                    <div class="col-md-3">
                        <small class="text-muted d-block">Monthly EMI</small>
                        <h6 class="fw-bold text-success mb-0">₹@loan.Emiamount.ToString("N2")</h6>
                    </div>

                    <div class="col-md-3 text-md-end">
                        <a asp-controller="ClientLoan"
                           asp-action="Details"
                           asp-route-id="@loan.LoanId"
                           class="btn btn-primary btn-sm me-2">
                            <i class="bi bi-eye me-1"></i>
                            Loan Details
                        </a>

                        @if (loan.Emiplans != null && loan.Emiplans.Any())
                        {
                            <a asp-controller="ClientEmi"
                               asp-action="Details"
                               asp-route-id="@loan.Emiplans.First().EmiplanId"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-calculator me-1"></i>
                                View EMI
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-0">
                            No housing loan is currently active for this allotted property.
                        </p>
                    </div>

                    <a asp-controller="ClientLoan"
                       asp-action="Apply"
                       class="btn btn-success btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>
                        Apply for Housing Loan
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- BOTTOM ACTION BUTTONS -->
    <div class="d-flex justify-content-between mt-4">
        <a asp-controller="ClientProperty"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Properties
        </a>

        <a asp-controller="ClientAllotment"
           asp-action="Details"
           asp-route-id="@Model.AllotmentId"
           class="btn btn-outline-primary">
            <i class="bi bi-file-earmark-check me-1"></i>
            View Allotment Letter
        </a>
    </div>

</div>
