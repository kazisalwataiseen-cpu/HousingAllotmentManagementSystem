@model HousingAllotmentManagementSystem.Models.User

@{
    ViewData["Title"] = "Edit User";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-warning text-dark py-3">

            <h3 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                Edit User
            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="CreatedDate" />

                <div class="row">

                    <!-- Role -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="RoleId" class="form-label fw-bold"></label>

                        <select asp-for="RoleId"
                                asp-items="ViewBag.RoleId"
                                class="form-select">

                            <option value="">-- Select Role --</option>

                        </select>

                        <span asp-validation-for="RoleId" class="text-danger"></span>

                    </div>

                    <!-- Full Name -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="FullName" class="form-label fw-bold"></label>

                        <input asp-for="FullName"
                               class="form-control" />

                        <span asp-validation-for="FullName" class="text-danger"></span>

                    </div>

                    <!-- Email -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email" class="form-label fw-bold"></label>

                        <input asp-for="Email"
                               class="form-control" />

                        <span asp-validation-for="Email" class="text-danger"></span>

                    </div>

                    <!-- Mobile -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Mobile" class="form-label fw-bold"></label>

                        <input asp-for="Mobile"
                               class="form-control" />

                        <span asp-validation-for="Mobile" class="text-danger"></span>

                    </div>

                    <!-- Password -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="PasswordHash" class="form-label fw-bold">
                            Password
                        </label>

                        <input asp-for="PasswordHash"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="PasswordHash" class="text-danger"></span>

                    </div>

                    <!-- Gender -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Gender" class="form-label fw-bold"></label>

                        <select asp-for="Gender" class="form-select">

                            <option value="">Select Gender</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>

                        </select>

                    </div>

                    <!-- Date of Birth -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Dob" class="form-label fw-bold"></label>

                        <input asp-for="Dob"
                               type="date"
                               class="form-control" />

                    </div>

                    <!-- Occupation -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Occupation" class="form-label fw-bold"></label>

                        <input asp-for="Occupation"
                               class="form-control" />

                    </div>

                    <!-- Annual Income -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="AnnualIncome" class="form-label fw-bold"></label>

                        <input asp-for="AnnualIncome"
                               class="form-control" />

                    </div>

                    <!-- Aadhaar -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="AadhaarNumber" class="form-label fw-bold"></label>

                        <input asp-for="AadhaarNumber"
                               class="form-control" />

                    </div>

                    <!-- PAN -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Pannumber" class="form-label fw-bold"></label>

                        <input asp-for="Pannumber"
                               class="form-control" />

                    </div>

                    <!-- City -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="City" class="form-label fw-bold"></label>

                        <input asp-for="City"
                               class="form-control" />

                    </div>

                    <!-- State -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="State" class="form-label fw-bold"></label>

                        <input asp-for="State"
                               class="form-control" />

                    </div>

                    <!-- Pincode -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="Pincode" class="form-label fw-bold"></label>

                        <input asp-for="Pincode"
                               class="form-control" />

                    </div>

                    <!-- Address -->

                    <div class="col-md-12 mb-3">

                        <label asp-for="Address" class="form-label fw-bold"></label>

                        <textarea asp-for="Address"
                                  rows="3"
                                  class="form-control"></textarea>

                    </div>

                    <!-- Profile Image -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="ProfileImage" class="form-label fw-bold"></label>

                        <input asp-for="ProfileImage"
                               class="form-control" />

                    </div>

                    <!-- Verified -->

                    <div class="col-md-3 mb-3">

                        <label asp-for="IsVerified" class="form-label fw-bold"></label>

                        <select asp-for="IsVerified" class="form-select">

                            <option value="true">Yes</option>
                            <option value="false">No</option>

                        </select>

                    </div>

                    <!-- Status -->

                    <div class="col-md-3 mb-3">

                        <label asp-for="Status" class="form-label fw-bold"></label>

                        <select asp-for="Status" class="form-select">

                            <option value="true">Active</option>
                            <option value="false">Inactive</option>

                        </select>

                    </div>

                </div>

                <hr />

                <div class="text-end">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left-circle"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="bi bi-save-fill"></i>
                        Update User

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}