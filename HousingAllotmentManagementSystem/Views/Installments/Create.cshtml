@model HousingAllotmentManagementSystem.Models.Installment

@{
    ViewData["Title"] = "Create Installment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-calendar-plus me-2"></i>
                Create Installment
            </h2>

            <p class="text-muted mb-0">
                Add a new EMI installment
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Installments
        </a>

    </div>


    <!-- Main Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0">
                <i class="bi bi-calendar-check me-2"></i>
                Installment Information
            </h5>

        </div>


        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <!-- Validation -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <div class="row g-4">

                    <!-- EMI PLAN -->
                    <div class="col-md-6">

                        <label asp-for="EmiplanId"
                               class="form-label fw-semibold">
                            EMI Plan
                        </label>

                        <select asp-for="EmiplanId"
                                asp-items="ViewBag.EmiplanId"
                                class="form-select">

                            <option value="">
                                -- Select EMI Plan --
                            </option>

                        </select>

                        <span asp-validation-for="EmiplanId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- INSTALLMENT NUMBER -->
                    <div class="col-md-6">

                        <label asp-for="InstallmentNumber"
                               class="form-label fw-semibold">
                            Installment Number
                        </label>

                        <input asp-for="InstallmentNumber"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Enter installment number" />

                        <span asp-validation-for="InstallmentNumber"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- DUE DATE -->
                    <div class="col-md-6">

                        <label asp-for="DueDate"
                               class="form-label fw-semibold">
                            Due Date
                        </label>

                        <input asp-for="DueDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DueDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- INSTALLMENT AMOUNT -->
                    <div class="col-md-6">

                        <label asp-for="InstallmentAmount"
                               class="form-label fw-semibold">
                            Installment Amount
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input asp-for="InstallmentAmount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="0.00" />

                        </div>

                        <span asp-validation-for="InstallmentAmount"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PRINCIPAL AMOUNT -->
                    <div class="col-md-6">

                        <label asp-for="PrincipalAmount"
                               class="form-label fw-semibold">
                            Principal Amount
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input asp-for="PrincipalAmount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="0.00" />

                        </div>

                        <span asp-validation-for="PrincipalAmount"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- INTEREST AMOUNT -->
                    <div class="col-md-6">

                        <label asp-for="InterestAmount"
                               class="form-label fw-semibold">
                            Interest Amount
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input asp-for="InterestAmount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="0.00" />

                        </div>

                        <span asp-validation-for="InterestAmount"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- LATE FEE -->
                    <div class="col-md-6">

                        <label asp-for="LateFee"
                               class="form-label fw-semibold">
                            Late Fee
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input asp-for="LateFee"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   value="0"
                                   class="form-control"
                                   placeholder="0.00" />

                        </div>

                        <span asp-validation-for="LateFee"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PAID AMOUNT -->
                    <div class="col-md-6">

                        <label asp-for="PaidAmount"
                               class="form-label fw-semibold">
                            Paid Amount
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input asp-for="PaidAmount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   value="0"
                                   class="form-control"
                                   placeholder="0.00" />

                        </div>

                        <span asp-validation-for="PaidAmount"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PAYMENT DATE -->
                    <div class="col-md-6">

                        <label asp-for="PaymentDate"
                               class="form-label fw-semibold">
                            Payment Date
                        </label>

                        <input asp-for="PaymentDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="PaymentDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PAYMENT METHOD -->
                    <div class="col-md-6">

                        <label asp-for="PaymentMethod"
                               class="form-label fw-semibold">
                            Payment Method
                        </label>

                        <select asp-for="PaymentMethod"
                                class="form-select">

                            <option value="">
                                -- Select Payment Method --
                            </option>

                            <option value="Cash">
                                Cash
                            </option>

                            <option value="UPI">
                                UPI
                            </option>

                            <option value="Net Banking">
                                Net Banking
                            </option>

                            <option value="Credit Card">
                                Credit Card
                            </option>

                            <option value="Debit Card">
                                Debit Card
                            </option>

                            <option value="Cheque">
                                Cheque
                            </option>

                        </select>

                        <span asp-validation-for="PaymentMethod"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- TRANSACTION REFERENCE -->
                    <div class="col-md-6">

                        <label asp-for="TransactionReference"
                               class="form-label fw-semibold">
                            Transaction Reference
                        </label>

                        <input asp-for="TransactionReference"
                               class="form-control"
                               maxlength="100"
                               placeholder="Enter transaction reference" />

                        <span asp-validation-for="TransactionReference"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PAYMENT STATUS -->
                    <div class="col-md-6">

                        <label asp-for="PaymentStatus"
                               class="form-label fw-semibold">
                            Payment Status
                        </label>

                        <select asp-for="PaymentStatus"
                                class="form-select">

                            <option value="">
                                -- Select Payment Status --
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Paid">
                                Paid
                            </option>

                            <option value="Partial">
                                Partial
                            </option>

                            <option value="Overdue">
                                Overdue
                            </option>

                        </select>

                        <span asp-validation-for="PaymentStatus"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- REMARKS -->
                    <div class="col-12">

                        <label asp-for="Remarks"
                               class="form-label fw-semibold">
                            Remarks
                        </label>

                        <textarea asp-for="Remarks"
                                  rows="4"
                                  maxlength="500"
                                  class="form-control"
                                  placeholder="Enter remarks if required"></textarea>

                        <span asp-validation-for="Remarks"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- BUTTONS -->
                <div class="border-top mt-4 pt-4">

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary px-4">

                            <i class="bi bi-x-circle me-1"></i>
                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-primary px-4">

                            <i class="bi bi-check-circle me-1"></i>
                            Save Installment

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}