@model HousingAllotmentManagementSystem.Models.Installment

@{
    ViewData["Title"] = "Delete Installment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-danger mb-1">
                <i class="bi bi-trash3 me-2"></i>
                Delete Installment
            </h2>

            <p class="text-muted mb-0">
                Review the installment information before deleting it.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Installments

        </a>

    </div>


    <!-- Warning -->
    <div class="alert alert-danger d-flex align-items-center shadow-sm border-0"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

        <div>
            <strong>Are you sure you want to delete this installment?</strong>
            <div class="small mt-1">
                This action cannot be undone.
            </div>
        </div>

    </div>


    <!-- Installment Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-danger text-white py-3">

            <h5 class="mb-0">
                <i class="bi bi-calendar-x me-2"></i>
                Installment Information
            </h5>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">

                <!-- Installment ID -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Installment ID
                    </div>

                    <div class="fw-bold fs-5">
                        #@Model.InstallmentId
                    </div>

                </div>


                <!-- EMI Plan -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        EMI Plan ID
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.EmiplanId
                    </div>

                </div>


                <!-- Installment Number -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Installment Number
                    </div>

                    <div class="fw-bold fs-5">
                        EMI #@Model.InstallmentNumber
                    </div>

                </div>


                <!-- Due Date -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Due Date
                    </div>

                    <div class="fw-semibold">
                        @Model.DueDate.ToString("dd MMM yyyy")
                    </div>

                </div>


                <!-- Installment Amount -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Installment Amount
                    </div>

                    <div class="fw-bold fs-5 text-primary">
                        ₹ @Model.InstallmentAmount.ToString("N2")
                    </div>

                </div>


                <!-- Paid Amount -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Paid Amount
                    </div>

                    <div class="fw-bold fs-5 text-success">
                        ₹ @Model.PaidAmount.ToString("N2")
                    </div>

                </div>


                <!-- Principal -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Principal Amount
                    </div>

                    <div class="fw-semibold">
                        ₹ @Model.PrincipalAmount.ToString("N2")
                    </div>

                </div>


                <!-- Interest -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Interest Amount
                    </div>

                    <div class="fw-semibold">
                        ₹ @Model.InterestAmount.ToString("N2")
                    </div>

                </div>


                <!-- Late Fee -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Late Fee
                    </div>

                    <div class="fw-semibold text-danger">
                        ₹ @Model.LateFee.ToString("N2")
                    </div>

                </div>


                <!-- Payment Method -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Payment Method
                    </div>

                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.PaymentMethod)
                            ? "Not Available"
                            : Model.PaymentMethod)
                    </div>

                </div>


                <!-- Payment Date -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Payment Date
                    </div>

                    <div class="fw-semibold">

                        @if (Model.PaymentDate.HasValue)
                        {
                            @Model.PaymentDate.Value.ToString("dd MMM yyyy")
                        }
                        else
                        {
                            <span class="text-muted">
                                Not Paid
                            </span>
                        }

                    </div>

                </div>


                <!-- Payment Status -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Payment Status
                    </div>

                    <div>

                        @if (Model.PaymentStatus == "Paid")
                        {
                            <span class="badge bg-success px-3 py-2">
                                <i class="bi bi-check-circle me-1"></i>
                                Paid
                            </span>
                        }
                        else if (Model.PaymentStatus == "Pending")
                        {
                            <span class="badge bg-warning text-dark px-3 py-2">
                                <i class="bi bi-clock me-1"></i>
                                Pending
                            </span>
                        }
                        else if (Model.PaymentStatus == "Overdue")
                        {
                            <span class="badge bg-danger px-3 py-2">
                                <i class="bi bi-exclamation-circle me-1"></i>
                                Overdue
                            </span>
                        }
                        else if (Model.PaymentStatus == "Partial")
                        {
                            <span class="badge bg-info text-dark px-3 py-2">
                                <i class="bi bi-hourglass-split me-1"></i>
                                Partial
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2">
                                @Model.PaymentStatus
                            </span>
                        }

                    </div>

                </div>


                <!-- Transaction Reference -->
                <div class="col-md-6">

                    <div class="text-muted small mb-1">
                        Transaction Reference
                    </div>

                    <div class="fw-semibold">

                        @if (!string.IsNullOrWhiteSpace(Model.TransactionReference))
                        {
                            @Model.TransactionReference
                        }
                        else
                        {
                            <span class="text-muted">
                                Not Available
                            </span>
                        }

                    </div>

                </div>


                <!-- Created Date -->
                <div class="col-md-6">

                    <div class="text-muted small mb-1">
                        Created Date
                    </div>

                    <div class="fw-semibold">
                        @Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Remarks -->
    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-light py-3">

                <h5 class="mb-0 text-primary">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Remarks
                </h5>

            </div>

            <div class="card-body">

                <p class="mb-0">
                    @Model.Remarks
                </p>

            </div>

        </div>
    }


    <!-- Delete Form -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="InstallmentId" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4"
                            onclick="return confirm('Are you sure you want to permanently delete this installment?');">

                        <i class="bi bi-trash3 me-1"></i>
                        Delete Installment

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>