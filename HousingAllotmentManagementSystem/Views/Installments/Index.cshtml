@model IEnumerable<HousingAllotmentManagementSystem.Models.Installment>

@{
    ViewData["Title"] = "Installments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0">
                <i class="bi bi-calendar-check me-2"></i>Installments
            </h2>
            <small class="text-muted">
                Manage EMI Installments
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Installment
        </a>
    </div>

    <div class="card shadow border-0">

        <div class="card-header bg-white">

            <div class="row align-items-center">

                <div class="col-md-6">
                    <h5 class="mb-0 fw-bold">
                        Installment List
                    </h5>
                </div>

                <div class="col-md-6 text-end">

                    <input type="text"
                           class="form-control w-50 d-inline"
                           placeholder="Search..."
                           id="searchInput">

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle" id="installmentTable">

                    <thead class="table-primary">

                        <tr>

                            <th>#</th>

                            <th>Loan ID</th>

                            <th>Installment</th>

                            <th>Due Date</th>

                            <th>Amount</th>

                            <th>Paid</th>

                            <th>Status</th>

                            <th width="170">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int count = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@count</td>

                                <td>
                                    @item.Emiplan.LoanId
                                </td>

                                <td>
                                    EMI @item.InstallmentNumber
                                </td>

                                <td>
                                    @item.DueDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    ₹ @item.InstallmentAmount.ToString("N2")
                                </td>

                                <td>
                                    ₹ @item.PaidAmount.ToString("N2")
                                </td>

                                <td>

                                    @if (item.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success">
                                            Paid
                                        </span>
                                    }
                                    else if (item.PaymentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (item.PaymentStatus == "Overdue")
                                    {
                                        <span class="badge bg-danger">
                                            Overdue
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.PaymentStatus
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.InstallmentId"
                                       class="btn btn-sm btn-info text-white">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.InstallmentId"
                                       class="btn btn-sm btn-warning text-dark">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.InstallmentId"
                                       class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </td>

                            </tr>

                            count++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("searchInput").addEventListener("keyup", function() {

            var value = this.value.toLowerCase();

            document.querySelectorAll("#installmentTable tbody tr").forEach(function(row) {

                row.style.display = row.innerText.toLowerCase().includes(value)
                    ? ""
                    : "none";

            });

        });

    </script>

}