@model IEnumerable<HousingAllotmentManagementSystem.Models.Installment>

@{
    ViewData["Title"] = "Installments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-calendar-check text-primary me-2"></i>

                Installments

            </h2>

            <p class="text-muted mb-0">

                Manage EMI installments with client, property and loan details.

            </p>

        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="bi bi-table me-2"></i>

                    Installment Records

                </h5>

                <span class="badge bg-light text-primary">

                    @(Model?.Count() ?? 0) Installments

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>

                                <th class="ps-4">Installment ID</th>
                                <th>Client</th>
                                <th>Property</th>
                                <th>Loan Number</th>
                                <th>EMI Plan</th>
                                <th>Installment No.</th>
                                <th>Due Date</th>
                                <th>Amount</th>
                                <th>Principal</th>
                                <th>Interest</th>
                                <th>Paid</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                var loan =
                                    item.Emiplan?.Loan;

                                var allotment =
                                    loan?.Allotment;

                                var client =
                                    allotment?.Application?.User;

                                var property =
                                    allotment?.Property;


                                <tr>

                                    <!-- INSTALLMENT ID -->

                                    <td class="ps-4">

                                        <span class="fw-semibold">

                                            #@item.InstallmentId

                                        </span>

                                    </td>


                                    <!-- CLIENT -->

                                    <td>

                                        @if (client != null)
                                        {
                                            <div>

                                                <div class="fw-semibold">

                                                    <i class="bi bi-person-fill text-primary me-1"></i>

                                                    @client.FullName

                                                </div>

                                                <div class="small text-muted">

                                                    Client ID:
                                                    #@client.UserId

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-danger">

                                                Client not found

                                            </span>
                                        }

                                    </td>


                                    <!-- PROPERTY -->

                                    <td>

                                        @if (property != null)
                                        {
                                            <div>

                                                <div class="fw-semibold text-primary">

                                                    <i class="bi bi-house-fill me-1"></i>

                                                    @(property.Scheme?.SchemeName ?? "Property")

                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    property.UnitNumber))
                                                {
                                                    <div class="small text-muted">

                                                        Unit:
                                                        @property.UnitNumber

                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(
                                                    property.PlotNumber))
                                                {
                                                    <div class="small text-muted">

                                                        Plot:
                                                        @property.PlotNumber

                                                    </div>
                                                }

                                                <div class="small text-muted">

                                                    Property ID:
                                                    @property.PropertyId

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-danger">

                                                Property not found

                                            </span>
                                        }

                                    </td>


                                    <!-- LOAN -->

                                    <td>

                                        @if (loan != null)
                                        {
                                            <span class="fw-semibold">

                                                @loan.LoanNumber

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- EMI PLAN -->

                                    <td>

                                        @if (item.Emiplan != null)
                                        {
                                            <span class="badge bg-light text-dark border">

                                                EMI Plan #@item.Emiplan.EmiplanId

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- INSTALLMENT NUMBER -->

                                    <td>

                                        <span class="badge bg-primary-subtle text-primary">

                                            #@item.InstallmentNumber

                                        </span>

                                    </td>


                                    <!-- DUE DATE -->

                                    <td>

                                        @item.DueDate.ToString(
                                            "dd MMM yyyy")

                                    </td>


                                    <!-- AMOUNT -->

                                    <td>

                                        <span class="fw-bold text-primary">

                                            ₹@item.InstallmentAmount.ToString("N2")

                                        </span>

                                    </td>


                                    <!-- PRINCIPAL -->

                                    <td>

                                        ₹@item.PrincipalAmount.ToString("N2")

                                    </td>


                                    <!-- INTEREST -->

                                    <td>

                                        ₹@item.InterestAmount.ToString("N2")

                                    </td>


                                    <!-- PAID -->

                                    <td>

                                        ₹@item.PaidAmount.ToString("N2")

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (item.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">

                                                Paid

                                            </span>
                                        }
                                        else if (item.PaymentStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">

                                                Pending

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                @item.PaymentStatus

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.InstallmentId"
                                               class="btn btn-sm btn-outline-info">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <a asp-action="Edit"
                                               asp-route-id="@item.InstallmentId"
                                               class="btn btn-sm btn-outline-warning">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <a asp-action="Delete"
                                               asp-route-id="@item.InstallmentId"
                                               class="btn btn-sm btn-outline-danger">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-calendar-x display-4 text-muted"></i>

                    <h5 class="fw-bold mt-3">
                        No Installments Found
                    </h5>

                    <p class="text-muted">
                        There are currently no installment records.
                    </p>

                </div>
            }

        </div>

    </div>

</div>