@model HousingAllotmentManagementSystem.Models.Payment

@{
    ViewData["Title"] = "Create Payment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-credit-card-2-front-fill text-primary me-2"></i>
                Create Payment
            </h2>

            <p class="text-muted mb-0">
                Record a new payment transaction.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle me-1"></i>
            Back to List
        </a>

    </div>


    <!-- PAYMENT CARD -->
    <div class="row justify-content-center">

        <div class="col-xl-10 col-lg-11">

            <div class="card shadow-lg border-0">

                <!-- HEADER -->
                <div class="card-header bg-primary text-white py-3">

                    <h4 class="mb-0">
                        <i class="bi bi-credit-card-fill me-2"></i>
                        Payment Information
                    </h4>

                </div>


                <!-- BODY -->
                <div class="card-body p-4">

                    <form asp-controller="Payments"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- VALIDATION -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <!-- USER & INSTALLMENT -->
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-4">

                            <i class="bi bi-person-vcard me-2"></i>

                            Payment Reference

                        </h6>


                        <div class="row g-4">


                            <!-- USER -->
                            <div class="col-md-6">

                                <label asp-for="UserId"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-person me-1"></i>
                                    User

                                </label>


                                <select asp-for="UserId"
                                        class="form-select"
                                        asp-items="ViewBag.UserId">

                                    <option value="0">
                                        -- Select User --
                                    </option>

                                </select>


                                <span asp-validation-for="UserId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- INSTALLMENT -->
                            <div class="col-md-6">

                                <label asp-for="InstallmentId"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-calendar-check me-1"></i>
                                    Installment

                                </label>


                                <select asp-for="InstallmentId"
                                        class="form-select"
                                        asp-items="ViewBag.InstallmentId">

                                    <option value="">
                                        -- Select Installment --
                                    </option>

                                </select>


                                <span asp-validation-for="InstallmentId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- PAYMENT DETAILS -->
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-4 mt-5">

                            <i class="bi bi-cash-stack me-2"></i>

                            Payment Details

                        </h6>


                        <div class="row g-4">


                            <!-- PAYMENT TYPE -->
                            <div class="col-md-6">

                                <label asp-for="PaymentType"
                                       class="form-label fw-semibold">

                                    Payment Type

                                </label>


                                <select asp-for="PaymentType"
                                        class="form-select">

                                    <option value="">
                                        -- Select Payment Type --
                                    </option>

                                    <option value="Booking Amount">
                                        Booking Amount
                                    </option>

                                    <option value="Installment">
                                        Installment
                                    </option>

                                    <option value="Down Payment">
                                        Down Payment
                                    </option>

                                    <option value="Final Payment">
                                        Final Payment
                                    </option>

                                </select>


                                <span asp-validation-for="PaymentType"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- PAYMENT DATE -->
                            <div class="col-md-6">

                                <label asp-for="PaymentDate"
                                       class="form-label fw-semibold">

                                    Payment Date

                                </label>


                                <input asp-for="PaymentDate"
                                       type="date"
                                       class="form-control" />


                                <span asp-validation-for="PaymentDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- AMOUNT -->
                            <div class="col-md-6">

                                <label asp-for="Amount"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-currency-rupee me-1"></i>
                                    Amount

                                </label>


                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>


                                    <input asp-for="Amount"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="Enter payment amount" />

                                </div>


                                <span asp-validation-for="Amount"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- PAYMENT METHOD -->
                            <div class="col-md-6">

                                <label asp-for="PaymentMethod"
                                       class="form-label fw-semibold">

                                    Payment Method

                                </label>


                                <select asp-for="PaymentMethod"
                                        class="form-select">

                                    <option value="">
                                        -- Select Payment Method --
                                    </option>

                                    <option value="Cash">
                                        Cash
                                    </option>

                                    <option value="UPI">
                                        UPI
                                    </option>

                                    <option value="Net Banking">
                                        Net Banking
                                    </option>

                                    <option value="Credit Card">
                                        Credit Card
                                    </option>

                                    <option value="Debit Card">
                                        Debit Card
                                    </option>

                                    <option value="Cheque">
                                        Cheque
                                    </option>

                                </select>


                                <span asp-validation-for="PaymentMethod"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- TRANSACTION DETAILS -->
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-4 mt-5">

                            <i class="bi bi-receipt me-2"></i>

                            Transaction Information

                        </h6>


                        <div class="row g-4">


                            <!-- TRANSACTION ID -->
                            <div class="col-md-6">

                                <label asp-for="TransactionId"
                                       class="form-label fw-semibold">

                                    Transaction ID

                                </label>


                                <input asp-for="TransactionId"
                                       class="form-control"
                                       placeholder="Enter Transaction ID" />


                                <span asp-validation-for="TransactionId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- RECEIPT NUMBER -->
                            <div class="col-md-6">

                                <label asp-for="ReceiptNumber"
                                       class="form-label fw-semibold">

                                    Receipt Number

                                </label>


                                <input asp-for="ReceiptNumber"
                                       class="form-control"
                                       placeholder="Enter Receipt Number" />


                                <span asp-validation-for="ReceiptNumber"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- PAYMENT STATUS -->
                            <div class="col-md-6">

                                <label asp-for="PaymentStatus"
                                       class="form-label fw-semibold">

                                    Payment Status

                                </label>


                                <select asp-for="PaymentStatus"
                                        class="form-select">

                                    <option value="Paid">
                                        Paid
                                    </option>

                                    <option value="Pending">
                                        Pending
                                    </option>

                                    <option value="Failed">
                                        Failed
                                    </option>

                                </select>


                                <span asp-validation-for="PaymentStatus"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- REMARKS -->
                            <div class="col-md-12">

                                <label asp-for="Remarks"
                                       class="form-label fw-semibold">

                                    Remarks

                                </label>


                                <textarea asp-for="Remarks"
                                          rows="4"
                                          class="form-control"
                                          placeholder="Enter additional remarks..."></textarea>


                                <span asp-validation-for="Remarks"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- INFORMATION -->
                        <div class="alert alert-info mt-4">

                            <i class="bi bi-info-circle-fill me-2"></i>

                            Please verify the user, installment and payment
                            information before saving the transaction.

                        </div>


                        <!-- BUTTONS -->
                        <div class="border-top pt-4 mt-4">

                            <div class="d-flex justify-content-end gap-2">

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-x-circle me-1"></i>

                                    Cancel

                                </a>


                                <button type="reset"
                                        class="btn btn-outline-warning">

                                    <i class="bi bi-arrow-counterclockwise me-1"></i>

                                    Reset

                                </button>


                                <button type="submit"
                                        class="btn btn-primary">

                                    <i class="bi bi-save-fill me-1"></i>

                                    Save Payment

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}