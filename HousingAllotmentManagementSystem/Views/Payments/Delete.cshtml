@model HousingAllotmentManagementSystem.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-danger">
                <i class="bi bi-trash-fill"></i>
                Delete Payment
            </h2>

            <p class="text-muted mb-0">
                Confirm before permanently deleting this payment record.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i>
            Back to List
        </a>

    </div>

    <div class="card shadow-lg border-0">

        <div class="card-header bg-danger text-white">

            <h4 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Delete Confirmation
            </h4>

        </div>

        <div class="card-body">

            <div class="alert alert-danger">

                <h5 class="mb-2">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    Are you sure?
                </h5>

                This payment record will be permanently deleted.
                This action cannot be undone.

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        Payment ID
                    </label>

                    <p class="form-control-plaintext">
                        @Model.PaymentId
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        User
                    </label>

                    <p class="form-control-plaintext">
                        @Model.User?.FullName
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        Installment ID
                    </label>

                    <p class="form-control-plaintext">
                        @(Model.InstallmentId.HasValue ? Model.InstallmentId.ToString() : "-")
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        Payment Type
                    </label>

                    <p class="form-control-plaintext">
                        @Model.PaymentType
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        Amount
                    </label>

                    <p class="form-control-plaintext text-success fw-bold">
                        ₹ @Model.Amount.ToString("N2")
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        Payment Method
                    </label>

                    <p class="form-control-plaintext">
                        @Model.PaymentMethod
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        Payment Date
                    </label>

                    <p class="form-control-plaintext">
                        @Model.PaymentDate.ToString("dd MMM yyyy")
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="fw-bold text-secondary">
                        Status
                    </label>

                    @if (Model.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success px-3 py-2">
                            @Model.PaymentStatus
                        </span>
                    }
                    else if (Model.PaymentStatus == "Pending")
                    {
                        <span class="badge bg-warning text-dark px-3 py-2">
                            @Model.PaymentStatus
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2">
                            @Model.PaymentStatus
                        </span>
                    }

                </div>

                <div class="col-md-12 mb-3">

                    <label class="fw-bold text-secondary">
                        Remarks
                    </label>

                    <p class="form-control-plaintext">
                        @(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)
                    </p>

                </div>

            </div>

            <hr />

            <form asp-action="Delete">

                <input type="hidden" asp-for="PaymentId" />

                <div class="text-end">

                    <a asp-action="Index"
                       class="btn btn-secondary me-2">

                        <i class="bi bi-arrow-left-circle"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash-fill"></i>
                        Delete Payment

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>