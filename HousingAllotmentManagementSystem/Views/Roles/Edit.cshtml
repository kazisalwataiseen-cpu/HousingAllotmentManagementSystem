@model HousingAllotmentManagementSystem.Models.Role

@{
    ViewData["Title"] = "Edit Role";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-warning text-dark py-3">

                    <h3 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>
                        Edit Role
                    </h3>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Edit">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="RoleId" />

                        <!-- Role Name -->

                        <div class="mb-4">

                            <label asp-for="RoleName" class="form-label fw-semibold"></label>

                            <input asp-for="RoleName"
                                   class="form-control form-control-lg"
                                   placeholder="Enter Role Name" />

                            <span asp-validation-for="RoleName"
                                  class="text-danger"></span>

                        </div>

                        <!-- Description -->

                        <div class="mb-4">

                            <label asp-for="Description" class="form-label fw-semibold"></label>

                            <textarea asp-for="Description"
                                      rows="5"
                                      class="form-control"
                                      placeholder="Enter Description"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>

                        </div>

                        <!-- Created Date -->

                        <div class="mb-4">

                            <label asp-for="CreatedDate" class="form-label fw-semibold"></label>

                            <input asp-for="CreatedDate"
                                   class="form-control"
                                   readonly />

                        </div>

                        <div class="text-end">

                            <a asp-action="Index"
                               class="btn btn-secondary me-2">

                                <i class="bi bi-arrow-left-circle"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-warning">

                                <i class="bi bi-save-fill"></i>
                                Update Role

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}