@model HousingAllotmentManagementSystem.Models.Emiplan

@{
    ViewData["Title"] = "Create EMI Plan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar2-check-fill text-primary me-2"></i>
                Create EMI Plan
            </h2>

            <p class="text-muted mb-0">
                Create an EMI plan and automatically generate installments.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to EMI Plans

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-xl-10 col-lg-11">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white py-3">

                    <h5 class="mb-0">
                        <i class="bi bi-credit-card me-2"></i>
                        EMI Plan Information
                    </h5>

                    <small class="opacity-75">
                        Installments will be generated automatically.
                    </small>

                </div>


                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <!-- LOAN -->

                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-4">
                            <i class="bi bi-bank me-2"></i>
                            Loan Information
                        </h6>


                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="LoanId"
                                       class="form-label fw-semibold">

                                    Loan

                                </label>

                                <select asp-for="LoanId"
                                        asp-items="ViewBag.LoanId"
                                        class="form-select">

                                    <option value="0">
                                        -- Select Loan --
                                    </option>

                                </select>

                                <span asp-validation-for="LoanId"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="PlanStatus"
                                       class="form-label fw-semibold">

                                    Plan Status

                                </label>

                                <select asp-for="PlanStatus"
                                        class="form-select">

                                    <option value="Active">
                                        Active
                                    </option>

                                    <option value="Pending">
                                        Pending
                                    </option>

                                    <option value="Completed">
                                        Completed
                                    </option>

                                    <option value="Closed">
                                        Closed
                                    </option>

                                </select>

                                <span asp-validation-for="PlanStatus"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- EMI DATES -->

                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-4 mt-5">

                            <i class="bi bi-calendar-event me-2"></i>
                            EMI Schedule

                        </h6>


                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="EmistartDate"
                                       class="form-label fw-semibold">

                                    EMI Start Date

                                </label>

                                <input asp-for="EmistartDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="EmistartDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="TotalEmis"
                                       class="form-label fw-semibold">

                                    Total EMIs

                                </label>

                                <input asp-for="TotalEmis"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       placeholder="Example: 12" />

                                <small class="text-muted">
                                    Installment records will be generated automatically.
                                </small>

                                <span asp-validation-for="TotalEmis"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- FINANCIAL -->

                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-4 mt-5">

                            <i class="bi bi-currency-rupee me-2"></i>
                            EMI Financial Information

                        </h6>


                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="MonthlyEmi"
                                       class="form-label fw-semibold">

                                    Monthly EMI

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input asp-for="MonthlyEmi"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="Leave 0 to calculate automatically" />

                                </div>

                                <small class="text-muted">
                                    If entered, this amount will be used for installment generation.
                                </small>

                                <span asp-validation-for="MonthlyEmi"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="OutstandingBalance"
                                       class="form-label fw-semibold">

                                    Outstanding Balance

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input asp-for="OutstandingBalance"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           readonly />

                                </div>

                                <small class="text-muted">
                                    Calculated from loan amount minus down payment.
                                </small>

                            </div>

                        </div>


                        <!-- INFORMATION -->

                        <div class="alert alert-info mt-5">

                            <i class="bi bi-info-circle-fill me-2"></i>

                            <strong>Important:</strong>

                            After saving this EMI Plan, the system will automatically create
                            the installment records according to the number of EMIs.

                        </div>


                        <div class="border-top pt-4 mt-4">

                            <div class="d-flex justify-content-end gap-2">

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-x-circle me-1"></i>
                                    Cancel

                                </a>


                                <button type="submit"
                                        class="btn btn-primary">

                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Create EMI Plan

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}