@model IEnumerable<HousingAllotmentManagementSystem.Models.Emiplan>

@{
    ViewData["Title"] = "EMI Plans";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">

                <i class="bi bi-calculator text-primary me-2"></i>

                EMI Plans

            </h2>

            <p class="text-muted mb-0">

                Manage EMI plans with client, property and loan information.

            </p>
        </div>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>

            Create EMI Plan

        </a>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="bi bi-table me-2"></i>

                    EMI Plan Records

                </h5>

                <span class="badge bg-light text-primary">

                    @(Model?.Count() ?? 0) Plans

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>

                                <th class="ps-4">EMI Plan ID</th>
                                <th>Client</th>
                                <th>Property</th>
                                <th>Loan Number</th>
                                <th>Monthly EMI</th>
                                <th>Total EMIs</th>
                                <th>Paid</th>
                                <th>Remaining</th>
                                <th>Next Due</th>
                                <th>Outstanding</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                var loan = item.Loan;

                                var allotment =
                                    loan?.Allotment;

                                var client =
                                    allotment?.Application?.User;

                                var property =
                                    allotment?.Property;


                                <tr>

                                    <!-- EMI PLAN ID -->

                                    <td class="ps-4">

                                        <span class="fw-semibold">
                                            #@item.EmiplanId
                                        </span>

                                    </td>


                                    <!-- CLIENT -->

                                    <td>

                                        @if (client != null)
                                        {
                                            <div>

                                                <div class="fw-semibold">

                                                    <i class="bi bi-person-fill text-primary me-1"></i>

                                                    @client.FullName

                                                </div>

                                                <div class="small text-muted">

                                                    Client ID:
                                                    #@client.UserId

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-danger">

                                                Client not found

                                            </span>
                                        }

                                    </td>


                                    <!-- PROPERTY -->

                                    <td>

                                        @if (property != null)
                                        {
                                            <div>

                                                <div class="fw-semibold text-primary">

                                                    <i class="bi bi-house-fill me-1"></i>

                                                    @(property.Scheme?.SchemeName ?? "Property")

                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    property.UnitNumber))
                                                {
                                                    <div class="small text-muted">

                                                        Unit:
                                                        @property.UnitNumber

                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(
                                                    property.PlotNumber))
                                                {
                                                    <div class="small text-muted">

                                                        Plot:
                                                        @property.PlotNumber

                                                    </div>
                                                }

                                                <div class="small text-muted">

                                                    Property ID:
                                                    @property.PropertyId

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-danger">

                                                Property not found

                                            </span>
                                        }

                                    </td>


                                    <!-- LOAN -->

                                    <td>

                                        @if (loan != null)
                                        {
                                            <span class="fw-semibold">

                                                @loan.LoanNumber

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- MONTHLY EMI -->

                                    <td>

                                        <span class="fw-bold text-primary">

                                            ₹@item.MonthlyEmi.ToString("N2")

                                        </span>

                                    </td>


                                    <!-- TOTAL EMIs -->

                                    <td>
                                        @item.TotalEmis
                                    </td>


                                    <!-- PAID -->

                                    <td>

                                        <span class="badge bg-success-subtle text-success">

                                            @item.PaidEmis

                                        </span>

                                    </td>


                                    <!-- REMAINING -->

                                    <td>

                                        <span class="badge bg-warning-subtle text-warning">

                                            @item.RemainingEmis

                                        </span>

                                    </td>


                                    <!-- NEXT DUE -->

                                    <td>

                                        @item.NextDueDate.ToString(
                                            "dd MMM yyyy")

                                    </td>


                                    <!-- OUTSTANDING -->

                                    <td>

                                        <span class="fw-semibold">

                                            ₹@item.OutstandingBalance.ToString("N2")

                                        </span>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (item.PlanStatus == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else if (item.PlanStatus == "Completed")
                                        {
                                            <span class="badge bg-primary">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.PlanStatus
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-emiplanid="@item.EmiplanId"
                                               class="btn btn-sm btn-outline-info">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <a asp-action="Edit"
                                               asp-route-emiplanid="@item.EmiplanId"
                                               class="btn btn-sm btn-outline-warning">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <a asp-action="Delete"
                                               asp-route-emiplanid="@item.EmiplanId"
                                               class="btn btn-sm btn-outline-danger">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-calculator display-4 text-muted"></i>

                    <h5 class="fw-bold mt-3">
                        No EMI Plans Found
                    </h5>

                    <p class="text-muted">
                        There are currently no EMI plans.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>

                        Create First EMI Plan

                    </a>

                </div>
            }

        </div>

    </div>

</div>