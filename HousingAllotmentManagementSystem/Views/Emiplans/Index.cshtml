@model IEnumerable<HousingAllotmentManagementSystem.Models.Emiplan>

@{
    ViewData["Title"] = "EMI Plans";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar2-check-fill text-primary me-2"></i>
                EMI Plans
            </h2>

            <p class="text-muted mb-0">
                Manage EMI plans and generated installments.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>
            Create EMI Plan

        </a>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>
                                EMI Plan
                            </th>

                            <th>
                                Loan
                            </th>

                            <th>
                                Start Date
                            </th>

                            <th>
                                Total EMIs
                            </th>

                            <th>
                                Monthly EMI
                            </th>

                            <th>
                                Remaining
                            </th>

                            <th>
                                Installments
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="9"
                                    class="text-center text-muted py-5">

                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                                    No EMI Plans found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            EMI-@item.EmiplanId
                                        </strong>
                                    </td>


                                    <td>

                                        @if (item.Loan != null)
                                        {
                                            <span>
                                                @item.Loan.LoanNumber
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @item.EmistartDate.ToString("dd-MM-yyyy")
                                    </td>


                                    <td>
                                        @item.TotalEmis
                                    </td>


                                    <td>
                                        ₹@item.MonthlyEmi.ToString("N2")
                                    </td>


                                    <td>
                                        @item.RemainingEmis
                                    </td>


                                    <td>

                                        <span class="badge bg-info">
                                            @(item.Installments?.Count ?? 0)
                                        </span>

                                    </td>


                                    <td>

                                        @if (item.PlanStatus == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else if (item.PlanStatus == "Completed")
                                        {
                                            <span class="badge bg-primary">
                                                Completed
                                            </span>
                                        }
                                        else if (item.PlanStatus == "Closed")
                                        {
                                            <span class="badge bg-secondary">
                                                Closed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @item.PlanStatus
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-emiplanid="@item.EmiplanId"
                                               class="btn btn-sm btn-outline-info"
                                               title="Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <a asp-action="Edit"
                                               asp-route-emiplanid="@item.EmiplanId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <a asp-action="Delete"
                                               asp-route-emiplanid="@item.EmiplanId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>