@model HousingAllotmentManagementSystem.Models.Loan

@{
    ViewData["Title"] = "Loan Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-bank me-2"></i>
                Loan Details
            </h2>

            <p class="text-muted mb-0">
                View complete information about your housing loan.
            </p>
        </div>

        <a asp-controller="ClientLoan"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to My Loans

        </a>

    </div>


    <!-- LOAN SUMMARY -->
    <div class="row g-4 mb-4">

        <!-- LOAN AMOUNT -->
        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Loan Amount
                            </small>

                            <h4 class="fw-bold mt-2 mb-0">
                                ₹@Model.LoanAmount.ToString("N2")
                            </h4>

                        </div>

                        <i class="bi bi-cash-stack fs-2 text-primary"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- MONTHLY EMI -->
        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Monthly EMI
                            </small>

                            <h4 class="fw-bold text-primary mt-2 mb-0">
                                ₹@Model.Emiamount.ToString("N2")
                            </h4>

                        </div>

                        <i class="bi bi-calculator fs-2 text-primary"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- INTEREST RATE -->
        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Interest Rate
                            </small>

                            <h4 class="fw-bold mt-2 mb-0">
                                @Model.InterestRate.ToString("0.00")%
                            </h4>

                        </div>

                        <i class="bi bi-percent fs-2 text-warning"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- LOAN STATUS -->
        <div class="col-md-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Loan Status
                            </small>

                            <div class="mt-2">

                                @if (Model.LoanStatus == "Active")
                                {
                                    <span class="badge bg-success fs-6">
                                        Active
                                    </span>
                                }
                                else if (Model.LoanStatus == "Completed")
                                {
                                    <span class="badge bg-success fs-6">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark fs-6">
                                        @Model.LoanStatus
                                    </span>
                                }

                            </div>

                        </div>

                        <i class="bi bi-check-circle fs-2 text-success"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- LOAN INFORMATION -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Loan Information
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Loan Number
                        </div>

                        <div class="col-6 fw-bold">
                            @Model.LoanNumber
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Loan Amount
                        </div>

                        <div class="col-6 fw-bold">
                            ₹@Model.LoanAmount.ToString("N2")
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Down Payment
                        </div>

                        <div class="col-6 fw-bold">
                            ₹@Model.DownPayment.ToString("N2")
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Interest Rate
                        </div>

                        <div class="col-6 fw-bold">
                            @Model.InterestRate.ToString("0.00")%
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Loan Tenure
                        </div>

                        <div class="col-6 fw-bold">
                            @Model.LoanTenure Months
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Monthly EMI
                        </div>

                        <div class="col-6 fw-bold text-primary">
                            ₹@Model.Emiamount.ToString("N2")
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Sanction Date
                        </div>

                        <div class="col-6 fw-bold">
                            @Model.SanctionDate.ToString("dd MMMM yyyy")
                        </div>

                    </div>


                    <div class="row">

                        <div class="col-6 text-muted">
                            Created Date
                        </div>

                        <div class="col-6 fw-bold">
                            @Model.CreatedDate.ToString("dd MMMM yyyy")
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ALLOTMENT INFORMATION -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-house-check me-2"></i>
                        Allotment Information
                    </h5>

                </div>

                <div class="card-body">

                    @if (Model.Allotment != null)
                    {
                        <div class="row mb-3">

                            <div class="col-6 text-muted">
                                Allotment Number
                            </div>

                            <div class="col-6 fw-bold">
                                @Model.Allotment.AllotmentNumber
                            </div>

                        </div>


                        <div class="row mb-3">

                            <div class="col-6 text-muted">
                                Allotment Date
                            </div>

                            <div class="col-6 fw-bold">
                                @Model.Allotment.AllotmentDate.ToString("dd MMMM yyyy")
                            </div>

                        </div>


                        <div class="row mb-3">

                            <div class="col-6 text-muted">
                                Booking Amount
                            </div>

                            <div class="col-6 fw-bold">
                                ₹@Model.Allotment.BookingAmount.ToString("N2")
                            </div>

                        </div>


                        <div class="row mb-3">

                            <div class="col-6 text-muted">
                                Allotment Status
                            </div>

                            <div class="col-6">

                                @if (Model.Allotment.AllotmentStatus == "Booked")
                                {
                                    <span class="badge bg-success">
                                        Booked
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @Model.Allotment.AllotmentStatus
                                    </span>
                                }

                            </div>

                        </div>


                        @if (!string.IsNullOrEmpty(Model.Allotment.Remarks))
                        {
                            <div class="mt-4">

                                <small class="text-muted d-block mb-1">
                                    Remarks
                                </small>

                                <div class="alert alert-light mb-0">
                                    @Model.Allotment.Remarks
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">

                            <i class="bi bi-house-x display-5 text-muted"></i>

                            <p class="text-muted mt-3 mb-0">
                                Allotment information is not available.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- EMI PLANS -->
    <div class="card border-0 shadow-sm mt-4">

        <div class="card-header bg-dark text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-calculator me-2"></i>
                    EMI Plans
                </h5>

                <span class="badge bg-light text-dark">
                    @(Model.Emiplans?.Count ?? 0) Plan(s)
                </span>

            </div>

        </div>

        <div class="card-body">

            @if (Model.Emiplans != null && Model.Emiplans.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Plan ID
                                </th>

                                <th>
                                    Start Date
                                </th>

                                <th>
                                    End Date
                                </th>

                                <th>
                                    Total EMIs
                                </th>

                                <th>
                                    Paid
                                </th>

                                <th>
                                    Remaining
                                </th>

                                <th>
                                    Monthly EMI
                                </th>

                                <th>
                                    Outstanding
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var emi in Model.Emiplans.OrderByDescending(e => e.EmiplanId))
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        #@emi.EmiplanId
                                    </td>

                                    <td>
                                        @emi.EmistartDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        @emi.EmiendDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        @emi.TotalEmis
                                    </td>

                                    <td class="text-success fw-semibold">
                                        @emi.PaidEmis
                                    </td>

                                    <td class="text-danger fw-semibold">
                                        @emi.RemainingEmis
                                    </td>

                                    <td>
                                        ₹@emi.MonthlyEmi.ToString("N2")
                                    </td>

                                    <td>
                                        ₹@emi.OutstandingBalance.ToString("N2")
                                    </td>

                                    <td>

                                        @if (emi.PlanStatus == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else if (emi.PlanStatus == "Completed")
                                        {
                                            <span class="badge bg-primary">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @emi.PlanStatus
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="ClientEmi"
                                           asp-action="Details"
                                           asp-route-id="@emi.EmiplanId"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye"></i>
                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-calculator display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No EMI Plan Available
                    </h5>

                    <p class="text-muted mb-0">
                        An EMI plan has not been created for this loan yet.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ACTION BUTTONS -->
    <div class="d-flex justify-content-between align-items-center mt-4">

        <a asp-controller="ClientLoan"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to My Loans

        </a>


        @if (Model.Emiplans != null && Model.Emiplans.Any())
        {
            <a asp-controller="ClientEmi"
               asp-action="Details"
               asp-route-id="@Model.Emiplans.First().EmiplanId"
               class="btn btn-primary">

                <i class="bi bi-calculator me-1"></i>
                View EMI Details

            </a>
        }

    </div>

</div>