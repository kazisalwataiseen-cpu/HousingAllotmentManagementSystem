cshtml
@model HousingAllotmentManagementSystem.Models.LoanApplication

@{
    ViewData["Title"] = "Apply for Loan";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var property = ViewBag.Property as HousingAllotmentManagementSystem.Models.Property;
    var scheme = ViewBag.HousingScheme as HousingAllotmentManagementSystem.Models.HousingScheme;

    var emiPlanOptions =
        ViewBag.EMIPlanOptions as List<HousingAllotmentManagementSystem.Models.EMIPlanOption>
        ?? new List<HousingAllotmentManagementSystem.Models.EMIPlanOption>();
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <!-- ===================================================== -->
            <!-- PAGE HEADER -->
            <!-- ===================================================== -->

            <div class="text-center mb-4">

                <div class="mb-3">
                    <i class="bi bi-bank display-4 text-primary"></i>
                </div>

                <h2 class="fw-bold">
                    Apply for Housing Loan
                </h2>

                <p class="text-muted mb-0">
                    Review your allotted property, select an EMI plan
                    and submit your loan application.
                </p>

            </div>


            <!-- ===================================================== -->
            <!-- PROPERTY INFORMATION -->
            <!-- ===================================================== -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-primary text-white py-3">

                    <h5 class="mb-0">
                        <i class="bi bi-house-door-fill me-2"></i>
                        Allotted Property
                    </h5>

                </div>

                <div class="card-body p-4">

                    @if (property != null)
                    {
                        <div class="row">

                            <!-- PROPERTY NAME -->

                            <div class="col-md-6 mb-3">

                                <label class="text-muted small">
                                    Property
                                </label>

                                <div class="fw-bold fs-5">
                                    @(property.UnitNumber ?? "Property")
                                </div>

                            </div>


                            <!-- SCHEME -->

                            <div class="col-md-6 mb-3">

                                <label class="text-muted small">
                                    Housing Scheme
                                </label>

                                <div class="fw-bold">
                                    @(scheme?.SchemeName ?? "N/A")
                                </div>

                            </div>


                            <!-- UNIT NUMBER -->

                            <div class="col-md-4 mb-3">

                                <label class="text-muted small">
                                    Unit Number
                                </label>

                                <div class="fw-semibold">
                                    @(property.UnitNumber ?? "N/A")
                                </div>

                            </div>


                            <!-- PROPERTY TYPE -->

                            <div class="col-md-4 mb-3">

                                <label class="text-muted small">
                                    Property Type
                                </label>

                                <div class="fw-semibold">
                                    @(property.PropertyType ?? "N/A")
                                </div>

                            </div>


                            <!-- BEDROOMS -->

                            <div class="col-md-4 mb-3">

                                <label class="text-muted small">
                                    Bedrooms
                                </label>

                                <div class="fw-semibold">
                                    @(property.Bedrooms?.ToString() ?? "N/A")
                                </div>

                            </div>


                            <!-- PROPERTY PRICE -->

                            <div class="col-md-6">

                                <label class="text-muted small">
                                    Property Price
                                </label>

                                <div class="fw-bold text-success fs-5">

                                    @if (property.Price.HasValue)
                                    {
                                        @property.Price.Value.ToString("C", new System.Globalization.CultureInfo("en-IN"))
                                    }
                                    else
                                    {
                                        <span>N/A</span>
                                    }

                                </div>

                            </div>


                            <!-- ALLOTMENT ID -->

                            <div class="col-md-6">

                                <label class="text-muted small">
                                    Allotment ID
                                </label>

                                <div class="fw-semibold">
                                    #@Model.AllotmentId
                                </div>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Property information is not available.
                        </div>
                    }

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- LOAN APPLICATION -->
            <!-- ===================================================== -->

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white py-3">

                    <h5 class="mb-0">

                        <i class="bi bi-file-earmark-text me-2"></i>

                        Loan Application

                    </h5>

                </div>


                <div class="card-body p-4">

                    <form asp-action="Apply"
                          asp-controller="ClientLoan"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- Hidden Allotment -->

                        <input type="hidden"
                               asp-for="AllotmentId" />


                        <!-- ================================================= -->
                        <!-- LOAN AMOUNT -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label asp-for="RequestedLoanAmount"
                                   class="form-label fw-semibold">

                                Requested Loan Amount

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₹
                                </span>

                                <input asp-for="RequestedLoanAmount"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="1"
                                       placeholder="Enter requested loan amount" />

                            </div>

                            <span asp-validation-for="RequestedLoanAmount"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ================================================= -->
                        <!-- DOWN PAYMENT -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label asp-for="DownPayment"
                                   class="form-label fw-semibold">

                                Down Payment

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₹
                                </span>

                                <input asp-for="DownPayment"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="Enter down payment" />

                            </div>

                            <span asp-validation-for="DownPayment"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Down payment must be less than the requested loan amount.
                            </small>

                        </div>


                        <!-- ================================================= -->
                        <!-- EMI PLAN OPTIONS -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                <i class="bi bi-credit-card me-1"></i>

                                Select EMI Plan

                            </label>

                            <p class="text-muted small">
                                Choose one of the EMI plans available for your housing scheme.
                                Interest rate and tenure will be applied automatically.
                            </p>


                            <span asp-validation-for="EMIPlanOptionId"
                                  class="text-danger d-block mb-3">
                            </span>


                            @if (emiPlanOptions.Any())
                            {
                                <div class="row">

                                    @foreach (var plan in emiPlanOptions)
                                    {
                                        <div class="col-md-6 mb-3">

                                            <input type="radio"
                                                   class="btn-check"
                                                   asp-for="EMIPlanOptionId"
                                                   value="@plan.EMIPlanOptionId"
                                                   id="emiPlan_@plan.EMIPlanOptionId"
                                                   autocomplete="off" />

                                            <label class="card h-100 border shadow-sm emi-plan-card"
                                                   for="emiPlan_@plan.EMIPlanOptionId"
                                                   style="cursor:pointer;">

                                                <div class="card-body p-4">

                                                    <div class="d-flex justify-content-between align-items-start mb-3">

                                                        <div>

                                                            <h5 class="fw-bold mb-1">

                                                                @plan.PlanName

                                                            </h5>

                                                            <span class="badge bg-success">
                                                                Active
                                                            </span>

                                                        </div>

                                                        <i class="bi bi-check-circle-fill text-primary fs-4"></i>

                                                    </div>


                                                    <!-- INTEREST -->

                                                    <div class="d-flex justify-content-between border-bottom py-2">

                                                        <span class="text-muted">
                                                            Interest Rate
                                                        </span>

                                                        <strong>
                                                            @plan.InterestRate.ToString("0.00")%
                                                        </strong>

                                                    </div>


                                                    <!-- TENURE -->

                                                    <div class="d-flex justify-content-between border-bottom py-2">

                                                        <span class="text-muted">
                                                            Tenure
                                                        </span>

                                                        <strong>
                                                            @plan.TenureMonths Months
                                                        </strong>

                                                    </div>


                                                    <!-- DESCRIPTION -->
                                                    @if (!string.IsNullOrWhiteSpace(plan.Description))
                                                    {
                                                        <div class="mt-3">

                                                            <small class="text-muted">

                                                                @plan.Description

                                                            </small>

                                                        </div>
                                                    }

                                                </div>

                                            </label>

                                        </div>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">

                                    <i class="bi bi-exclamation-triangle me-2"></i>

                                    No active EMI plans are currently available
                                    for this housing scheme.

                                </div>
                            }

                        </div>


                        <!-- ================================================= -->
                        <!-- SELECTED PLAN INFORMATION -->
                        <!-- ================================================= -->

                        <div class="alert alert-info">

                            <i class="bi bi-info-circle me-2"></i>

                            <strong>Important:</strong>

                            The interest rate and loan tenure are determined
                            by the EMI plan you select above. They cannot be
                            manually changed.

                        </div>


                        <!-- ================================================= -->
                        <!-- VALIDATION SUMMARY -->
                        <!-- ================================================= -->

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- ================================================= -->
                        <!-- BUTTONS -->
                        <!-- ================================================= -->

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left me-1"></i>

                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-primary"
                                @(emiPlanOptions.Any() ? null : "disabled")>

                                <i class="bi bi-send me-1"></i>

                                Submit Loan Application

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- EMI PLAN CARD STYLE -->
<!-- ============================================================= -->

<style>

    .emi-plan-card {
        transition: all 0.2s ease-in-out;
    }

        .emi-plan-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.12) !important;
        }

    .btn-check:checked + .emi-plan-card {
        border: 2px solid var(--bs-primary) !important;
        background-color: rgba(13, 110, 253, 0.05);
    }

        .btn-check:checked + .emi-plan-card .bi-check-circle-fill {
            color: var(--bs-success) !important;
        }

</style>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

