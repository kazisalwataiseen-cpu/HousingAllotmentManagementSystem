@model IEnumerable<HousingAllotmentManagementSystem.Models.Allotment>

@{
    ViewData["Title"] = "My Allotments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-house-check me-2"></i>

                My Allotments

            </h2>

            <p class="text-muted mb-0">

                View the properties allotted to you.

            </p>

        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back to Home

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- ALLOTMENT LIST -->
    <!-- ========================================================= -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var allotment in Model)
            {
                <div class="col-lg-6">

                    <div class="card border-0 shadow-sm h-100">

                        <!-- ================================================= -->
                        <!-- CARD HEADER -->
                        <!-- ================================================= -->

                        <div class="card-header bg-primary text-white p-3">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    <small class="opacity-75">
                                        Allotment Number
                                    </small>

                                    <h5 class="fw-bold mb-0">
                                        @allotment.AllotmentNumber
                                    </h5>

                                </div>


                                <!-- STATUS -->
                                @if (allotment.AllotmentStatus == "Active")
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Active
                                    </span>
                                }
                                else if (allotment.AllotmentStatus == "Completed")
                                {
                                    <span class="badge bg-light text-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Completed
                                    </span>
                                }
                                else if (allotment.AllotmentStatus == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-clock me-1"></i>
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @allotment.AllotmentStatus
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- CARD BODY -->
                        <!-- ================================================= -->

                        <div class="card-body p-4">

                            <div class="row g-4">

                                <!-- ALLOTMENT ID -->

                                <div class="col-md-6">

                                    <small class="text-muted d-block">
                                        Allotment ID
                                    </small>

                                    <h6 class="fw-bold mt-1">
                                        @allotment.AllotmentId
                                    </h6>

                                </div>


                                <!-- APPLICATION ID -->

                                <div class="col-md-6">

                                    <small class="text-muted d-block">
                                        Application ID
                                    </small>

                                    <h6 class="fw-bold mt-1">
                                        @allotment.ApplicationId
                                    </h6>

                                </div>


                                <!-- PROPERTY ID -->

                                <div class="col-md-6">

                                    <small class="text-muted d-block">
                                        Property ID
                                    </small>

                                    <h6 class="fw-bold mt-1">
                                        @allotment.PropertyId
                                    </h6>

                                </div>


                                <!-- ALLOTMENT DATE -->

                                <div class="col-md-6">

                                    <small class="text-muted d-block">
                                        Allotment Date
                                    </small>

                                    <h6 class="fw-semibold mt-1">
                                        @allotment.AllotmentDate.ToString(
                                            "dd MMM yyyy")
                                    </h6>

                                </div>


                                <!-- BOOKING AMOUNT -->

                                <div class="col-md-6">

                                    <small class="text-muted d-block">
                                        Booking Amount
                                    </small>

                                    <h5 class="fw-bold text-primary mt-1">
                                        ₹@allotment.BookingAmount.ToString("N2")
                                    </h5>

                                </div>


                                <!-- PROPERTY DETAILS -->
                                @if (allotment.Property != null)
                                {
                                    <div class="col-md-6">

                                        <small class="text-muted d-block">
                                            Property Information
                                        </small>

                                        <h6 class="fw-semibold mt-1">

                                            Property #@allotment.PropertyId

                                        </h6>

                                    </div>
                                }


                                <!-- STATUS -->

                                <div class="col-md-6">

                                    <small class="text-muted d-block">
                                        Allotment Status
                                    </small>

                                    @if (allotment.AllotmentStatus == "Active")
                                    {
                                        <span class="badge bg-success mt-1">
                                            Active
                                        </span>
                                    }
                                    else if (allotment.AllotmentStatus == "Completed")
                                    {
                                        <span class="badge bg-primary mt-1">
                                            Completed
                                        </span>
                                    }
                                    else if (allotment.AllotmentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark mt-1">
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary mt-1">
                                            @allotment.AllotmentStatus
                                        </span>
                                    }

                                </div>


                                <!-- REMARKS -->

                                <div class="col-12">

                                    <small class="text-muted d-block mb-2">
                                        Remarks
                                    </small>

                                    @if (string.IsNullOrWhiteSpace(allotment.Remarks))
                                    {
                                        <div class="border rounded p-3 text-muted">

                                            No remarks available.

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="border rounded p-3">

                                            @allotment.Remarks

                                        </div>
                                    }

                                </div>

                            </div>


                            <hr class="my-4" />


                            <!-- ================================================= -->
                            <!-- ACTION -->
                            <!-- ================================================= -->

                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-controller="ClientAllotment"
                                   asp-action="Details"
                                   asp-route-id="@allotment.AllotmentId"
                                   class="btn btn-primary">

                                    <i class="bi bi-eye me-1"></i>

                                    View Details

                                </a>


                                @if (allotment.AllotmentStatus == "Active")
                                {
                                    <a asp-controller="ClientLoan"
                                       asp-action="Index"
                                       class="btn btn-outline-primary">

                                        <i class="bi bi-bank me-1"></i>

                                        Housing Loan

                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- ===================================================== -->
        <!-- NO ALLOTMENTS -->
        <!-- ===================================================== -->

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div class="mb-3">

                    <i class="bi bi-house-x display-1 text-muted"></i>

                </div>

                <h4 class="fw-bold mt-3">
                    No Allotments Found
                </h4>

                <p class="text-muted mb-4">

                    You currently do not have any property
                    allotments.

                </p>


                <a asp-controller="Home"
                   asp-action="HousingSchemes"
                   class="btn btn-primary">

                    <i class="bi bi-buildings me-1"></i>

                    Explore Housing Schemes

                </a>

            </div>

        </div>
    }

</div>