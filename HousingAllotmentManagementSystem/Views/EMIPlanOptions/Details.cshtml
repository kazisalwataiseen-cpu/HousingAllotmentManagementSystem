@model HousingAllotmentManagementSystem.Models.EMIPlanOption

@{
    ViewData["Title"] = "EMI Plan Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-calculator me-2"></i>
                EMI Plan Details
            </h2>

            <p class="text-muted mb-0">
                View EMI plan information.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white py-3">

                    <h5 class="mb-0">
                        @Model.PlanName
                    </h5>

                </div>


                <div class="card-body">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Housing Scheme
                            </small>

                            <strong>
                                @(Model.HousingScheme?.SchemeName ?? "N/A")
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Plan Name
                            </small>

                            <strong>
                                @Model.PlanName
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Tenure
                            </small>

                            <strong>
                                @Model.TenureMonths Months
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Interest Rate
                            </small>

                            <strong>
                                @Model.InterestRate.ToString("0.00")%
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Status
                            </small>

                            @if (Model.Status == "Active")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @Model.Status
                                </span>
                            }

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Created Date
                            </small>

                            <strong>
                                @Model.CreatedDate.ToString("dd-MM-yyyy")
                            </strong>

                        </div>


                        <div class="col-12">

                            <small class="text-muted d-block">
                                Description
                            </small>

                            <p class="mb-0">
                                @(string.IsNullOrWhiteSpace(Model.Description)
                                    ? "No description available."
                                    : Model.Description)
                            </p>

                        </div>

                    </div>


                    <div class="d-flex justify-content-between mt-4">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Back

                        </a>

                        <div>

                            <a asp-action="Edit"
                               asp-route-id="@Model.EMIPlanOptionId"
                               class="btn btn-primary">

                                <i class="bi bi-pencil me-1"></i>
                                Edit

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@Model.EMIPlanOptionId"
                               class="btn btn-danger">

                                <i class="bi bi-trash me-1"></i>
                                Delete

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>