@model IEnumerable<HousingAllotmentManagementSystem.Models.EMIPlanOption>

@{
    ViewData["Title"] = "EMI Plan Options";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calculator me-2"></i>
                EMI Plan Options
            </h2>

            <p class="text-muted mb-0">
                Manage EMI plans available to clients.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>
            Create EMI Plan

        </a>

    </div>


    <!-- TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>

                                <th>
                                    Plan Name
                                </th>

                                <th>
                                    Housing Scheme
                                </th>

                                <th>
                                    Tenure
                                </th>

                                <th>
                                    Interest Rate
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Created Date
                                </th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @item.PlanName
                                    </td>

                                    <td>
                                        @(item.HousingScheme?.SchemeName ?? "N/A")
                                    </td>

                                    <td>
                                        @item.TenureMonths Months

                                        <small class="text-muted">
                                            (@(item.TenureMonths / 12) Years)
                                        </small>
                                    </td>

                                    <td>
                                        @item.InterestRate.ToString("0.00")%
                                    </td>

                                    <td>

                                        @if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @item.CreatedDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.EMIPlanOptionId"
                                               class="btn btn-sm btn-outline-info"
                                               title="Details">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.EMIPlanOptionId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.EMIPlanOptionId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-calculator display-1 text-muted"></i>

                    <h4 class="fw-bold mt-3">
                        No EMI Plans Found
                    </h4>

                    <p class="text-muted">
                        Create your first EMI plan for a housing scheme.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Create EMI Plan

                    </a>

                </div>
            }

        </div>

    </div>

</div>