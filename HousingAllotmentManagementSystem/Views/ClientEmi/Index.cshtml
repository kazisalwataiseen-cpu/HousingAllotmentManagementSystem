@model IEnumerable<HousingAllotmentManagementSystem.Models.Emiplan>

@{
    ViewData["Title"] = "My EMIs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calculator me-2"></i>My EMI Plans
            </h2>
            <p class="text-muted mb-0">
                View your EMI schedule and repayment details
            </p>
        </div>

        <a asp-controller="Home" asp-action="Index"
           class="btn btn-outline-primary">
            <i class="bi bi-house me-1"></i> Home
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var emi in Model)
            {
                <div class="col-lg-6 col-xl-4">

                    <div class="card border-0 shadow-sm h-100">

                        <!-- Card Header -->
                        <div class="card-header bg-primary text-white py-3">
                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h5 class="mb-0 fw-bold">
                                        EMI Plan #@emi.EmiplanId
                                    </h5>

                                    <small>
                                        Loan No:
                                        @(emi.Loan?.LoanNumber ?? "N/A")
                                    </small>
                                </div>

                                @if (emi.PlanStatus == "Active")
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else if (emi.PlanStatus == "Completed")
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @emi.PlanStatus
                                    </span>
                                }

                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body">

                            <!-- Monthly EMI -->
                            <div class="text-center mb-4">
                                <small class="text-muted d-block">
                                    Monthly EMI
                                </small>

                                <h3 class="fw-bold text-primary mb-0">
                                    ₹@emi.MonthlyEmi.ToString("N2")
                                </h3>
                            </div>

                            <div class="row g-3">

                                <div class="col-6">
                                    <div class="border rounded p-3 h-100">
                                        <small class="text-muted d-block">
                                            Total EMIs
                                        </small>
                                        <strong>
                                            @emi.TotalEmis
                                        </strong>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="border rounded p-3 h-100">
                                        <small class="text-muted d-block">
                                            Paid EMIs
                                        </small>
                                        <strong class="text-success">
                                            @emi.PaidEmis
                                        </strong>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="border rounded p-3 h-100">
                                        <small class="text-muted d-block">
                                            Remaining
                                        </small>
                                        <strong class="text-danger">
                                            @emi.RemainingEmis
                                        </strong>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="border rounded p-3 h-100">
                                        <small class="text-muted d-block">
                                            Outstanding
                                        </small>
                                        <strong>
                                            ₹@emi.OutstandingBalance.ToString("N2")
                                        </strong>
                                    </div>
                                </div>

                            </div>

                            <hr />

                            <!-- Dates -->
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        Start Date
                                    </span>

                                    <strong>
                                        @emi.EmistartDate.ToString("dd-MM-yyyy")
                                    </strong>
                                </div>
                            </div>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">
                                        <i class="bi bi-calendar-check me-1"></i>
                                        End Date
                                    </span>

                                    <strong>
                                        @emi.EmiendDate.ToString("dd-MM-yyyy")
                                    </strong>
                                </div>
                            </div>

                            <div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">
                                        <i class="bi bi-clock me-1"></i>
                                        Next Due Date
                                    </span>

                                    <strong class="text-danger">
                                        @emi.NextDueDate.ToString("dd-MM-yyyy")
                                    </strong>
                                </div>
                            </div>

                        </div>

                        <!-- Card Footer -->
                        <div class="card-footer bg-white border-0 pb-3">

                            <a asp-controller="ClientEmi"
                               asp-action="Details"
                               asp-route-id="@emi.EmiplanId"
                               class="btn btn-primary w-100">

                                <i class="bi bi-eye me-1"></i>
                                View EMI Details

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- No EMI -->
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-calculator display-3 text-muted"></i>

                <h4 class="mt-3">
                    No EMI Plans Found
                </h4>

                <p class="text-muted">
                    You currently do not have any EMI plans associated
                    with your account.
                </p>

                <a asp-controller="ClientLoan"
                   asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-bank me-1"></i>
                    View My Loans

                </a>

            </div>

        </div>
    }

</div>