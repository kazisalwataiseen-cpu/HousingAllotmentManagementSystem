
@model HousingAllotmentManagementSystem.Models.Emiplan

@{
    ViewData["Title"] = "EMI Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var installments = Model.Installments?
        .OrderBy(i => i.InstallmentNumber)
        .ToList()
        ?? new List<HousingAllotmentManagementSystem.Models.Installment>();

    var totalAmount = Model.MonthlyEmi * Model.TotalEmis;

    var paidPercentage = Model.TotalEmis > 0
        ? (decimal)Model.PaidEmis / Model.TotalEmis * 100
        : 0;

    if (paidPercentage > 100)
    {
        paidPercentage = 100;
    }

    // Find next unpaid installment
    var nextInstallment = installments
        .Where(i =>
            i.PaymentStatus != "Paid" &&
            i.PaidAmount < i.InstallmentAmount)
        .OrderBy(i => i.InstallmentNumber)
        .FirstOrDefault();
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- SUCCESS / ERROR MESSAGES -->
    <!-- ========================================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-calculator me-2"></i>
                EMI Details
            </h2>

            <p class="text-muted mb-0">
                View your EMI plan and installment payment schedule.
            </p>

        </div>

        <a asp-controller="ClientEmi"
           asp-action="Index"
           class="btn btn-outline-primary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to EMIs

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- EMI PLAN SUMMARY -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-bar-chart me-2"></i>
                    EMI Plan Summary
                </h5>

                @if (Model.PlanStatus == "Completed")
                {
                    <span class="badge bg-light text-success">
                        Completed
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        @Model.PlanStatus
                    </span>
                }

            </div>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- TOTAL EMIs -->

                <div class="col-md-6 col-xl-2">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block">
                            Total EMIs
                        </small>

                        <h4 class="fw-bold mt-2 mb-0">
                            @Model.TotalEmis
                        </h4>

                    </div>

                </div>


                <!-- PAID EMIs -->

                <div class="col-md-6 col-xl-2">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block">
                            Paid EMIs
                        </small>

                        <h4 class="fw-bold text-success mt-2 mb-0">
                            @Model.PaidEmis
                        </h4>

                    </div>

                </div>


                <!-- REMAINING EMIs -->

                <div class="col-md-6 col-xl-2">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block">
                            Remaining EMIs
                        </small>

                        <h4 class="fw-bold text-danger mt-2 mb-0">
                            @Model.RemainingEmis
                        </h4>

                    </div>

                </div>


                <!-- MONTHLY EMI -->

                <div class="col-md-6 col-xl-2">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block">
                            Monthly EMI
                        </small>

                        <h5 class="fw-bold text-primary mt-2 mb-0">
                            ₹@Model.MonthlyEmi.ToString("N2")
                        </h5>

                    </div>

                </div>


                <!-- OUTSTANDING BALANCE -->

                <div class="col-md-6 col-xl-2">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block">
                            Outstanding Balance
                        </small>

                        <h5 class="fw-bold text-warning mt-2 mb-0">
                            ₹@Model.OutstandingBalance.ToString("N2")
                        </h5>

                    </div>

                </div>


                <!-- NEXT DUE DATE -->

                <div class="col-md-6 col-xl-2">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block">
                            Next Due Date
                        </small>

                        @if (nextInstallment != null)
                        {
                            <h6 class="fw-bold text-danger mt-2 mb-0">
                                @nextInstallment.DueDate.ToString("dd-MM-yyyy")
                            </h6>
                        }
                        else
                        {
                            <h6 class="fw-bold text-success mt-2 mb-0">
                                Completed
                            </h6>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- EMI PROGRESS -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-2">

                <span class="fw-semibold">
                    EMI Repayment Progress
                </span>

                <span class="text-muted">
                    @Model.PaidEmis / @Model.TotalEmis EMIs Paid
                </span>

            </div>


            <div class="progress" style="height: 12px;">

                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: @paidPercentage.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)%"
                     aria-valuenow="@paidPercentage"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>

            </div>


            <div class="text-end mt-2">

                <small class="text-muted">
                    @paidPercentage.ToString("0.00")% Completed
                </small>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- EMI PLAN INFORMATION -->
    <!-- ========================================================= -->

    <div class="row g-4 mb-4">

        <!-- EMI PLAN -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-dark text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        EMI Plan Information
                    </h5>

                </div>


                <div class="card-body">

                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            EMI Plan ID
                        </div>

                        <div class="col-6 fw-semibold">
                            #@Model.EmiplanId
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Loan Number
                        </div>

                        <div class="col-6 fw-semibold">

                            @(Model.Loan?.LoanNumber ?? "N/A")

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Total EMIs
                        </div>

                        <div class="col-6 fw-semibold">
                            @Model.TotalEmis
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Monthly EMI
                        </div>

                        <div class="col-6 fw-semibold text-primary">
                            ₹@Model.MonthlyEmi.ToString("N2")
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-6 text-muted">
                            Total Repayment
                        </div>

                        <div class="col-6 fw-semibold">
                            ₹@totalAmount.ToString("N2")
                        </div>

                    </div>


                    <div class="row">

                        <div class="col-6 text-muted">
                            Plan Status
                        </div>

                        <div class="col-6">

                            @if (Model.PlanStatus == "Active")
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Active
                                </span>
                            }
                            else if (Model.PlanStatus == "Completed")
                            {
                                <span class="badge bg-primary">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Completed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    @Model.PlanStatus
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- EMI DATES -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-calendar3 me-2"></i>
                        EMI Schedule Information
                    </h5>

                </div>


                <div class="card-body">

                    <div class="row mb-4">

                        <div class="col-2 text-primary fs-3">
                            <i class="bi bi-calendar-plus"></i>
                        </div>

                        <div class="col-10">

                            <small class="text-muted">
                                EMI Start Date
                            </small>

                            <div class="fw-bold">
                                @Model.EmistartDate.ToString("dd MMMM yyyy")
                            </div>

                        </div>

                    </div>


                    <div class="row mb-4">

                        <div class="col-2 text-danger fs-3">
                            <i class="bi bi-calendar-x"></i>
                        </div>

                        <div class="col-10">

                            <small class="text-muted">
                                EMI End Date
                            </small>

                            <div class="fw-bold">
                                @Model.EmiendDate.ToString("dd MMMM yyyy")
                            </div>

                        </div>

                    </div>


                    <div class="row mb-4">

                        <div class="col-2 text-warning fs-3">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                        <div class="col-10">

                            <small class="text-muted">
                                Next Due Date
                            </small>

                            <div class="fw-bold text-danger">

                                @if (nextInstallment != null)
                                {
                                    @nextInstallment.DueDate.ToString("dd MMMM yyyy")
                                }
                                else
                                {
                                    <span class="text-success">
                                        All EMIs Paid
                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="row">

                        <div class="col-2 text-success fs-3">
                            <i class="bi bi-clock-history"></i>
                        </div>

                        <div class="col-10">

                            <small class="text-muted">
                                Plan Created
                            </small>

                            <div class="fw-bold">
                                @Model.CreatedDate.ToString("dd MMMM yyyy")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- RELATED LOAN -->
    <!-- ========================================================= -->

    @if (Model.Loan != null)
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-secondary text-white">

                <h5 class="mb-0">
                    <i class="bi bi-bank me-2"></i>
                    Related Loan
                </h5>

            </div>


            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-4">

                        <small class="text-muted d-block">
                            Loan Number
                        </small>

                        <strong>
                            @Model.Loan.LoanNumber
                        </strong>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted d-block">
                            Loan Amount
                        </small>

                        <strong>
                            ₹@Model.Loan.LoanAmount.ToString("N2")
                        </strong>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted d-block">
                            Down Payment
                        </small>

                        <strong>
                            ₹@Model.Loan.DownPayment.ToString("N2")
                        </strong>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted d-block">
                            Interest Rate
                        </small>

                        <strong>
                            @Model.Loan.InterestRate.ToString("0.00")%
                        </strong>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted d-block">
                            Loan Tenure
                        </small>

                        <strong>
                            @Model.Loan.LoanTenure Months
                        </strong>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted d-block">
                            Loan Status
                        </small>

                        @if (Model.Loan.LoanStatus == "Active")
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else if (Model.Loan.LoanStatus == "Completed")
                        {
                            <span class="badge bg-primary">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                @Model.Loan.LoanStatus
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- INSTALLMENT SCHEDULE -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-bold">

                    <i class="bi bi-list-check me-2"></i>
                    Installment Schedule

                </h5>


                <span class="badge bg-light text-primary">

                    @installments.Count Installments

                </span>

            </div>

        </div>


        <div class="card-body">

            @if (installments.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>EMI No.</th>

                                <th>Due Date</th>

                                <th>EMI Amount</th>

                                <th>Principal</th>

                                <th>Interest</th>

                                <th>Paid Amount</th>

                                <th>Status</th>

                                <th class="text-center">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var installment in installments)
                            {
                                <tr>

                                    <!-- EMI NUMBER -->

                                    <td class="fw-bold">
                                        #@installment.InstallmentNumber
                                    </td>


                                    <!-- DUE DATE -->

                                    <td>

                                        @installment.DueDate.ToString("dd-MM-yyyy")

                                        @if (installment.PaymentStatus != "Paid" &&
                                             installment.DueDate < DateOnly.FromDateTime(DateTime.Today))
                                        {
                                            <br />

                                            <small class="text-danger">
                                                <i class="bi bi-exclamation-circle me-1"></i>
                                                Overdue
                                            </small>
                                        }

                                    </td>


                                    <!-- EMI AMOUNT -->

                                    <td class="fw-semibold">

                                        ₹@installment.InstallmentAmount.ToString("N2")

                                        @if (installment.LateFee > 0 &&
                                             installment.PaymentStatus != "Paid")
                                        {
                                            <br />

                                            <small class="text-danger">
                                                + ₹@installment.LateFee.ToString("N2") late fee
                                            </small>
                                        }

                                    </td>


                                    <!-- PRINCIPAL -->

                                    <td>
                                        ₹@installment.PrincipalAmount.ToString("N2")
                                    </td>


                                    <!-- INTEREST -->

                                    <td>
                                        ₹@installment.InterestAmount.ToString("N2")
                                    </td>


                                    <!-- PAID AMOUNT -->

                                    <td class="fw-semibold text-success">

                                        ₹@installment.PaidAmount.ToString("N2")

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (installment.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Paid

                                            </span>
                                        }
                                        else if (installment.PaymentStatus == "Overdue")
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-exclamation-circle me-1"></i>
                                                Overdue

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-clock me-1"></i>
                                                Pending

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTION -->

                                    <td class="text-center">

                                        @if (installment.PaymentStatus == "Paid" ||
                                             installment.PaidAmount >= installment.InstallmentAmount)
                                        {
                                            <span class="text-success fw-semibold">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Paid

                                            </span>
                                        }
                                        else
                                        {
                                            <a asp-controller="ClientEmi"
                                               asp-action="Pay"
                                               asp-route-id="@installment.InstallmentId"
                                               class="btn btn-sm btn-primary">

                                                <i class="bi bi-credit-card me-1"></i>
                                                Pay EMI

                                            </a>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-inbox display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No Installments Found
                    </h5>

                    <p class="text-muted mb-0">
                        No installment records are currently available
                        for this EMI plan.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- NEXT PAYMENT -->
    <!-- ========================================================= -->

    @if (nextInstallment != null)
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body">

                <div class="d-flex flex-column flex-md-row
                            justify-content-between
                            align-items-md-center">

                    <div>

                        <h5 class="fw-bold mb-1">
                            <i class="bi bi-credit-card me-2"></i>
                            Next EMI Payment
                        </h5>

                        <p class="text-muted mb-0">

                            EMI #@nextInstallment.InstallmentNumber

                            is due on

                            <strong>
                                @nextInstallment.DueDate.ToString("dd MMMM yyyy")
                            </strong>

                        </p>

                    </div>


                    <div class="mt-3 mt-md-0">

                        <a asp-controller="ClientEmi"
                           asp-action="Pay"
                           asp-route-id="@nextInstallment.InstallmentId"
                           class="btn btn-success">

                            <i class="bi bi-credit-card me-1"></i>
                            Pay Next EMI

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- BOTTOM ACTIONS -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-controller="ClientEmi"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to EMI Plans

        </a>


        <a asp-controller="ClientLoan"
           asp-action="Index"
           class="btn btn-outline-primary">

            <i class="bi bi-bank me-1"></i>
            View My Loans

        </a>

    </div>

</div>

