@model HousingAllotmentManagementSystem.Models.AuditLog

@{
    ViewData["Title"] = "Create Audit Log";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-journal-plus text-primary me-2"></i>
                Create Audit Log
            </h2>

            <p class="text-muted mb-0">
                Record a system activity or user action.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Audit Logs

        </a>

    </div>


    <!-- Main Card -->
    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm">

                <!-- Card Header -->
                <div class="card-header bg-primary text-white py-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">

                            <i class="bi bi-shield-plus fs-5"></i>

                        </div>

                        <div>

                            <h5 class="mb-0">
                                Audit Log Information
                            </h5>

                            <small class="opacity-75">
                                Enter the details of the activity
                            </small>

                        </div>

                    </div>

                </div>


                <!-- Card Body -->
                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- Validation -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- User & Action -->
                        <div class="row g-4">

                            <!-- User ID -->
                            <div class="col-md-6">

                                <label asp-for="UserId"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-person me-1 text-primary"></i>
                                    User ID

                                </label>

                                <input asp-for="UserId"
                                       type="number"
                                       class="form-control"
                                       placeholder="Enter User ID" />

                                <span asp-validation-for="UserId"
                                      class="text-danger small">
                                </span>

                                <small class="text-muted">
                                    Optional. Leave empty for system-generated activity.
                                </small>

                            </div>


                            <!-- Action -->
                            <div class="col-md-6">

                                <label asp-for="Action"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-lightning-charge me-1 text-primary"></i>
                                    Action

                                </label>

                                <select asp-for="Action"
                                        class="form-select">

                                    <option value="">
                                        -- Select Action --
                                    </option>

                                    <option value="Login">
                                        Login
                                    </option>

                                    <option value="Logout">
                                        Logout
                                    </option>

                                    <option value="Create">
                                        Create
                                    </option>

                                    <option value="Update">
                                        Update
                                    </option>

                                    <option value="Delete">
                                        Delete
                                    </option>

                                    <option value="View">
                                        View
                                    </option>

                                    <option value="Approve">
                                        Approve
                                    </option>

                                    <option value="Reject">
                                        Reject
                                    </option>

                                    <option value="Payment">
                                        Payment
                                    </option>

                                </select>

                                <span asp-validation-for="Action"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Table Name -->
                            <div class="col-md-6">

                                <label asp-for="TableName"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-table me-1 text-primary"></i>
                                    Table Name

                                </label>

                                <input asp-for="TableName"
                                       class="form-control"
                                       placeholder="e.g. Users, Payments, Loans" />

                                <span asp-validation-for="TableName"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Record ID -->
                            <div class="col-md-6">

                                <label asp-for="RecordId"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-hash me-1 text-primary"></i>
                                    Record ID

                                </label>

                                <input asp-for="RecordId"
                                       type="number"
                                       class="form-control"
                                       placeholder="Enter affected record ID" />

                                <span asp-validation-for="RecordId"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- IP Address -->
                            <div class="col-md-6">

                                <label asp-for="Ipaddress"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-globe me-1 text-primary"></i>
                                    IP Address

                                </label>

                                <input asp-for="Ipaddress"
                                       class="form-control"
                                       placeholder="e.g. 192.168.1.10"
                                       maxlength="50" />

                                <span asp-validation-for="Ipaddress"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Browser Info -->
                            <div class="col-md-6">

                                <label asp-for="BrowserInfo"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-browser-chrome me-1 text-primary"></i>
                                    Browser Information

                                </label>

                                <input asp-for="BrowserInfo"
                                       class="form-control"
                                       placeholder="e.g. Chrome / Edge / Firefox"
                                       maxlength="255" />

                                <span asp-validation-for="BrowserInfo"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Action Date -->
                            <div class="col-md-6">

                                <label asp-for="ActionDate"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-calendar-event me-1 text-primary"></i>
                                    Action Date

                                </label>

                                <input asp-for="ActionDate"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="ActionDate"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Description -->
                            <div class="col-12">

                                <label asp-for="Description"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-card-text me-1 text-primary"></i>
                                    Description

                                </label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="5"
                                          placeholder="Describe the activity or action performed..."></textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- Information Alert -->
                        <div class="alert alert-info border-0 mt-4">

                            <div class="d-flex align-items-start">

                                <i class="bi bi-info-circle-fill fs-5 me-2"></i>

                                <div>

                                    <strong>Audit Log:</strong>

                                    <p class="mb-0 mt-1">
                                        Audit logs are used to track important
                                        system activities such as login,
                                        creation, modification, deletion,
                                        approval, and payment operations.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- Buttons -->
                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-check-circle me-1"></i>
                                Save Audit Log

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
    ```

</div>

@section Scripts {

    
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    

}
