@model HousingAllotmentManagementSystem.Models.AuditLog

@{
    ViewData["Title"] = "Delete Audit Log";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    ```
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-trash text-danger me-2"></i>
                Delete Audit Log
            </h2>

            <p class="text-muted mb-0">
                Review the audit record before permanently deleting it.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Audit Logs

        </a>

    </div>


    <!-- Delete Card -->
    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm">

                <!-- Header -->
                <div class="card-header bg-danger text-white py-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">

                            <i class="bi bi-trash fs-5"></i>

                        </div>

                        <div>

                            <h5 class="mb-0">
                                Confirm Deletion
                            </h5>

                            <small class="opacity-75">
                                Audit Log ID: #@Model.AuditLogId
                            </small>

                        </div>

                    </div>

                </div>


                <!-- Body -->
                <div class="card-body p-4">

                    <!-- Warning -->
                    <div class="alert alert-danger border-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                            <div>

                                <h6 class="fw-bold mb-1">
                                    Are you sure you want to delete this audit log?
                                </h6>

                                <p class="mb-0">
                                    This action cannot be undone. The selected
                                    activity record will be permanently removed
                                    from the audit history.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- Audit Information -->
                    <div class="border rounded p-4 mt-4">

                        <div class="row g-4">

                            <!-- Audit ID -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-hash me-1"></i>
                                    Audit Log ID
                                </div>

                                <div class="fw-semibold fs-5">
                                    #@Model.AuditLogId
                                </div>

                            </div>


                            <!-- Action -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-2">
                                    <i class="bi bi-lightning-charge me-1"></i>
                                    Action
                                </div>

                                @{
                                    var action = Model.Action?.ToLower() ?? "";

                                    var badgeClass =
                                        "bg-secondary-subtle text-secondary";

                                    var icon = "bi-activity";

                                    if (action.Contains("create") ||
                                        action.Contains("add"))
                                    {
                                        badgeClass =
                                            "bg-success-subtle text-success";

                                        icon = "bi-plus-circle";
                                    }
                                    else if (action.Contains("update") ||
                                             action.Contains("edit"))
                                    {
                                        badgeClass =
                                            "bg-primary-subtle text-primary";

                                        icon = "bi-pencil-square";
                                    }
                                    else if (action.Contains("delete") ||
                                             action.Contains("remove"))
                                    {
                                        badgeClass =
                                            "bg-danger-subtle text-danger";

                                        icon = "bi-trash";
                                    }
                                    else if (action.Contains("login"))
                                    {
                                        badgeClass =
                                            "bg-info-subtle text-info";

                                        icon = "bi-box-arrow-in-right";
                                    }
                                    else if (action.Contains("logout"))
                                    {
                                        badgeClass =
                                            "bg-warning-subtle text-warning";

                                        icon = "bi-box-arrow-right";
                                    }
                                }

                                <span class="badge @badgeClass px-3 py-2">

                                    <i class="bi @icon me-1"></i>
                                    @Model.Action

                                </span>

                            </div>


                            <!-- Table Name -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-table me-1"></i>
                                    Table Name
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.TableName))
                                {
                                    <span class="badge bg-light text-dark border px-3 py-2">
                                        @Model.TableName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not specified
                                    </span>
                                }

                            </div>


                            <!-- Record ID -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-database me-1"></i>
                                    Record ID
                                </div>

                                @if (Model.RecordId.HasValue)
                                {
                                    <span class="fw-semibold">
                                        #@Model.RecordId
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not specified
                                    </span>
                                }

                            </div>


                            <!-- User -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-person me-1"></i>
                                    User ID
                                </div>

                                @if (Model.UserId.HasValue)
                                {
                                    <span class="fw-semibold">
                                        #@Model.UserId
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        System / No User
                                    </span>
                                }

                            </div>


                            <!-- IP Address -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-globe me-1"></i>
                                    IP Address
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.Ipaddress))
                                {
                                    <code>
                                        @Model.Ipaddress
                                    </code>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not available
                                    </span>
                                }

                            </div>


                            <!-- Action Date -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    Action Date
                                </div>

                                <div class="fw-semibold">
                                    @Model.ActionDate.ToString("dd MMM yyyy")
                                </div>

                                <small class="text-muted">
                                    @Model.ActionDate.ToString("hh:mm:ss tt")
                                </small>

                            </div>


                            <!-- Browser -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-browser-chrome me-1"></i>
                                    Browser Information
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.BrowserInfo))
                                {
                                    <div class="text-truncate"
                                         title="@Model.BrowserInfo">

                                        @Model.BrowserInfo

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not available
                                    </span>
                                }

                            </div>


                            <!-- Description -->
                            <div class="col-12">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-card-text me-1"></i>
                                    Description
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    <div class="border rounded bg-light p-3"
                                         style="white-space: pre-line;">

                                        @Model.Description

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No description available.
                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- Important Warning -->
                    <div class="alert alert-warning border-0 mt-4">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-shield-exclamation fs-5 me-2"></i>

                            <div>

                                <strong>Important:</strong>

                                <p class="mb-0 mt-1">
                                    Audit logs are historical records used for
                                    tracking system activity. Deleting this
                                    record may affect your audit trail.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Footer -->
                <div class="card-footer bg-white border-0 p-4">

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="AuditLogId" />

                        <div class="d-flex justify-content-between align-items-center">

                            <a asp-action="Details"
                               asp-route-id="@Model.AuditLogId"
                               class="btn btn-outline-info px-4">

                                <i class="bi bi-eye me-1"></i>
                                View Details

                            </a>


                            <div class="d-flex gap-2">

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary px-4">

                                    <i class="bi bi-x-circle me-1"></i>
                                    Cancel

                                </a>

                                <button type="submit"
                                        class="btn btn-danger px-4">

                                    <i class="bi bi-trash me-1"></i>
                                    Delete Audit Log

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
    ```

</div>
