@model HousingAllotmentManagementSystem.Models.Property

@{
    ViewData["Title"] = "Delete Property";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                <i class="bi bi-trash-fill"></i>
                Delete Property
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <h5>
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Are you sure you want to delete this property?
                </h5>

                <p class="mb-0">
                    This action cannot be undone.
                </p>
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Housing Scheme</label>
                    <div class="form-control bg-light">
                        @Model.Scheme?.SchemeName
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Property Type</label>
                    <div class="form-control bg-light">
                        @Model.PropertyType
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Unit Number</label>
                    <div class="form-control bg-light">
                        @Model.UnitNumber
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Plot Number</label>
                    <div class="form-control bg-light">
                        @Model.PlotNumber
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Bedrooms</label>
                    <div class="form-control bg-light">
                        @Model.Bedrooms
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Bathrooms</label>
                    <div class="form-control bg-light">
                        @Model.Bathrooms
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Price</label>
                    <div class="form-control bg-light">
                        ₹ @String.Format("{0:N0}", Model.Price)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Status</label>

                    <div>

                        @if (Model.Status == "Available")
                        {
                            <span class="badge bg-success fs-6">Available</span>
                        }
                        else if (Model.Status == "Booked")
                        {
                            <span class="badge bg-warning text-dark fs-6">Booked</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">Sold</span>
                        }

                    </div>

                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Created Date</label>
                    <div class="form-control bg-light">
                        @(Model.CreatedDate?.ToString("dd-MMM-yyyy"))
                    </div>
                </div>

            </div>

            <hr />

            <form asp-action="Delete">

                <input type="hidden" asp-for="PropertyId" />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill"></i>
                        Delete Property
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>