@model HousingAllotmentManagementSystem.Models.Property

@{
    ViewData["Title"] = "Add Property";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">
            <i class="bi bi-house-add-fill text-primary"></i>
            Add New Property
        </h2>

        <p class="text-muted mb-0">
            Add a new property to a housing scheme.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left-circle"></i>
        Back to Properties
    </a>

</div>

<div class="card shadow-lg border-0">

    <div class="card-header bg-primary text-white py-3">

        <h4 class="mb-0">
            <i class="bi bi-house-fill me-2"></i>
            Property Information
        </h4>

    </div>

    <div class="card-body p-4">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <!-- Validation Summary -->

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="row">

                <!-- ================================================= -->
                <!-- HOUSING SCHEME -->
                <!-- ================================================= -->
                <div class="col-md-6 mb-4">

                    <label asp-for="SchemeId"
                           class="form-label fw-semibold">
                        Housing Scheme
                    </label>

                    <select asp-for="SchemeId"
                            asp-items="ViewBag.Schemes"
                            class="form-select">

                        <option value="">
                            -- Select Housing Scheme --
                        </option>

                    </select>

                    <span asp-validation-for="SchemeId"
                          class="text-danger">
                    </span>

                </div>
                <!-- ================================================= -->
                <!-- PROPERTY TYPE -->
                <!-- ================================================= -->

                <div class="col-md-6 mb-4">

                    <label asp-for="PropertyType"
                           class="form-label fw-semibold">

                        <i class="bi bi-house me-1"></i>
                        Property Type

                    </label>

                    <select asp-for="PropertyType"
                            class="form-select">

                        <option value="">
                            -- Select Property Type --
                        </option>

                        <option value="Apartment">
                            Apartment
                        </option>

                        <option value="Villa">
                            Villa
                        </option>

                        <option value="Row House">
                            Row House
                        </option>

                        <option value="Plot">
                            Plot
                        </option>

                        <option value="Penthouse">
                            Penthouse
                        </option>

                    </select>

                    <span asp-validation-for="PropertyType"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- UNIT NUMBER -->
                <!-- ================================================= -->

                <div class="col-md-6 mb-4">

                    <label asp-for="UnitNumber"
                           class="form-label fw-semibold">

                        <i class="bi bi-hash me-1"></i>
                        Unit Number

                    </label>

                    <input asp-for="UnitNumber"
                           class="form-control"
                           placeholder="Example: A-101" />

                    <span asp-validation-for="UnitNumber"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- PLOT NUMBER -->
                <!-- ================================================= -->

                <div class="col-md-6 mb-4">

                    <label asp-for="PlotNumber"
                           class="form-label fw-semibold">

                        <i class="bi bi-grid-3x3-gap me-1"></i>
                        Plot Number

                    </label>

                    <input asp-for="PlotNumber"
                           class="form-control"
                           placeholder="Example: P-101" />

                    <span asp-validation-for="PlotNumber"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- BEDROOMS -->
                <!-- ================================================= -->

                <div class="col-md-3 mb-4">

                    <label asp-for="Bedrooms"
                           class="form-label fw-semibold">

                        <i class="bi bi-door-open me-1"></i>
                        Bedrooms

                    </label>

                    <input asp-for="Bedrooms"
                           type="number"
                           min="0"
                           class="form-control"
                           placeholder="0" />

                    <span asp-validation-for="Bedrooms"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- BATHROOMS -->
                <!-- ================================================= -->

                <div class="col-md-3 mb-4">

                    <label asp-for="Bathrooms"
                           class="form-label fw-semibold">

                        <i class="bi bi-droplet me-1"></i>
                        Bathrooms

                    </label>

                    <input asp-for="Bathrooms"
                           type="number"
                           min="0"
                           class="form-control"
                           placeholder="0" />

                    <span asp-validation-for="Bathrooms"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- CARPET AREA -->
                <!-- ================================================= -->

                <div class="col-md-3 mb-4">

                    <label asp-for="CarpetArea"
                           class="form-label fw-semibold">

                        Carpet Area

                    </label>

                    <input asp-for="CarpetArea"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Sq. Ft." />

                    <span asp-validation-for="CarpetArea"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- BUILT-UP AREA -->
                <!-- ================================================= -->

                <div class="col-md-3 mb-4">

                    <label asp-for="BuiltupArea"
                           class="form-label fw-semibold">

                        Built-up Area

                    </label>

                    <input asp-for="BuiltupArea"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Sq. Ft." />

                    <span asp-validation-for="BuiltupArea"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- FACING -->
                <!-- ================================================= -->

                <div class="col-md-6 mb-4">

                    <label asp-for="Facing"
                           class="form-label fw-semibold">

                        <i class="bi bi-compass me-1"></i>
                        Facing

                    </label>

                    <select asp-for="Facing"
                            class="form-select">

                        <option value="">
                            -- Select Facing --
                        </option>

                        <option value="East">East</option>
                        <option value="West">West</option>
                        <option value="North">North</option>
                        <option value="South">South</option>
                        <option value="North-East">North-East</option>
                        <option value="North-West">North-West</option>
                        <option value="South-East">South-East</option>
                        <option value="South-West">South-West</option>

                    </select>

                    <span asp-validation-for="Facing"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- STATUS -->
                <!-- ================================================= -->

                <div class="col-md-6 mb-4">

                    <label asp-for="Status"
                           class="form-label fw-semibold">

                        <i class="bi bi-check-circle me-1"></i>
                        Status

                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="">
                            -- Select Status --
                        </option>

                        <option value="Available">
                            Available
                        </option>

                        <option value="Booked">
                            Booked
                        </option>

                        <option value="Sold">
                            Sold
                        </option>

                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- PRICE -->
                <!-- ================================================= -->

                <div class="col-md-6 mb-4">

                    <label asp-for="Price"
                           class="form-label fw-semibold">

                        <i class="bi bi-currency-rupee me-1"></i>
                        Property Price

                    </label>

                    <input asp-for="Price"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Enter property price" />

                    <span asp-validation-for="Price"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- BOOKING AMOUNT -->
                <!-- ================================================= -->

                <div class="col-md-6 mb-4">

                    <label asp-for="BookingAmount"
                           class="form-label fw-semibold">

                        <i class="bi bi-cash-stack me-1"></i>
                        Booking Amount

                    </label>

                    <input asp-for="BookingAmount"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Enter booking amount" />

                    <span asp-validation-for="BookingAmount"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- FLOOR PLAN IMAGE -->
                <!-- ================================================= -->

                <div class="col-md-12 mb-4">

                    <label asp-for="FloorPlanImage"
                           class="form-label fw-semibold">

                        <i class="bi bi-image me-1"></i>
                        Floor Plan Image

                    </label>

                    <input asp-for="FloorPlanImage"
                           class="form-control"
                           placeholder="Enter image URL or image path" />

                    <span asp-validation-for="FloorPlanImage"
                          class="text-danger">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- DESCRIPTION -->
                <!-- ================================================= -->

                <div class="col-md-12 mb-4">

                    <label asp-for="Description"
                           class="form-label fw-semibold">

                        <i class="bi bi-card-text me-1"></i>
                        Description

                    </label>

                    <textarea asp-for="Description"
                              rows="4"
                              class="form-control"
                              placeholder="Enter property description..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- BUTTONS -->
            <!-- ================================================= -->

            <div class="d-flex justify-content-between">

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left-circle me-1"></i>
                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary px-4">

                    <i class="bi bi-check-circle-fill me-1"></i>
                    Save Property

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}