@model IEnumerable<HousingAllotmentManagementSystem.Models.LoanApplication>

@{
    ViewData["Title"] = "Loan Applications";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>
                Loan Applications
            </h2>

            <p class="text-muted mb-0">
                Review client loan applications with property information.
            </p>
        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-primary text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-table me-2"></i>
                    Loan Application Records
                </h5>

                <span class="badge bg-light text-primary">
                    @(Model?.Count() ?? 0) Applications
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>

                                <th class="ps-4">Application ID</th>
                                <th>Client</th>
                                <th>Property</th>
                                <th>Requested Amount</th>
                                <th>Down Payment</th>
                                <th>Interest</th>
                                <th>Tenure</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- APPLICATION ID -->

                                    <td class="ps-4">
                                        <span class="fw-semibold">
                                            #@item.LoanApplicationId
                                        </span>
                                    </td>


                                    <!-- CLIENT -->

                                    <td>

                                        @if (item.User != null)
                                        {
                                            <div>

                                                <div class="fw-semibold">
                                                    <i class="bi bi-person-fill text-primary me-1"></i>
                                                    @item.User.FullName
                                                </div>

                                                <div class="small text-muted">
                                                    Client ID: #@item.UserId
                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-danger">
                                                Client not found
                                            </div>
                                        }

                                    </td>


                                    <!-- PROPERTY -->

                                    <td>

                                        @if (item.Allotment?.Property != null)
                                        {
                                            <div>

                                                <div class="fw-semibold text-primary">
                                                    <i class="bi bi-house-fill me-1"></i>

                                                    @(item.Allotment.Property.Scheme?.SchemeName ?? "Property")
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    item.Allotment.Property.UnitNumber))
                                                {
                                                    <div class="small text-muted">
                                                        Unit:
                                                        @item.Allotment.Property.UnitNumber
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(
                                                    item.Allotment.Property.PlotNumber))
                                                {
                                                    <div class="small text-muted">
                                                        Plot:
                                                        @item.Allotment.Property.PlotNumber
                                                    </div>
                                                }

                                                <div class="small text-muted">
                                                    Property ID:
                                                    @item.Allotment.PropertyId
                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-danger">
                                                Property not found
                                            </span>
                                        }

                                    </td>


                                    <!-- REQUESTED AMOUNT -->

                                    <td class="fw-semibold">
                                        ₹@item.RequestedLoanAmount.ToString("N2")
                                    </td>


                                    <!-- DOWN PAYMENT -->

                                    <td>
                                        ₹@item.DownPayment.ToString("N2")
                                    </td>


                                    <!-- INTEREST -->

                                    <td>
                                        @item.InterestRate.ToString("0.00")%
                                    </td>


                                    <!-- TENURE -->

                                    <td>
                                        @item.LoanTenure months
                                    </td>


                                    <!-- DATE -->

                                    <td>
                                        @item.ApplicationDate.ToString("dd MMM yyyy")

                                        <div class="small text-muted">
                                            @item.ApplicationDate.ToString("hh:mm tt")
                                        </div>
                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (string.Equals(
                                            item.Status,
                                            "Approved",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Approved
                                            </span>
                                        }
                                        else if (string.Equals(
                                            item.Status,
                                            "Rejected",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle-fill me-1"></i>
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock me-1"></i>
                                                Pending
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.LoanApplicationId"
                                               class="btn btn-sm btn-outline-info"
                                               title="Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            @if (item.Status == "Pending")
                                            {
                                                <form asp-action="Approve"
                                                      asp-route-id="@item.LoanApplicationId"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Approve"
                                                            onclick="return confirm('Approve this loan application?');">

                                                        <i class="bi bi-check-lg"></i>

                                                    </button>

                                                </form>


                                                <form asp-action="Reject"
                                                      asp-route-id="@item.LoanApplicationId"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Reject"
                                                            onclick="return confirm('Reject this loan application?');">

                                                        <i class="bi bi-x-lg"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-file-earmark-x display-4 text-muted"></i>

                    <h5 class="fw-bold mt-3">
                        No Loan Applications Found
                    </h5>

                    <p class="text-muted">
                        There are currently no loan applications.
                    </p>

                </div>
            }

        </div>

    </div>

</div>