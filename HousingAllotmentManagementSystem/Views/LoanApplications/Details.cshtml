@model HousingAllotmentManagementSystem.Models.LoanApplication

@{
    ViewData["Title"] = "Loan Application Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-file-earmark-text me-2"></i>
                Loan Application Details
            </h2>

            <p class="text-muted mb-0">
                Review the complete loan application submitted by the client.
            </p>
        </div>

        <a asp-controller="LoanApplications"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Applications

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- STATUS ALERT -->
    <!-- ========================================================= -->
    @if (Model.Status == "Pending")
    {
        <div class="alert alert-warning border-0 shadow-sm mb-4">

            <i class="bi bi-clock-history me-2"></i>

            <strong>Pending Review</strong>

            <span class="ms-2">
                This loan application is waiting for administrator review.
            </span>

        </div>
    }
    else if (Model.Status == "Approved")
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">

            <i class="bi bi-check-circle-fill me-2"></i>

            <strong>Approved</strong>

            <span class="ms-2">
                This loan application has been approved and the loan has been created.
            </span>

        </div>
    }
    else if (Model.Status == "Rejected")
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">

            <i class="bi bi-x-circle-fill me-2"></i>

            <strong>Rejected</strong>

            <span class="ms-2">
                This loan application has been rejected.
            </span>

        </div>
    }


    <div class="row g-4">

        <!-- ===================================================== -->
        <!-- APPLICATION INFORMATION -->
        <!-- ===================================================== -->

        <div class="col-xl-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Application Information
                    </h5>

                </div>


                <div class="card-body p-4">

                    <div class="row g-4">

                        <!-- APPLICATION ID -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Application ID
                            </small>

                            <div class="fw-bold fs-5">
                                #@Model.LoanApplicationId
                            </div>

                        </div>


                        <!-- CLIENT -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Client
                            </small>

                            <div class="fw-bold fs-5">
                                @(Model.User?.FullName ?? "N/A")
                            </div>

                        </div>


                        <!-- USER ID -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                User ID
                            </small>

                            <div class="fw-semibold">
                                @Model.UserId
                            </div>

                        </div>


                        <!-- ALLOTMENT -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Allotment Number
                            </small>

                            <div class="fw-bold">
                                @(Model.Allotment?.AllotmentNumber ?? "N/A")
                            </div>

                        </div>


                        <!-- REQUESTED AMOUNT -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Requested Loan Amount
                            </small>

                            <div class="fw-bold text-primary fs-5">
                                ₹@Model.RequestedLoanAmount.ToString("N2")
                            </div>

                        </div>


                        <!-- DOWN PAYMENT -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Down Payment
                            </small>

                            <div class="fw-bold">
                                ₹@Model.DownPayment.ToString("N2")
                            </div>

                        </div>


                        <!-- INTEREST RATE -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Interest Rate
                            </small>

                            <div class="fw-bold">
                                @Model.InterestRate.ToString("0.00")%
                            </div>

                        </div>


                        <!-- TENURE -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Loan Tenure
                            </small>

                            <div class="fw-bold">
                                @Model.LoanTenure Months
                            </div>

                        </div>


                        <!-- APPLICATION DATE -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Application Date
                            </small>

                            <div class="fw-semibold">
                                @Model.ApplicationDate.ToString(
                                    "dd MMMM yyyy, hh:mm tt")
                            </div>

                        </div>


                        <!-- REVIEWED DATE -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Reviewed Date
                            </small>

                            @if (Model.ReviewedDate.HasValue)
                            {
                                <div class="fw-semibold">
                                    @Model.ReviewedDate.Value.ToString(
                                        "dd MMMM yyyy, hh:mm tt")
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    Not reviewed yet
                                </div>
                            }

                        </div>


                        <!-- STATUS -->

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Application Status
                            </small>

                            <div>

                                @if (Model.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-clock me-1"></i>
                                        Pending
                                    </span>
                                }
                                else if (Model.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Approved
                                    </span>
                                }
                                else if (Model.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @Model.Status
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- REMARKS -->

                        <div class="col-12">

                            <small class="text-muted d-block mb-2">
                                Remarks
                            </small>

                            @if (string.IsNullOrWhiteSpace(Model.Remarks))
                            {
                                <div class="border rounded p-3 text-muted">
                                    No remarks available.
                                </div>
                            }
                            else
                            {
                                <div class="border rounded p-3">
                                    @Model.Remarks
                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- ADMIN ACTIONS -->
        <!-- ===================================================== -->

        <div class="col-xl-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-dark text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-shield-check me-2"></i>
                        Administrator Actions
                    </h5>

                </div>


                <div class="card-body">

                    @if (Model.Status == "Pending")
                    {
                        <!-- APPROVE -->

                        <form asp-controller="LoanApplications"
                              asp-action="Approve"
                              asp-route-id="@Model.LoanApplicationId"
                              method="post"
                              class="mb-3">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-success w-100"
                                    onclick="return confirm('Are you sure you want to approve this loan application?');">

                                <i class="bi bi-check-circle me-1"></i>
                                Approve Loan Application

                            </button>

                        </form>


                        <!-- REJECT -->

                        <form asp-controller="LoanApplications"
                              asp-action="Reject"
                              asp-route-id="@Model.LoanApplicationId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Rejection Remarks
                                </label>

                                <textarea name="remarks"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Enter reason for rejection"
                                          required></textarea>

                            </div>

                            <button type="submit"
                                    class="btn btn-danger w-100"
                                    onclick="return confirm('Are you sure you want to reject this loan application?');">

                                <i class="bi bi-x-circle me-1"></i>
                                Reject Loan Application

                            </button>

                        </form>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <div class="alert alert-success">

                            <i class="bi bi-check-circle-fill me-2"></i>

                            <strong>Approved</strong>

                            <p class="mb-0 mt-2">
                                The loan application has been approved
                                and the actual loan has been created.
                            </p>

                        </div>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <div class="alert alert-danger">

                            <i class="bi bi-x-circle-fill me-2"></i>

                            <strong>Rejected</strong>

                            <p class="mb-0 mt-2">
                                This loan application has been rejected.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary">

                            This application has already been processed.

                        </div>
                    }

                </div>

            </div>


            <!-- QUICK INFORMATION -->

            <div class="card border-0 shadow-sm mt-4">

                <div class="card-header bg-light">

                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2"></i>
                        Processing Flow
                    </h6>

                </div>

                <div class="card-body">

                    <div class="small text-muted">

                        <div class="mb-2">
                            <strong>Pending:</strong>
                            Waiting for administrator review.
                        </div>

                        <div class="mb-2">
                            <strong>Approved:</strong>
                            An actual loan is created automatically.
                        </div>

                        <div>
                            <strong>Rejected:</strong>
                            No loan is created.
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>