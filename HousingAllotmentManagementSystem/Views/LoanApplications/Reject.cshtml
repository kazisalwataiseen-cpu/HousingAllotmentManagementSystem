@model HousingAllotmentManagementSystem.Models.LoanApplication

@{
    ViewData["Title"] = "Reject Loan Application";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-xl-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-danger text-white py-3">

                    <h5 class="mb-0">
                        <i class="bi bi-x-circle me-2"></i>
                        Reject Loan Application
                    </h5>

                </div>


                <div class="card-body p-4">

                    <div class="alert alert-danger">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        You are about to reject this loan application.
                        Please provide a reason for rejection.

                    </div>


                    <div class="row g-4 mb-4">

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Application ID
                            </small>

                            <strong>
                                #@Model.LoanApplicationId
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Client
                            </small>

                            <strong>
                                @(Model.User?.FullName ?? "N/A")
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Allotment
                            </small>

                            <strong>
                                @(Model.Allotment?.AllotmentNumber ?? "N/A")
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Requested Amount
                            </small>

                            <strong>
                                ₹@Model.RequestedLoanAmount.ToString("N2")
                            </strong>

                        </div>

                    </div>


                    <form asp-action="Reject"
                          asp-route-id="@Model.LoanApplicationId"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                Rejection Reason

                            </label>

                            <textarea name="remarks"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Enter reason for rejecting this loan application..."
                                      required></textarea>

                        </div>


                        <div class="d-flex justify-content-between">

                            <a asp-action="Details"
                               asp-route-id="@Model.LoanApplicationId"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Are you sure you want to reject this loan application?');">

                                <i class="bi bi-x-circle me-1"></i>
                                Confirm Rejection

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>