@model HousingAllotmentManagementSystem.Models.HousingScheme

@{
    ViewData["Title"] = "Housing Scheme Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-info text-white">
            <h3 class="mb-0">
                <i class="bi bi-info-circle-fill"></i>
                Housing Scheme Details
            </h3>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Scheme Name</label>
                    <div class="form-control bg-light">@Model.SchemeName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">City</label>
                    <div class="form-control bg-light">@Model.City</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">State</label>
                    <div class="form-control bg-light">@Model.State</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Location</label>
                    <div class="form-control bg-light">@Model.Location</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Launch Date</label>
                    <div class="form-control bg-light">
                        @(Model.LaunchDate?.ToString("dd-MM-yyyy"))
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Last Application Date</label>
                    <div class="form-control bg-light">
                        @(Model.LastApplicationDate?.ToString("dd-MM-yyyy"))
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Total Units</label>
                    <div class="form-control bg-light">
                        @Model.TotalUnits
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Status</label>

                    @if (Model.Status == true)
                    {
                        <span class="badge bg-success fs-6">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">Inactive</span>
                    }

                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Brochure</label>
                    <div class="form-control bg-light">
                        @Model.Brochure
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Banner Image</label>
                    <div class="form-control bg-light">
                        @Model.BannerImage
                    </div>
                </div>

                <div class="col-12 mb-3">
                    <label class="fw-bold">Description</label>

                    <div class="form-control bg-light" style="min-height:120px;">
                        @Model.Description
                    </div>
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-between">

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Back
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.SchemeId"
                   class="btn btn-warning">

                    <i class="bi bi-pencil-square"></i>
                    Edit

                </a>

            </div>

        </div>

    </div>

</div>