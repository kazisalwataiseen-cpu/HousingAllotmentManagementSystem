@model IEnumerable<HousingAllotmentManagementSystem.Models.HousingScheme>

@{
    ViewData["Title"] = "Housing Schemes";

    // IMPORTANT:
    // Do NOT use the Admin Layout on this page.
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Housing Schemes</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #f5f7fb;
                font-family: Arial, Helvetica, sans-serif;
                color: #263238;
            }

            /* =========================================
                                   PAGE
                                ========================================= */

            .housing-page {
                width: 100%;
                padding: 40px 45px 60px;
            }

            /* =========================================
                                   HEADER
                                ========================================= */

            .page-header {
                text-align: center;
                margin-bottom: 40px;
            }

                .page-header h1 {
                    font-size: 38px;
                    font-weight: 700;
                    color: #1f2937;
                    margin-bottom: 10px;
                }

                .page-header p {
                    font-size: 17px;
                    color: #6b7280;
                    margin: 0;
                }

            .header-icon {
                color: #2563eb;
                margin-right: 8px;
            }

            /* =========================================
                                   SEARCH
                                ========================================= */

            .search-container {
                max-width: 600px;
                margin: 0 auto 40px;
            }

            .search-box {
                height: 50px;
                border-radius: 25px;
                border: 1px solid #dbe1ea;
                padding: 0 20px;
                font-size: 16px;
                box-shadow: 0 3px 12px rgba(0,0,0,0.05);
            }

                .search-box:focus {
                    border-color: #2563eb;
                    box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
                }

            /* =========================================
                                   CARD GRID
                                ========================================= */

            .scheme-grid {
                display: grid;
                /* 3 CARDS PER ROW */
                grid-template-columns: repeat(3, 1fr);
                gap: 30px;
                width: 100%;
            }

            /* =========================================
                                   SCHEME CARD
                                ========================================= */

            .scheme-card {
                background: white;
                border-radius: 22px;
                overflow: hidden;
                box-shadow: 0 8px 25px rgba(0,0,0,0.08);
                transition: transform 0.25s ease, box-shadow 0.25s ease;
                display: flex;
                flex-direction: column;
            }

                .scheme-card:hover {
                    transform: translateY(-7px);
                    box-shadow: 0 15px 35px rgba(0,0,0,0.14);
                }

            /* =========================================
                                   IMAGE
                                ========================================= */

            .scheme-image {
                height: 265px;
                position: relative;
                overflow: hidden;
                background: #e5e7eb;
            }

                .scheme-image img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                    transition: transform 0.4s ease;
                }

            .scheme-card:hover .scheme-image img {
                transform: scale(1.05);
            }

            /* Image dark overlay */

            .scheme-image::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                bottom: 0;
                height: 90px;
                background: linear-gradient( transparent, rgba(0,0,0,0.75) );
            }

            /* =========================================
                                   SCHEME NAME
                                ========================================= */

            .scheme-name {
                position: absolute;
                left: 22px;
                bottom: 20px;
                color: white;
                font-size: 27px;
                font-weight: 700;
                z-index: 2;
                text-shadow: 0 2px 5px rgba(0,0,0,0.6);
            }

            /* =========================================
                                   STATUS
                                ========================================= */

            .status-badge {
                position: absolute;
                top: 18px;
                right: 18px;
                z-index: 3;
                padding: 8px 15px;
                border-radius: 20px;
                font-size: 14px;
                font-weight: 600;
                color: white;
            }

            .status-active {
                background: #16a34a;
            }

            .status-inactive {
                background: #dc2626;
            }

            /* =========================================
                                   CARD BODY
                                ========================================= */

            .scheme-body {
                padding: 25px;
                display: flex;
                flex-direction: column;
                flex: 1;
            }

            .scheme-description {
                min-height: 55px;
                color: #64748b;
                font-size: 16px;
                margin-bottom: 18px;
            }

            /* =========================================
                                   INFORMATION ROWS
                                ========================================= */

            .info-list {
                margin-top: 5px;
            }

            .info-row {
                display: flex;
                align-items: center;
                padding: 10px 0;
                border-bottom: 1px solid #edf0f4;
            }

                .info-row:last-child {
                    border-bottom: none;
                }

            .info-icon {
                width: 32px;
                color: #2563eb;
                font-size: 20px;
            }

            .info-label {
                color: #475569;
                font-size: 15px;
                flex: 1;
            }

            .info-value {
                color: #334155;
                font-size: 15px;
                font-weight: 700;
                text-align: right;
            }

            /* =========================================
                                   BUTTONS
                                ========================================= */

            .card-actions {
                display: grid;
                grid-template-columns: 1fr 1fr 1fr;
                gap: 10px;
                margin-top: 20px;
                padding-top: 18px;
                border-top: 1px solid #e5e7eb;
            }

                .card-actions a {
                    border-radius: 8px;
                    padding: 10px 5px;
                    text-align: center;
                    text-decoration: none;
                    font-size: 15px;
                    transition: 0.2s ease;
                }

            .btn-view {
                background: #06b6d4;
                color: white;
            }

                .btn-view:hover {
                    background: #0891b2;
                    color: white;
                }

            .btn-edit {
                background: #fbbf24;
                color: #111827;
            }

                .btn-edit:hover {
                    background: #f59e0b;
                    color: #111827;
                }

            .btn-delete {
                background: #ef3340;
                color: white;
            }

                .btn-delete:hover {
                    background: #dc2626;
                    color: white;
                }

            /* =========================================
                                   EMPTY STATE
                                ========================================= */
            /* =========================================
                           RESPONSIVE
                        ========================================= */

            /* 3 cards on desktop */

            @@media (min-width: 992px) {

                .scheme-grid {
                    grid-template-columns: repeat(3, 1fr);
                }
            }


            /* 2 cards on tablet */

            @@media (min-width: 576px) and (max-width: 991px) {

                .scheme-grid {
                    grid-template-columns: repeat(2, 1fr);
                }

                .housing-page {
                    padding: 30px 25px;
                }
            }


            /* 1 card on mobile */

            @@media (max-width: 575px) {

                .scheme-grid {
                    grid-template-columns: 1fr;
                }

                .housing-page {
                    padding: 25px 15px;
                }

                .page-header h1 {
                    font-size: 30px;
                }

                .scheme-image {
                    height: 230px;
                }
            }

    </style>

</head>

<body>

    <main class="housing-page">

        <!-- =====================================
             PAGE HEADER
        ====================================== -->

        <div class="page-header">

            <h1>
                <i class="bi bi-buildings-fill header-icon"></i>
                Housing Schemes
            </h1>

            <p>
                Explore available housing schemes and find the one
                that suits you best.
            </p>

        </div>


        <!-- =====================================
             SEARCH
        ====================================== -->

        <div class="search-container">

            <input type="text"
                   id="searchBox"
                   class="form-control search-box"
                   placeholder="Search housing schemes..." />

        </div>


        <!-- =====================================
             CARDS
        ====================================== -->
        @if (Model != null && Model.Any())
        {

            <div class="scheme-grid"
                 id="schemeGrid">

                @foreach (var item in Model)
                {

                    <div class="scheme-card">

                        <!-- IMAGE -->

                        <div class="scheme-image">

                            @if (!string.IsNullOrWhiteSpace(item.BannerImage))
                            {
                                <img src="@Url.Content("~/Images/schemes/" + item.BannerImage)"
                                     alt="@item.SchemeName"
                                     onerror="this.onerror=null; this.src='https://via.placeholder.com/800x500?text=Housing+Scheme';" />
                            }
                            else
                            {
                                <img src="https://via.placeholder.com/800x500?text=Housing+Scheme"
                                     alt="Housing Scheme" />
                            }


                            <!-- STATUS -->
                            @if (item.Status == true)
                            {
                                <span class="status-badge status-active">

                                    <i class="bi bi-check-circle-fill"></i>

                                    Active

                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">

                                    <i class="bi bi-x-circle-fill"></i>

                                    Inactive

                                </span>
                            }


                            <!-- SCHEME NAME -->

                            <div class="scheme-name">

                                @item.SchemeName

                            </div>

                        </div>


                        <!-- CARD BODY -->

                        <div class="scheme-body">


                            <!-- DESCRIPTION -->

                            <div class="scheme-description">

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    @item.Description
                                }
                                else
                                {
                                    <span>
                                        No description available for this housing scheme.
                                    </span>
                                }

                            </div>


                            <!-- INFORMATION -->

                            <div class="info-list">


                                <!-- CITY -->

                                <div class="info-row">

                                    <i class="bi bi-geo-alt-fill info-icon"></i>

                                    <span class="info-label">
                                        City
                                    </span>

                                    <strong class="info-value">
                                        @(item.City ?? "-")
                                    </strong>

                                </div>


                                <!-- STATE -->

                                <div class="info-row">

                                    <i class="bi bi-map-fill info-icon"></i>

                                    <span class="info-label">
                                        State
                                    </span>

                                    <strong class="info-value">
                                        @(item.State ?? "-")
                                    </strong>

                                </div>


                                <!-- LOCATION -->

                                <div class="info-row">

                                    <i class="bi bi-pin-map-fill info-icon"></i>

                                    <span class="info-label">
                                        Location
                                    </span>

                                    <strong class="info-value">
                                        @(item.Location ?? "-")
                                    </strong>

                                </div>


                                <!-- TOTAL UNITS -->

                                <div class="info-row">

                                    <i class="bi bi-house-fill info-icon"></i>

                                    <span class="info-label">
                                        Total Units
                                    </span>

                                    <strong class="info-value">
                                        @(item.TotalUnits?.ToString() ?? "-")
                                    </strong>

                                </div>


                                <!-- LAUNCH DATE -->

                                <div class="info-row">

                                    <i class="bi bi-calendar-event-fill info-icon"></i>

                                    <span class="info-label">
                                        Launch Date
                                    </span>

                                    <strong class="info-value">

                                        @(item.LaunchDate.HasValue
                                            ? item.LaunchDate.Value.ToString("dd MMM yyyy")
                                            : "-")

                                    </strong>

                                </div>


                                <!-- LAST APPLICATION DATE -->

                                <div class="info-row">

                                    <i class="bi bi-calendar-x-fill info-icon"></i>

                                    <span class="info-label">
                                        Apply Before
                                    </span>

                                    <strong class="info-value">

                                        @(item.LastApplicationDate.HasValue
                                            ? item.LastApplicationDate.Value.ToString("dd MMM yyyy")
                                            : "-")

                                    </strong>

                                </div>


                            </div>


                            <!-- ACTION BUTTONS -->

                            <div class="card-actions">

                                <a asp-action="Details"
                                   asp-route-id="@item.SchemeId"
                                   class="btn-view">

                                    <i class="bi bi-eye-fill"></i>

                                    View

                                </a>


                                <a asp-action="Edit"
                                   asp-route-id="@item.SchemeId"
                                   class="btn-edit">

                                    <i class="bi bi-pencil-fill"></i>

                                </a>


                                <a asp-action="Delete"
                                   asp-route-id="@item.SchemeId"
                                   class="btn-delete">

                                    <i class="bi bi-trash-fill"></i>

                                </a>

                            </div>


                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="empty-state">

                <i class="bi bi-buildings"></i>

                <h3>
                    No Housing Schemes Found
                </h3>

                <p>
                    There are currently no housing schemes available.
                </p>

            </div>

        }

    </main>


    <!-- =====================================
         SEARCH SCRIPT
    ====================================== -->

    <script>

            const searchBox =
                document.getElementById("searchBox");

            const cards =
                document.querySelectorAll(".scheme-card");


            searchBox.addEventListener("keyup", function() {

                const searchValue =
                    this.value.toLowerCase().trim();


                cards.forEach(function(card) {

                    const cardText =
                        card.innerText.toLowerCase();


                    if (cardText.includes(searchValue)) {

                        card.style.display = "";

                    }
                    else {

                        card.style.display = "none";

                    }

                });

            });

    </script>


</body>

</html>