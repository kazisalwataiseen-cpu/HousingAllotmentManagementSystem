@model IEnumerable<HousingAllotmentManagementSystem.Models.HousingScheme>

@{
    ViewData["Title"] = "Housing Schemes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>

    .scheme-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        height: 100%;
    }

        .scheme-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
        }

    .scheme-image {
        height: 210px;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        position: relative;
    }

    .scheme-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient( to bottom, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.70) );
    }

    .scheme-status {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 2;
    }

    .scheme-title {
        position: absolute;
        bottom: 15px;
        left: 18px;
        right: 18px;
        color: white;
        z-index: 2;
    }

        .scheme-title h4 {
            margin: 0;
            font-weight: 700;
            text-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
        }

    .scheme-body {
        padding: 20px;
    }

    .scheme-description {
        color: #6c757d;
        min-height: 48px;
        margin-bottom: 18px;
    }

    .scheme-info {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        color: #495057;
    }

        .scheme-info i {
            width: 25px;
            color: #2563eb;
            font-size: 18px;
        }

        .scheme-info strong {
            margin-left: auto;
            text-align: right;
        }

    .scheme-actions {
        border-top: 1px solid #eeeeee;
        margin-top: 18px;
        padding-top: 15px;
        display: flex;
        gap: 8px;
    }

        .scheme-actions .btn {
            flex: 1;
        }

    .search-card {
        border: none;
        border-radius: 15px;
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

        .empty-state i {
            font-size: 60px;
            color: #adb5bd;
        }

    /* 3 CARDS PER ROW */

    @@media (min-width: 992px) {

        .scheme-item {
            width: 33.333333%;
        }
    }

    @@media (max-width: 991px) and (min-width: 768px) {

        .scheme-item {
            width: 50%;
        }
    }

    @@media (max-width: 767px) {

        .scheme-item {
            width: 100%;
        }
    }

</style>


<div class="container-fluid">

    <!-- ================================= -->
    <!-- PAGE HEADER -->
    <!-- ================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-buildings-fill text-primary"></i>

                Housing Schemes

            </h2>

            <p class="text-muted mb-0">

                Browse and manage available housing schemes

            </p>

        </div>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle-fill me-1"></i>

            Add New Scheme

        </a>

    </div>


    <!-- ================================= -->
    <!-- SEARCH CARD -->
    <!-- ================================= -->

    <div class="card search-card shadow-sm mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <div class="input-group">

                        <span class="input-group-text bg-white">

                            <i class="bi bi-search"></i>

                        </span>

                        <input type="text"
                               id="searchBox"
                               class="form-control"
                               placeholder="Search housing scheme..." />

                    </div>

                </div>


                <div class="col-md-6 text-md-end mt-3 mt-md-0">

                    <span class="text-muted">

                        Total Schemes:

                        <strong>

                            @(Model?.Count() ?? 0)

                        </strong>

                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================= -->
    <!-- HOUSING SCHEME CARDS -->
    <!-- ================================= -->

    <div class="row g-4"
         id="schemeContainer">


        @if (Model != null && Model.Any())
        {

            foreach (var scheme in Model)
            {

                /*
                    ============================================
                    IMAGE
                    ============================================

                    Database should contain ONLY:

                    pmay.jpg
                    rajiv.jpg
                    greenvalley.jpg

                    Actual files should be:

                    wwwroot
                       └── images
                           └── schemes
                               ├── pmay.jpg
                               ├── rajiv.jpg
                               └── greenvalley.jpg
                */

                string backgroundImage;

                if (!string.IsNullOrWhiteSpace(scheme.BannerImage))
                {
                    backgroundImage =
                        Url.Content(
                            "~/images/schemes/" +
                            scheme.BannerImage.Trim()
                        );
                }
                else
                {
                    backgroundImage =
                        Url.Content(
                            "~/images/schemes/default.jpg"
                        );
                }


                /*
                    ============================================
                    DESCRIPTION
                    ============================================
                */

                string description;

                if (string.IsNullOrWhiteSpace(scheme.Description))
                {
                    description =
                        "No description available for this housing scheme.";
                }
                else
                {
                    description =
                        scheme.Description.Trim();
                }


                /*
                    ============================================
                    STATUS
                    ============================================
                */

                bool isActive = scheme.Status ?? false;


                /*
                    ============================================
                    CARD
                    ============================================
                */

                <div class="col-lg-4 col-md-6 col-12 scheme-item">

                    <div class="scheme-card">


                        <!-- =============================== -->
                        <!-- IMAGE -->
                        <!-- =============================== -->

                        <div class="scheme-image"
                             style="background-image: url('@backgroundImage');">


                            <div class="scheme-overlay"></div>


                            <!-- STATUS -->

                            <div class="scheme-status">

                                @if (isActive)
                                {

                                    <span class="badge bg-success px-3 py-2 rounded-pill">

                                        <i class="bi bi-check-circle-fill me-1"></i>

                                        Active

                                    </span>

                                }
                                else
                                {

                                    <span class="badge bg-danger px-3 py-2 rounded-pill">

                                        <i class="bi bi-x-circle-fill me-1"></i>

                                        Inactive

                                    </span>

                                }

                            </div>


                            <!-- SCHEME TITLE -->

                            <div class="scheme-title">

                                <h4>

                                    @scheme.SchemeName

                                </h4>

                            </div>

                        </div>


                        <!-- =============================== -->
                        <!-- CARD BODY -->
                        <!-- =============================== -->

                        <div class="scheme-body">


                            <!-- DESCRIPTION -->

                            <div class="scheme-description">

                                @if (description.Length > 110)
                                {

                                    @description.Substring(0, 110)

                                    <text>...</text>

                                }
                                else
                                {

                                    @description

                                }

                            </div>


                            <!-- =============================== -->
                            <!-- CITY -->
                            <!-- =============================== -->

                            <div class="scheme-info">

                                <i class="bi bi-geo-alt-fill"></i>

                                <span>

                                    City

                                </span>

                                <strong>

                                    @if (!string.IsNullOrWhiteSpace(scheme.City))
                                    {

                                        @scheme.City

                                    }
                                    else
                                    {

                                        <text>Not specified</text>

                                    }

                                </strong>

                            </div>


                            <!-- =============================== -->
                            <!-- STATE -->
                            <!-- =============================== -->

                            <div class="scheme-info">

                                <i class="bi bi-map-fill"></i>

                                <span>

                                    State

                                </span>

                                <strong>

                                    @if (!string.IsNullOrWhiteSpace(scheme.State))
                                    {

                                        @scheme.State

                                    }
                                    else
                                    {

                                        <text>Not specified</text>

                                    }

                                </strong>

                            </div>


                            <!-- =============================== -->
                            <!-- LOCATION -->
                            <!-- =============================== -->

                            <div class="scheme-info">

                                <i class="bi bi-pin-map-fill"></i>

                                <span>

                                    Location

                                </span>

                                <strong>

                                    @if (!string.IsNullOrWhiteSpace(scheme.Location))
                                    {

                                        @scheme.Location

                                    }
                                    else
                                    {

                                        <text>Not specified</text>

                                    }

                                </strong>

                            </div>


                            <!-- =============================== -->
                            <!-- TOTAL UNITS -->
                            <!-- =============================== -->

                            <div class="scheme-info">

                                <i class="bi bi-houses-fill"></i>

                                <span>

                                    Total Units

                                </span>

                                <strong>

                                    @(scheme.TotalUnits.HasValue
                                        ? scheme.TotalUnits.Value.ToString()
                                        : "0")

                                </strong>

                            </div>


                            <!-- =============================== -->
                            <!-- LAUNCH DATE -->
                            <!-- =============================== -->

                            <div class="scheme-info">

                                <i class="bi bi-calendar-check-fill"></i>

                                <span>

                                    Launch Date

                                </span>

                                <strong>

                                    @if (scheme.LaunchDate.HasValue)
                                    {

                                        @scheme.LaunchDate.Value.ToString("dd MMM yyyy")

                                    }
                                    else
                                    {

                                        <text>Not specified</text>

                                    }

                                </strong>

                            </div>


                            <!-- =============================== -->
                            <!-- LAST APPLICATION DATE -->
                            <!-- =============================== -->

                            <div class="scheme-info">

                                <i class="bi bi-calendar-x-fill"></i>

                                <span>

                                    Apply Before

                                </span>

                                <strong>

                                    @if (scheme.LastApplicationDate.HasValue)
                                    {

                                        @scheme.LastApplicationDate.Value.ToString("dd MMM yyyy")

                                    }
                                    else
                                    {

                                        <text>Not specified</text>

                                    }

                                </strong>

                            </div>


                            <!-- =============================== -->
                            <!-- ACTION BUTTONS -->
                            <!-- =============================== -->

                            <div class="scheme-actions">


                                <!-- DETAILS -->

                                <a asp-action="Details"
                                   asp-route-id="@scheme.SchemeId"
                                   class="btn btn-info text-white">

                                    <i class="bi bi-eye-fill me-1"></i>

                                    View

                                </a>


                                <!-- EDIT -->

                                <a asp-action="Edit"
                                   asp-route-id="@scheme.SchemeId"
                                   class="btn btn-warning">

                                    <i class="bi bi-pencil-fill"></i>

                                </a>


                                <!-- DELETE -->

                                <a asp-action="Delete"
                                   asp-route-id="@scheme.SchemeId"
                                   class="btn btn-danger">

                                    <i class="bi bi-trash-fill"></i>

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            }

        }
        else
        {

            <!-- ================================= -->
            <!-- EMPTY STATE -->
            <!-- ================================= -->

            <div class="col-12">

                <div class="card shadow-sm border-0">

                    <div class="empty-state">

                        <i class="bi bi-buildings"></i>

                        <h4 class="mt-3">

                            No Housing Schemes Found

                        </h4>

                        <p class="text-muted">

                            There are currently no housing schemes available.

                        </p>


                        <a asp-action="Create"
                           class="btn btn-primary">

                            <i class="bi bi-plus-circle me-1"></i>

                            Add First Scheme

                        </a>

                    </div>

                </div>

            </div>

        }

    </div>

</div>


<!-- ================================= -->
<!-- SEARCH SCRIPT -->
<!-- ================================= -->
@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const searchBox =
                document.getElementById("searchBox");

            const schemeItems =
                document.querySelectorAll(".scheme-item");


            if (searchBox) {

                searchBox.addEventListener("keyup", function() {

                    const searchValue =
                        this.value
                            .toLowerCase()
                            .trim();


                    schemeItems.forEach(function(item) {

                        const text =
                            item.innerText
                                .toLowerCase();


                        if (text.includes(searchValue)) {

                            item.style.display = "";

                        }
                        else {

                            item.style.display = "none";

                        }

                    });

                });

            }

        });

    </script>

}