@model HousingAllotmentManagementSystem.Models.Application

@{
    ViewData["Title"] = "Application Details";
    Layout = null;

    string status = string.IsNullOrWhiteSpace(Model.Status)
        ? "Pending"
        : Model.Status;

    string statusClass =
        string.Equals(status, "Approved", StringComparison.OrdinalIgnoreCase)
            ? "status-approved"
            : string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase)
                ? "status-rejected"
                : "status-pending";

    string statusIcon =
        string.Equals(status, "Approved", StringComparison.OrdinalIgnoreCase)
            ? "bi-check-circle-fill"
            : string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase)
                ? "bi-x-circle-fill"
                : "bi-hourglass-split";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Application Details - Housing Allotment System
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            body {
                margin: 0;
                background: #f5f7fb;
                color: #263238;
                font-family: Arial, Helvetica, sans-serif;
            }

            .page {
                padding: 40px 20px 60px;
            }

            .container-custom {
                max-width: 1000px;
                margin: auto;
            }

            .top-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 15px;
                flex-wrap: wrap;
                margin-bottom: 25px;
            }

            .back-btn {
                background: #2563eb;
                color: white;
                text-decoration: none;
                padding: 10px 18px;
                border-radius: 8px;
                font-weight: 600;
            }

                .back-btn:hover {
                    background: #1d4ed8;
                    color: white;
                }

            .details-card {
                background: white;
                border-radius: 18px;
                box-shadow: 0 8px 25px rgba(0,0,0,0.08);
                overflow: hidden;
            }

            .details-header {
                padding: 25px;
                background: #ffffff;
                border-bottom: 1px solid #e5e7eb;
            }

            .application-id {
                color: #2563eb;
                font-size: 16px;
                font-weight: 700;
            }

            .scheme-name {
                font-size: 27px;
                font-weight: 700;
                color: #1f2937;
                margin-top: 5px;
            }

            .location {
                color: #64748b;
                margin-top: 7px;
            }

            .status-badge {
                display: inline-block;
                padding: 8px 16px;
                border-radius: 25px;
                font-size: 14px;
                font-weight: 700;
            }

            .status-pending {
                background: #fef3c7;
                color: #92400e;
            }

            .status-approved {
                background: #dcfce7;
                color: #166534;
            }

            .status-rejected {
                background: #fee2e2;
                color: #991b1b;
            }

            .section {
                padding: 25px;
                border-bottom: 1px solid #e5e7eb;
            }

                .section:last-child {
                    border-bottom: none;
                }

            .section-title {
                font-size: 19px;
                font-weight: 700;
                color: #1f2937;
                margin-bottom: 18px;
            }

            .info-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 15px;
            }

            .info-box {
                background: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 11px;
                padding: 15px;
            }

            .info-label {
                display: block;
                color: #64748b;
                font-size: 13px;
                margin-bottom: 6px;
            }

            .info-value {
                display: block;
                color: #1f2937;
                font-weight: 700;
                font-size: 15px;
            }

            .remarks {
                background: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 11px;
                padding: 18px;
                color: #475569;
                line-height: 1.6;
            }

            .footer-buttons {
                padding: 20px 25px;
                display: flex;
                justify-content: space-between;
                gap: 12px;
                flex-wrap: wrap;
            }

            .btn-back {
                background: #64748b;
                color: white;
                text-decoration: none;
                padding: 10px 18px;
                border-radius: 8px;
                font-weight: 600;
            }

                .btn-back:hover {
                    background: #475569;
                    color: white;
                }

            .btn-schemes {
                background: #2563eb;
                color: white;
                text-decoration: none;
                padding: 10px 18px;
                border-radius: 8px;
                font-weight: 600;
            }

                .btn-schemes:hover {
                    background: #1d4ed8;
                    color: white;
                }

            @@media (max-width: 575px) {

                .page {
                    padding: 25px 12px 40px;
                }

                .details-header,
                .section,
                .footer-buttons {
                    padding-left: 16px;
                    padding-right: 16px;
                }

                .scheme-name {
                    font-size: 23px;
                }

                .info-grid {
                    grid-template-columns: 1fr;
                }
            }

    </style>

</head>

<body>

    <div class="page">

        <div class="container-custom">

            <!-- TOP BAR -->

            <div class="top-bar">

                <div>

                    <h2 class="fw-bold mb-1">
                        Application Details
                    </h2>

                    <p class="text-muted mb-0">
                        View complete information about your housing application.
                    </p>

                </div>

                <a asp-controller="Applications"
                   asp-action="MyApplications"
                   class="back-btn">

                    <i class="bi bi-arrow-left me-1"></i>

                    My Applications

                </a>

            </div>


            <!-- MAIN CARD -->

            <div class="details-card">


                <!-- HEADER -->

                <div class="details-header">

                    <div class="d-flex justify-content-between
                        align-items-start
                        gap-3
                        flex-wrap">

                        <div>

                            <div class="application-id">

                                Application #@Model.ApplicationId

                            </div>

                            <div class="scheme-name">

                                @(Model.Property?.Scheme?.SchemeName
                                    ?? "Housing Scheme")

                            </div>

                            <div class="location">

                                <i class="bi bi-geo-alt-fill me-1"></i>

                                @(Model.Property?.Scheme?.Location
                                    ?? Model.Property?.Scheme?.City
                                    ?? "Location not specified")

                            </div>

                        </div>


                        <!-- STATUS -->

                        <div>

                            <span class="status-badge @statusClass">

                                <i class="bi @statusIcon me-1"></i>

                                @status

                            </span>

                        </div>

                    </div>

                </div>


                <!-- APPLICANT INFORMATION -->

                <div class="section">

                    <div class="section-title">

                        <i class="bi bi-person-fill text-primary me-2"></i>

                        Applicant Information

                    </div>

                    <div class="info-grid">

                        <div class="info-box">

                            <span class="info-label">
                                Full Name
                            </span>

                            <span class="info-value">
                                @(Model.User?.FullName ?? "-")
                            </span>

                        </div>

                        <div class="info-box">

                            <span class="info-label">
                                Email
                            </span>

                            <span class="info-value">
                                @(Model.User?.Email ?? "-")
                            </span>

                        </div>

                        <div class="info-box">

                            <span class="info-label">
                                Mobile
                            </span>

                            <span class="info-value">
                                @(Model.User?.Mobile ?? "-")
                            </span>

                        </div>

                        <div class="info-box">

                            <span class="info-label">
                                Application Date
                            </span>

                            <span class="info-value">
                                @Model.ApplicationDate.ToString("dd MMM yyyy")
                            </span>

                        </div>

                    </div>

                </div>


                <!-- PROPERTY INFORMATION -->

                <div class="section">

                    <div class="section-title">

                        <i class="bi bi-house-fill text-primary me-2"></i>

                        Property Information

                    </div>

                    <div class="info-grid">

                        <div class="info-box">

                            <span class="info-label">
                                Unit Number
                            </span>

                            <span class="info-value">
                                @(Model.Property?.UnitNumber ?? "-")
                            </span>

                        </div>

                        <div class="info-box">

                            <span class="info-label">
                                Property Type
                            </span>

                            <span class="info-value">
                                @(Model.Property?.PropertyType ?? "-")
                            </span>

                        </div>

                        <div class="info-box">

                            <span class="info-label">
                                Property Price
                            </span>

                            <span class="info-value">

                                @if (Model.Property?.Price.HasValue == true)
                                {
                                    @:₹@Model.Property.Price.Value.ToString("N2")
                                }
                                else
                                {
                                    @:-
                                }

                            </span>

                        </div>

                        <div class="info-box">

                            <span class="info-label">
                                Property Status
                            </span>

                            <span class="info-value">

                                @(Model.Property?.Status ?? "-")

                            </span>

                        </div>

                    </div>

                </div>


                <!-- APPLICATION INFORMATION -->

                <div class="section">

                    <div class="section-title">

                        <i class="bi bi-file-earmark-text-fill text-primary me-2"></i>

                        Application Information

                    </div>

                    <div class="info-grid">

                        <div class="info-box">

                            <span class="info-label">
                                Application ID
                            </span>

                            <span class="info-value">
                                #@Model.ApplicationId
                            </span>

                        </div>

                        <div class="info-box">

                            <span class="info-label">
                                Status
                            </span>

                            <span class="info-value">
                                @status
                            </span>

                        </div>

                        <div class="info-box">

                            <span class="info-label">
                                Employment Type
                            </span>

                            <span class="info-value">
                                @(Model.EmploymentType ?? "-")
                            </span>

                        </div>

                        <div class="info-box">

                            <span class="info-label">
                                Annual Income
                            </span>

                            <span class="info-value">

                                @if (Model.AnnualIncome.HasValue)
                                {
                                    @:₹@Model.AnnualIncome.Value.ToString("N2")
                                }
                                else
                                {
                                    @:-
                                }

                            </span>

                        </div>

                    </div>

                </div>


                <!-- NOMINEE INFORMATION -->

                <div class="section">

                    <div class="section-title">

                        <i class="bi bi-people-fill text-primary me-2"></i>

                        Nominee Information

                    </div>

                    <div class="info-grid">

                        <div class="info-box">

                            <span class="info-label">
                                Nominee Name
                            </span>

                            <span class="info-value">
                                @(Model.NomineeName ?? "-")
                            </span>

                        </div>

                        <div class="info-box">

                            <span class="info-label">
                                Nominee Relation
                            </span>

                            <span class="info-value">
                                @(Model.NomineeRelation ?? "-")
                            </span>

                        </div>

                    </div>

                </div>


                <!-- REMARKS -->

                <div class="section">

                    <div class="section-title">

                        <i class="bi bi-chat-left-text-fill text-primary me-2"></i>

                        Remarks

                    </div>

                    <div class="remarks">

                        @(string.IsNullOrWhiteSpace(Model.Remarks)
                            ? "No remarks have been added."
                            : Model.Remarks)

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="footer-buttons">

                    <a asp-controller="Applications"
                       asp-action="MyApplications"
                       class="btn-back">

                        <i class="bi bi-arrow-left me-1"></i>

                        Back to My Applications

                    </a>

                    <a asp-controller="Home"
                       asp-action="HousingSchemes"
                       class="btn-schemes">

                        <i class="bi bi-buildings-fill me-1"></i>

                        Browse Housing Schemes

                    </a>

                </div>

            </div>

        </div>

    </div>

</body>

</html>