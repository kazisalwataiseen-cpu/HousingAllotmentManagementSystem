@model HousingAllotmentManagementSystem.Models.Application

@{
    ViewData["Title"] = "Application Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var scheme = Model.Property?.Scheme;
    var property = Model.Property;
    var allotment = Model.Allotments?.FirstOrDefault();
}

<div class="container py-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>
                Application #@Model.ApplicationId
            </h2>
            <p class="text-muted mb-0">
                Submitted on @Model.ApplicationDate.ToString("dd MMMM yyyy")
            </p>
        </div>

        <a asp-controller="Applications"
           asp-action="MyApplications"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to My Applications
        </a>
    </div>

    <!-- STATUS CARD -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-4 px-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <small class="text-muted d-block">Current Status</small>
                    @if (string.Equals(Model.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                    {
                        <h4 class="fw-bold text-success mb-0">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            Approved
                        </h4>
                    }
                    else if (string.Equals(Model.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                    {
                        <h4 class="fw-bold text-danger mb-0">
                            <i class="bi bi-x-circle-fill me-2"></i>
                            Rejected
                        </h4>
                    }
                    else
                    {
                        <h4 class="fw-bold text-warning mb-0">
                            <i class="bi bi-hourglass-split me-2"></i>
                            @(string.IsNullOrWhiteSpace(Model.Status) ? "Pending" : Model.Status)
                        </h4>
                    }
                </div>

                <div>
                    <small class="text-muted d-block">Housing Scheme</small>
                    <h5 class="fw-bold text-primary mb-0">
                        @(scheme?.SchemeName ?? "Housing Scheme")
                    </h5>
                    <small class="text-muted">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                        @(scheme?.Location ?? $"{scheme?.City}, {scheme?.State}" ?? "N/A")
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <!-- APPLICATION & NOMINEE DETAILS -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-lines-fill me-2"></i>
                        Applicant & Nominee Information
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-6 text-muted">Application ID</div>
                        <div class="col-6 fw-bold">#@Model.ApplicationId</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Employment Type</div>
                        <div class="col-6 fw-semibold">@(Model.EmploymentType ?? "Not Specified")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Annual Income</div>
                        <div class="col-6 fw-semibold">
                            @(Model.AnnualIncome.HasValue ? $"₹{Model.AnnualIncome.Value:N2}" : "Not Specified")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Nominee Name</div>
                        <div class="col-6 fw-semibold">@(Model.NomineeName ?? "Not Specified")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Nominee Relation</div>
                        <div class="col-6 fw-semibold">@(Model.NomineeRelation ?? "Not Specified")</div>
                    </div>

                    <div class="row">
                        <div class="col-6 text-muted">Remarks</div>
                        <div class="col-6">@(string.IsNullOrEmpty(Model.Remarks) ? "No remarks" : Model.Remarks)</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PROPERTY SPECIFICATIONS -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-house me-2"></i>
                        Applied Property Details
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-6 text-muted">Unit / Plot Number</div>
                        <div class="col-6 fw-bold text-primary">
                            @(string.IsNullOrEmpty(property?.UnitNumber) ? (string.IsNullOrEmpty(property?.PlotNumber) ? "Pending Assignment" : $"Plot {property.PlotNumber}") : $"Unit {property.UnitNumber}")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Property Type</div>
                        <div class="col-6 fw-semibold">@(property?.PropertyType ?? "Residential")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Carpet Area</div>
                        <div class="col-6 fw-semibold">
                            @(property?.CarpetArea.HasValue == true ? $"{property.CarpetArea:N2} sq.ft" : "N/A")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Built-up Area</div>
                        <div class="col-6 fw-semibold">
                            @(property?.BuiltupArea.HasValue == true ? $"{property.BuiltupArea:N2} sq.ft" : "N/A")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">Estimated Price</div>
                        <div class="col-6 fw-bold text-success">
                            @(property?.Price.HasValue == true ? $"₹{property.Price.Value:N2}" : "N/A")
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 text-muted">Booking Amount</div>
                        <div class="col-6 fw-bold">
                            @(property?.BookingAmount.HasValue == true ? $"₹{property.BookingAmount.Value:N2}" : "N/A")
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ALLOTMENT INFORMATION (IF ALLOTTED) -->
    @if (allotment != null)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-success text-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-house-check me-2"></i>
                        Allotment Confirmed
                    </h5>
                    <span class="badge bg-light text-success">
                        Allotment #@allotment.AllotmentNumber
                    </span>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-4 align-items-center">
                    <div class="col-md-3">
                        <small class="text-muted d-block">Allotment Date</small>
                        <h6 class="fw-bold mb-0">@allotment.AllotmentDate.ToString("dd MMMM yyyy")</h6>
                    </div>

                    <div class="col-md-3">
                        <small class="text-muted d-block">Booking Amount</small>
                        <h6 class="fw-bold text-primary mb-0">₹@allotment.BookingAmount.ToString("N2")</h6>
                    </div>

                    <div class="col-md-3">
                        <small class="text-muted d-block">Status</small>
                        <span class="badge bg-success">@allotment.AllotmentStatus</span>
                    </div>

                    <div class="col-md-3 text-md-end">
                        <a asp-controller="ClientProperty"
                           asp-action="Details"
                           asp-route-id="@allotment.PropertyId"
                           class="btn btn-sm btn-primary me-2">
                            <i class="bi bi-house me-1"></i>
                            View Property
                        </a>

                        <a asp-controller="ClientAllotment"
                           asp-action="Details"
                           asp-route-id="@allotment.AllotmentId"
                           class="btn btn-sm btn-outline-success">
                            <i class="bi bi-file-earmark-check me-1"></i>
                            Allotment Letter
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- BOTTOM ACTIONS -->
    <div class="d-flex justify-content-between">
        <a asp-controller="Applications"
           asp-action="MyApplications"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to My Applications
        </a>

        @if (allotment != null)
        {
            <a asp-controller="ClientLoan"
               asp-action="Index"
               class="btn btn-primary">
                <i class="bi bi-bank me-1"></i>
                Housing Loan Options
            </a>
        }
    </div>

</div>