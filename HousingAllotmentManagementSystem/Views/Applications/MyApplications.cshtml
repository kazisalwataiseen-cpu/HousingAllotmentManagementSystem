@model IEnumerable<HousingAllotmentManagementSystem.Models.Application>

@{
    ViewData["Title"] = "My Applications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>
                My Applications
            </h2>
            <p class="text-muted mb-0">
                View and track your submitted housing applications.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Home"
               asp-action="HousingSchemes"
               class="btn btn-outline-primary">
                <i class="bi bi-buildings me-1"></i>
                Explore Schemes
            </a>
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Home
            </a>
        </div>
    </div>

    <!-- SUCCESS / ERROR MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- APPLICATIONS LIST -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var scheme = item.Property?.Scheme;
                var property = item.Property;
                var allotment = item.Allotments?.FirstOrDefault();

                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">

                        <!-- HEADER -->
                        <div class="card-header bg-primary text-white p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="opacity-75">Application Number</small>
                                    <h5 class="mb-0 fw-bold">#@item.ApplicationId</h5>
                                </div>

                                <div>
                                    @if (string.Equals(item.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success fs-6">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Approved
                                        </span>
                                    }
                                    else if (string.Equals(item.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger fs-6">
                                            <i class="bi bi-x-circle-fill me-1"></i>
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark fs-6">
                                            <i class="bi bi-hourglass-split me-1"></i>
                                            @(string.IsNullOrWhiteSpace(item.Status) ? "Pending" : item.Status)
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- BODY -->
                        <div class="card-body p-4">

                            <!-- SCHEME -->
                            <div class="mb-3 pb-3 border-bottom">
                                <small class="text-muted d-block">Housing Scheme</small>
                                <h5 class="fw-bold text-primary mt-1 mb-0">
                                    @(scheme?.SchemeName ?? "Housing Scheme")
                                </h5>
                                <small class="text-muted">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                    @(scheme?.Location ?? $"{scheme?.City}, {scheme?.State}" ?? "Location not specified")
                                </small>
                            </div>

                            <!-- DETAILS GRID -->
                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Property Unit</small>
                                    <strong>@(property?.UnitNumber ?? (property?.PlotNumber != null ? $"Plot {property.PlotNumber}" : "Not Assigned"))</strong>
                                </div>

                                <div class="col-6">
                                    <small class="text-muted d-block">Property Type</small>
                                    <strong>@(property?.PropertyType ?? "Residential")</strong>
                                </div>

                                <div class="col-6">
                                    <small class="text-muted d-block">Application Date</small>
                                    <span>@item.ApplicationDate.ToString("dd MMM yyyy")</span>
                                </div>

                                <div class="col-6">
                                    <small class="text-muted d-block">Property Price</small>
                                    <span class="text-success fw-bold">
                                        @(property?.Price.HasValue == true ? $"₹{property.Price.Value:N2}" : "-")
                                    </span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Remarks))
                            {
                                <div class="mb-3">
                                    <small class="text-muted d-block">Remarks</small>
                                    <div class="alert alert-light border small py-2 px-3 mb-0">
                                        @item.Remarks
                                    </div>
                                </div>
                            }

                            <!-- ALLOTMENT INFORMATION IF ALLOTTED -->
                            @if (allotment != null)
                            {
                                <div class="alert alert-success border-0 py-2 px-3 mb-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="bi bi-house-check-fill me-1"></i>
                                            <strong>Allotment:</strong> @allotment.AllotmentNumber
                                        </div>
                                        <span class="badge bg-success">@allotment.AllotmentStatus</span>
                                    </div>
                                    <div class="small text-muted mt-1">
                                        Allotted on @allotment.AllotmentDate.ToString("dd MMM yyyy") &bull; Booking: ₹@allotment.BookingAmount.ToString("N2")
                                    </div>
                                </div>
                            }

                        </div>

                        <!-- FOOTER -->
                        <div class="card-footer bg-white border-0 p-3 pt-0 d-flex justify-content-between align-items-center">
                            <a asp-controller="Applications"
                               asp-action="MyApplicationDetails"
                               asp-route-applicationId="@item.ApplicationId"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye-fill me-1"></i>
                                View Application Details
                            </a>

                            @if (allotment != null)
                            {
                                <a asp-controller="ClientProperty"
                                   asp-action="Details"
                                   asp-route-id="@allotment.PropertyId"
                                   class="btn btn-sm btn-success">
                                    <i class="bi bi-house-door me-1"></i>
                                    View Property
                                </a>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-file-earmark-x display-1 text-muted"></i>
                <h3 class="fw-bold mt-3">No Applications Found</h3>
                <p class="text-muted mb-4">
                    You have not submitted any housing applications yet.
                </p>
                <a asp-controller="Home"
                   asp-action="HousingSchemes"
                   class="btn btn-primary">
                    <i class="bi bi-buildings-fill me-1"></i>
                    Explore Housing Schemes
                </a>
            </div>
        </div>
    }

</div>