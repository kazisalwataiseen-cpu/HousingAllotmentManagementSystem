@model IEnumerable<HousingAllotmentManagementSystem.Models.Application>

@{
    ViewData["Title"] = "My Applications";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>My Applications - Housing Allotment System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            body {
                margin: 0;
                background: #f5f7fb;
                color: #263238;
                font-family: Arial, Helvetica, sans-serif;
            }

            .page {
                padding: 40px 25px 60px;
            }

            .container-custom {
                max-width: 1200px;
                margin: auto;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
                flex-wrap: wrap;
                margin-bottom: 30px;
            }

                .page-header h1 {
                    font-size: 32px;
                    font-weight: 700;
                    color: #1f2937;
                    margin-bottom: 5px;
                }

                .page-header p {
                    color: #64748b;
                    margin: 0;
                }

            .back-home {
                background: #2563eb;
                color: white;
                text-decoration: none;
                padding: 11px 20px;
                border-radius: 9px;
                font-weight: 600;
            }

                .back-home:hover {
                    background: #1d4ed8;
                    color: white;
                }

            .application-card {
                background: white;
                border-radius: 18px;
                box-shadow: 0 8px 25px rgba(0,0,0,0.08);
                margin-bottom: 20px;
                overflow: hidden;
            }

            .application-card-header {
                padding: 20px 22px;
                border-bottom: 1px solid #e5e7eb;
            }

            .application-id {
                color: #2563eb;
                font-size: 18px;
                font-weight: 700;
            }

            .scheme-name {
                font-size: 20px;
                font-weight: 700;
                color: #1f2937;
            }

            .scheme-location {
                color: #64748b;
                font-size: 14px;
                margin-top: 4px;
            }

            .application-card-body {
                padding: 20px 22px;
            }

            .info-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 15px;
            }

            .info-box {
                background: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 11px;
                padding: 14px;
            }

            .info-label {
                display: block;
                color: #64748b;
                font-size: 13px;
                margin-bottom: 5px;
            }

            .info-value {
                display: block;
                color: #1f2937;
                font-weight: 700;
                font-size: 15px;
            }

            .status-badge {
                display: inline-block;
                padding: 7px 14px;
                border-radius: 20px;
                font-size: 13px;
                font-weight: 600;
            }

            .status-pending {
                background: #fef3c7;
                color: #92400e;
            }

            .status-approved {
                background: #dcfce7;
                color: #166534;
            }

            .status-rejected {
                background: #fee2e2;
                color: #991b1b;
            }

            .card-footer-custom {
                border-top: 1px solid #e5e7eb;
                padding: 15px 22px;
                display: flex;
                justify-content: flex-end;
            }

            .view-btn {
                background: #06b6d4;
                color: white;
                text-decoration: none;
                padding: 9px 18px;
                border-radius: 8px;
                font-weight: 600;
            }

                .view-btn:hover {
                    background: #0891b2;
                    color: white;
                }

            .empty-state {
                background: white;
                border-radius: 18px;
                padding: 70px 20px;
                text-align: center;
                box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            }

                .empty-state i {
                    font-size: 70px;
                    color: #94a3b8;
                }

                .empty-state h3 {
                    margin-top: 20px;
                    font-weight: 700;
                }

            .browse-btn {
                display: inline-block;
                margin-top: 15px;
                background: #2563eb;
                color: white;
                text-decoration: none;
                padding: 11px 22px;
                border-radius: 9px;
                font-weight: 600;
            }

                .browse-btn:hover {
                    background: #1d4ed8;
                    color: white;
                }

            @@media (max-width: 991px) {

                .info-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @@media (max-width: 575px) {

                .page {
                    padding: 25px 12px 40px;
                }

                .page-header h1 {
                    font-size: 27px;
                }

                .info-grid {
                    grid-template-columns: 1fr;
                }

                .application-card-header,
                .application-card-body,
                .card-footer-custom {
                    padding-left: 16px;
                    padding-right: 16px;
                }
            }

    </style>

</head>

<body>

    <div class="page">

        <div class="container-custom">

            <!-- HEADER -->

            <div class="page-header">

                <div>

                    <h1>
                        <i class="bi bi-file-earmark-text-fill text-primary me-2"></i>
                        My Applications
                    </h1>

                    <p>
                        View and track your housing applications.
                    </p>

                </div>

                <a asp-controller="Home"
                   asp-action="HousingSchemes"
                   class="back-home">

                    <i class="bi bi-buildings-fill me-1"></i>

                    Browse Housing Schemes

                </a>

            </div>


            <!-- SUCCESS MESSAGE -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            <!-- APPLICATIONS -->
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="application-card">

                        <!-- HEADER -->

                        <div class="application-card-header">

                            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">

                                <div>

                                    <div class="application-id">
                                        Application #@item.ApplicationId
                                    </div>

                                    <div class="scheme-name mt-1">

                                        @(item.Property?.Scheme?.SchemeName
                                            ?? "Housing Scheme")

                                    </div>

                                    <div class="scheme-location">

                                        <i class="bi bi-geo-alt-fill me-1"></i>

                                        @(item.Property?.Scheme?.Location
                                            ?? item.Property?.Scheme?.City
                                            ?? "Location not specified")

                                    </div>

                                </div>


                                <!-- STATUS -->

                                <div>

                                    @if (string.Equals(
                                        item.Status,
                                        "Approved",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge status-approved">

                                            <i class="bi bi-check-circle-fill me-1"></i>

                                            Approved

                                        </span>
                                    }
                                    else if (string.Equals(
                                        item.Status,
                                        "Rejected",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge status-rejected">

                                            <i class="bi bi-x-circle-fill me-1"></i>

                                            Rejected

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">

                                            <i class="bi bi-hourglass-split me-1"></i>

                                            @(string.IsNullOrWhiteSpace(item.Status)
                                                ? "Pending"
                                                : item.Status)

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- BODY -->

                        <div class="application-card-body">

                            <div class="info-grid">

                                <div class="info-box">

                                    <span class="info-label">
                                        Property
                                    </span>

                                    <span class="info-value">
                                        @(item.Property?.UnitNumber ?? "-")
                                    </span>

                                </div>


                                <div class="info-box">

                                    <span class="info-label">
                                        Property Type
                                    </span>

                                    <span class="info-value">
                                        @(item.Property?.PropertyType ?? "-")
                                    </span>

                                </div>


                                <div class="info-box">

                                    <span class="info-label">
                                        Application Date
                                    </span>

                                    <span class="info-value">
                                        @item.ApplicationDate.ToString("dd MMM yyyy")
                                    </span>

                                </div>


                                <div class="info-box">

                                    <span class="info-label">
                                        Property Price
                                    </span>

                                    <span class="info-value">

                                        @if (item.Property?.Price.HasValue == true)
                                        {
                                            @:₹@item.Property.Price.Value.ToString("N2")
                                        }
                                        else
                                        {
                                            @:-
                                        }

                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- FOOTER -->

                        <div class="card-footer-custom">

                            <a asp-controller="Applications"
                               asp-action="MyApplicationDetails"
                               asp-route-applicationId="@item.ApplicationId"
                               class="view-btn">

                                <i class="bi bi-eye-fill me-1"></i>

                                View Full Details

                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-state">

                    <i class="bi bi-file-earmark-x"></i>

                    <h3>
                        No Applications Found
                    </h3>

                    <p class="text-muted">
                        You have not submitted any housing applications yet.
                    </p>

                    <a asp-controller="Home"
                       asp-action="HousingSchemes"
                       class="browse-btn">

                        <i class="bi bi-buildings-fill me-1"></i>

                        Explore Housing Schemes

                    </a>

                </div>
            }

        </div>

    </div>

</body>

</html>