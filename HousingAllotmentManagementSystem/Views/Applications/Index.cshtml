
@model IEnumerable<HousingAllotmentManagementSystem.Models.Application>

@{
    ViewData["Title"] = "Applications";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- PAGE HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-file-earmark-text text-primary me-2"></i>
            Applications
        </h2>

        <p class="text-muted mb-0">
            Manage housing applications.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill me-1"></i>
        New Application
    </a>

</div>


<!-- SUCCESS MESSAGE -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- ERROR MESSAGE -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- STATISTICS -->
<div class="row g-4 mb-4">

    <!-- TOTAL -->
    <div class="col-md-4">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="text-muted small">
                            Total Applications
                        </div>

                        <h3 class="fw-bold mb-0">
                            @Model.Count()
                        </h3>

                    </div>

                    <div class="bg-primary-subtle text-primary rounded-circle p-3">

                        <i class="bi bi-file-earmark-text fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PENDING -->
    <div class="col-md-4">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="text-muted small">
                            Pending Applications
                        </div>

                        <h3 class="fw-bold mb-0">

                            @Model.Count(a =>
                                !string.IsNullOrEmpty(a.Status) &&
                                a.Status.Equals(
                                    "Pending",
                                    StringComparison.OrdinalIgnoreCase))

                        </h3>

                    </div>

                    <div class="bg-warning-subtle text-warning rounded-circle p-3">

                        <i class="bi bi-hourglass-split fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- APPROVED -->
    <div class="col-md-4">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="text-muted small">
                            Approved Applications
                        </div>

                        <h3 class="fw-bold mb-0">

                            @Model.Count(a =>
                                !string.IsNullOrEmpty(a.Status) &&
                                a.Status.Equals(
                                    "Approved",
                                    StringComparison.OrdinalIgnoreCase))

                        </h3>

                    </div>

                    <div class="bg-success-subtle text-success rounded-circle p-3">

                        <i class="bi bi-check-circle fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- APPLICATION TABLE -->
<div class="card border-0 shadow-sm">

    <!-- CARD HEADER -->
    <div class="card-header bg-white py-3">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h5 class="fw-bold mb-1">
                    Application Records
                </h5>

                <small class="text-muted">
                    All housing applications
                </small>

            </div>

            <span class="badge bg-primary px-3 py-2">
                @Model.Count() Records
            </span>

        </div>

    </div>


    <!-- CARD BODY -->
    <div class="card-body p-0">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                ID
                            </th>

                            <th>
                                Applicant
                            </th>

                            <th>
                                Property
                            </th>

                            <th>
                                Employment
                            </th>

                            <th>
                                Annual Income
                            </th>

                            <th>
                                Application Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td class="ps-4">

                                    <span class="fw-semibold">
                                        #@item.ApplicationId
                                    </span>

                                </td>


                                <!-- APPLICANT -->
                                <td>

                                    @if (item.User != null)
                                    {
                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary-subtle text-primary rounded-circle p-2 me-2">

                                                <i class="bi bi-person-fill"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    @item.User.FullName
                                                </div>

                                                <small class="text-muted">
                                                    User #@item.UserId
                                                </small>

                                            </div>

                                        </div>
                                    }
                                    else
                                    {
                                        <div>

                                            <span class="text-danger fw-semibold">
                                                User not found
                                            </span>

                                            <div class="small text-muted">
                                                User ID: @item.UserId
                                            </div>

                                        </div>
                                    }

                                </td>


                                <!-- PROPERTY -->
                                <td>

                                    @if (item.Property != null)
                                    {
                                        <div>

                                            <span class="badge bg-light text-dark border">

                                                <i class="bi bi-house me-1"></i>

                                                @(item.Property.UnitNumber ?? "Property")

                                            </span>

                                            <div class="small text-muted mt-1">

                                                Property #@item.PropertyId

                                            </div>

                                            @if (item.Property.Scheme != null)
                                            {
                                                <div class="small text-muted">

                                                    @item.Property.Scheme.SchemeName

                                                </div>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <div>

                                            <span class="text-danger fw-semibold">
                                                Property not found
                                            </span>

                                            <div class="small text-muted">
                                                Property ID: @item.PropertyId
                                            </div>

                                        </div>
                                    }

                                </td>


                                <!-- EMPLOYMENT -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.EmploymentType))
                                    {
                                        <span>
                                            @item.EmploymentType
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ANNUAL INCOME -->
                                <td>

                                    @if (item.AnnualIncome.HasValue)
                                    {
                                        <span class="fw-semibold">

                                            ₹@item.AnnualIncome.Value.ToString("N2")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- APPLICATION DATE -->
                                <td>

                                    @item.ApplicationDate.ToString("dd MMM yyyy")

                                    <div class="small text-muted">

                                        @item.ApplicationDate.ToString("hh:mm tt")

                                    </div>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (!string.IsNullOrEmpty(item.Status) &&
                                        item.Status.Equals(
                                            "Approved",
                                            StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle-fill me-1"></i>

                                            Approved

                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(item.Status) &&
                                             item.Status.Equals(
                                                 "Rejected",
                                                 StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-x-circle-fill me-1"></i>

                                            Rejected

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="bi bi-hourglass-split me-1"></i>

                                            @(string.IsNullOrWhiteSpace(item.Status)
                                                ? "Pending"
                                                : item.Status)

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td class="text-center">

                                    <div class="btn-group">

                                        <!-- DETAILS -->
                                        <a asp-action="Details"
                                           asp-route-applicationid="@item.ApplicationId"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- EDIT -->
                                        <a asp-action="Edit"
                                           asp-route-applicationid="@item.ApplicationId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- DELETE -->
                                        <a asp-action="Delete"
                                           asp-route-applicationid="@item.ApplicationId"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- EMPTY STATE -->

            <div class="text-center py-5">

                <i class="bi bi-file-earmark-x display-4 text-muted"></i>

                <h5 class="fw-bold mt-3">
                    No Applications Found
                </h5>

                <p class="text-muted">
                    There are currently no housing applications.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle me-1"></i>

                    Create First Application

                </a>

            </div>
        }

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}