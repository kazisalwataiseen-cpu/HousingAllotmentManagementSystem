@model HousingAllotmentManagementSystem.Models.Application

@{
    ViewData["Title"] = "Application Submitted";
    Layout = null;

    bool emailSent =
        ViewBag.EmailSent == true;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Application Submitted - Housing Allotment System
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                background: #f5f7fb;
                font-family: Arial, Helvetica, sans-serif;
                color: #263238;
            }

            .success-page {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 30px 15px;
            }

            .success-card {
                width: 100%;
                max-width: 800px;
                background: #ffffff;
                border-radius: 22px;
                box-shadow: 0 12px 40px rgba(0, 0, 0, 0.10);
                overflow: hidden;
            }

            .success-header {
                background: linear-gradient(
                    135deg,
                    #16a34a,
                    #15803d
                );
                color: white;
                text-align: center;
                padding: 40px 25px;
            }

            .success-icon {
                width: 90px;
                height: 90px;
                margin: 0 auto 20px;
                background: rgba(255,255,255,0.18);
                border: 3px solid rgba(255,255,255,0.75);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 42px;
            }

            .success-header h1 {
                font-size: 32px;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .success-header p {
                margin: 0;
                opacity: 0.9;
                font-size: 16px;
            }

            .success-body {
                padding: 35px;
            }

            .greeting {
                font-size: 18px;
                color: #334155;
                margin-bottom: 8px;
            }

            .success-message {
                color: #64748b;
                line-height: 1.7;
            }

            .details-title {
                font-size: 20px;
                font-weight: 700;
                color: #1f2937;
                margin: 30px 0 18px;
            }

            .info-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 15px;
            }

            .info-box {
                background: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                padding: 16px;
            }

            .info-label {
                display: block;
                color: #64748b;
                font-size: 13px;
                margin-bottom: 5px;
            }

            .info-value {
                display: block;
                color: #1f2937;
                font-size: 16px;
                font-weight: 700;
            }

            .email-success {
                margin-top: 25px;
                background: #ecfdf5;
                border: 1px solid #bbf7d0;
                color: #166534;
                border-radius: 12px;
                padding: 15px 18px;
            }

            .email-failed {
                margin-top: 25px;
                background: #fff7ed;
                border: 1px solid #fed7aa;
                color: #9a3412;
                border-radius: 12px;
                padding: 15px 18px;
            }

            .action-area {
                display: flex;
                justify-content: center;
                gap: 12px;
                flex-wrap: wrap;
                margin-top: 30px;
            }

            .btn-primary-custom {
                background: #2563eb;
                color: white;
                text-decoration: none;
                padding: 12px 22px;
                border-radius: 9px;
                font-weight: 600;
            }

            .btn-primary-custom:hover {
                background: #1d4ed8;
                color: white;
            }

            .btn-secondary-custom {
                background: #e2e8f0;
                color: #334155;
                text-decoration: none;
                padding: 12px 22px;
                border-radius: 9px;
                font-weight: 600;
            }

            .btn-secondary-custom:hover {
                background: #cbd5e1;
                color: #334155;
            }

            @@media (max-width: 575px) {

                .success-body {
                    padding: 25px 20px;
                }

                .success-header {
                    padding: 35px 20px;
                }

                .success-header h1 {
                    font-size: 27px;
                }

                .info-grid {
                    grid-template-columns: 1fr;
                }
            }

    </style>

</head>

<body>

    <div class="success-page">

        <div class="success-card">

            <!-- =====================================================
             SUCCESS HEADER
        ====================================================== -->

            <div class="success-header">

                <div class="success-icon">

                    <i class="bi bi-check-lg"></i>

                </div>

                <h1>
                    Application Submitted Successfully!
                </h1>

                <p>
                    Your housing application has been received.
                </p>

            </div>


            <!-- =====================================================
             BODY
        ====================================================== -->

            <div class="success-body">

                <p class="greeting">

                    Dear
                    <strong>
                        @(Model.User?.FullName ?? "Applicant")
                    </strong>,

                </p>

                <p class="success-message">

                    Your application has been successfully submitted
                    and is currently under review.

                </p>


                <!-- =================================================
                 APPLICATION DETAILS
            ================================================== -->

                <h4 class="details-title">

                    <i class="bi bi-file-earmark-check-fill text-primary me-2"></i>

                    Application Details

                </h4>


                <div class="info-grid">

                    <!-- APPLICATION ID -->

                    <div class="info-box">

                        <span class="info-label">
                            Application ID
                        </span>

                        <span class="info-value">
                            #@Model.ApplicationId
                        </span>

                    </div>


                    <!-- STATUS -->

                    <div class="info-box">

                        <span class="info-label">
                            Application Status
                        </span>

                        <span class="info-value text-warning">
                            @Model.Status
                        </span>

                    </div>


                    <!-- SCHEME -->

                    <div class="info-box">

                        <span class="info-label">
                            Housing Scheme
                        </span>

                        <span class="info-value">

                            @(Model.Property?.Scheme?.SchemeName
                                ?? "-")

                        </span>

                    </div>


                    <!-- PROPERTY -->

                    <div class="info-box">

                        <span class="info-label">
                            Property / Unit
                        </span>

                        <span class="info-value">

                            @(Model.Property?.UnitNumber
                                ?? "-")

                        </span>

                    </div>


                    <!-- PROPERTY TYPE -->

                    <div class="info-box">

                        <span class="info-label">
                            Property Type
                        </span>

                        <span class="info-value">

                            @(Model.Property?.PropertyType
                                ?? "-")

                        </span>

                    </div>


                    <!-- APPLICATION DATE -->

                    <div class="info-box">

                        <span class="info-label">
                            Application Date
                        </span>

                        <span class="info-value">

                            @Model.ApplicationDate.ToString(
                                "dd MMM yyyy hh:mm tt")

                        </span>

                    </div>

                </div>


                <!-- =================================================
                 EMAIL STATUS
            ================================================== -->
                @if (emailSent)
                {
                    <div class="email-success">

                        <i class="bi bi-envelope-check-fill me-2"></i>

                        <strong>
                            Confirmation email sent.
                        </strong>

                        A confirmation email has been sent to:

                        <strong>
                            @(Model.User?.Email ?? "your registered email")
                        </strong>

                    </div>
                }
                else
                {
                    <div class="email-failed">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        <strong>
                            Application saved successfully.
                        </strong>

                        However, the confirmation email could not be
                        sent at this time.

                    </div>
                }


                <!-- =================================================
                 ACTIONS
            ================================================== -->

                <div class="action-area">

                    <a asp-controller="Applications"
                       asp-action="MyApplications"
                       class="btn-primary-custom">

                        <i class="bi bi-file-earmark-text-fill me-1"></i>

                        My Applications

                    </a>


                    <a asp-controller="Home"
                       asp-action="HousingSchemes"
                       class="btn-secondary-custom">

                        <i class="bi bi-buildings-fill me-1"></i>

                        Browse Housing Schemes

                    </a>

                </div>

            </div>

        </div>

    </div>

</body>

</html>