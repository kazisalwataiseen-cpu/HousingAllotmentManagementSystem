@model HousingAllotmentManagementSystem.Models.Application

@{
    ViewData["Title"] = "Application Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-file-earmark-text-fill text-primary"></i>
                Application Details
            </h2>

            <p class="text-muted mb-0">
                View complete application information.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i>
            Back to List
        </a>

    </div>

    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white py-3">

            <h4 class="mb-0">
                <i class="bi bi-info-circle-fill"></i>
                Application Information
            </h4>

        </div>

        <div class="card-body p-4">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Applicant</label>
                    <div class="form-control bg-light">
                        @Model.User.FullName
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Property</label>
                    <div class="form-control bg-light">
                        @Model.Property.UnitNumber
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Application Date</label>
                    <div class="form-control bg-light">
                        @Model.ApplicationDate.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Employment Type</label>
                    <div class="form-control bg-light">
                        @Model.EmploymentType
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Annual Income</label>
                    <div class="form-control bg-light">
                        ₹ @Model.AnnualIncome?.ToString("N2")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Status</label>

                    <div>

                        @if (Model.Status == "Approved")
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@Model.Status</span>
                        }

                    </div>

                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Nominee Name</label>
                    <div class="form-control bg-light">
                        @Model.NomineeName
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Nominee Relation</label>
                    <div class="form-control bg-light">
                        @Model.NomineeRelation
                    </div>
                </div>

                <div class="col-md-12 mb-3">
                    <label class="fw-bold">Remarks</label>

                    <div class="form-control bg-light" style="min-height:120px;">
                        @Model.Remarks
                    </div>

                </div>

            </div>

            <hr />

            <div class="text-end">

                <a asp-action="Edit"
                   asp-route-applicationid="@Model.ApplicationId"
                   class="btn btn-warning">

                    <i class="bi bi-pencil-square"></i>
                    Edit

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left-circle"></i>
                    Back

                </a>

            </div>

        </div>

    </div>

</div>