@model HousingAllotmentManagementSystem.Models.Application

@{
    ViewData["Title"] = "Delete Application";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-danger">
                <i class="bi bi-trash-fill"></i>
                Delete Application
            </h2>

            <p class="text-muted mb-0">
                Confirm before deleting this application.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i>
            Back to List
        </a>

    </div>

    <div class="card shadow-lg border-0">

        <div class="card-header bg-danger text-white py-3">

            <h4 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Delete Confirmation
            </h4>

        </div>

        <div class="card-body p-4">

            <div class="alert alert-danger">

                <h5 class="mb-1">
                    Are you sure you want to delete this application?
                </h5>

                <small>
                    This action cannot be undone.
                </small>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Applicant</label>
                    <div class="form-control bg-light">
                        @Model.User.FullName
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Property</label>
                    <div class="form-control bg-light">
                        @Model.Property.UnitNumber
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Application Date</label>
                    <div class="form-control bg-light">
                        @Model.ApplicationDate.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Status</label>

                    <div>

                        @if (Model.Status == "Approved")
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@Model.Status</span>
                        }

                    </div>

                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Employment Type</label>
                    <div class="form-control bg-light">
                        @Model.EmploymentType
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Annual Income</label>
                    <div class="form-control bg-light">
                        ₹ @Model.AnnualIncome?.ToString("N2")
                    </div>
                </div>

                <div class="col-md-12 mb-3">
                    <label class="fw-bold">Remarks</label>

                    <div class="form-control bg-light" style="min-height:100px;">
                        @Model.Remarks
                    </div>

                </div>

            </div>

            <hr />

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="ApplicationId" />

                <div class="text-end">

                    <a asp-action="Index"
                       class="btn btn-secondary me-2">

                        <i class="bi bi-x-circle"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash-fill"></i>
                        Delete Application

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>