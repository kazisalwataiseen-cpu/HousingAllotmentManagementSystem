
@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
}

<style>

    /* =========================================================
       SIDEBAR
       ========================================================= */

    .sidebar {
        width: 270px;
        min-height: 100vh;
        position: sticky;
        top: 0;

        display: flex;
        flex-direction: column;

        background: linear-gradient(
            180deg,
            #f4f1ff 0%,
            #eef4ff 50%,
            #f8f3ff 100%
        );

        border-right: 1px solid rgba(120, 110, 170, 0.12);

        box-shadow:
            8px 0 30px rgba(80, 70, 120, 0.08);

        z-index: 1000;
    }


    /* =========================================================
       LOGO / BRAND
       ========================================================= */

    .sidebar .logo {
        padding: 28px 20px 24px !important;

        background: rgba(255, 255, 255, 0.45);

        border-bottom: 1px solid rgba(120, 110, 170, 0.10);
    }

    .logo-icon {
        width: 62px;
        height: 62px;

        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        background: linear-gradient(
            135deg,
            #dcd4ff,
            #cfe0ff
        );

        color: #7062b8;

        font-size: 27px;

        box-shadow:
            0 8px 20px rgba(112, 98, 184, 0.15);

        transition: all 0.3s ease;
    }

    .logo:hover .logo-icon {
        transform: translateY(-3px) rotate(-3deg);

        box-shadow:
            0 12px 25px rgba(112, 98, 184, 0.20);
    }

    .logo h4 {
        color: #3f4354;
        font-weight: 750;
        font-size: 18px;
        letter-spacing: 0.2px;
    }

    .logo small {
        color: #9498aa;
        font-size: 11px;
        letter-spacing: 0.3px;
    }


    /* =========================================================
       NAVIGATION
       ========================================================= */

    .sidebar > .nav {
        padding: 10px 13px 20px;

        overflow-y: auto;

        flex: 1;
    }

    .sidebar .nav::-webkit-scrollbar {
        width: 5px;
    }

    .sidebar .nav::-webkit-scrollbar-track {
        background: transparent;
    }

    .sidebar .nav::-webkit-scrollbar-thumb {
        background: #d7d2ea;
        border-radius: 20px;
    }


    /* =========================================================
       MENU TITLE
       ========================================================= */

    .menu-title {
        padding: 18px 13px 8px;

        color: #a09bb3;

        font-size: 10px;

        font-weight: 750;

        text-transform: uppercase;

        letter-spacing: 1.2px;
    }


    /* =========================================================
       NAV ITEM
       ========================================================= */

    .sidebar .nav-item {
        margin-bottom: 4px;
    }


    /* =========================================================
       NAV LINK
       ========================================================= */

    .sidebar .nav-link {
        position: relative;

        display: flex;
        align-items: center;

        gap: 13px;

        min-height: 46px;

        padding: 10px 14px;

        margin: 2px 0;

        border-radius: 14px;

        color: #686d80;

        font-size: 13.5px;

        font-weight: 600;

        text-decoration: none;

        transition:
            background 0.25s ease,
            color 0.25s ease,
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }


    /* =========================================================
       ICON
       ========================================================= */

    .sidebar .nav-link i {
        width: 22px;

        text-align: center;

        font-size: 17px;

        color: #888da1;

        transition:
            color 0.25s ease,
            transform 0.25s ease;
    }


    /* =========================================================
       HOVER
       ========================================================= */

    .sidebar .nav-link:hover {

        background: rgba(255, 255, 255, 0.75);

        color: #5c5a7b;

        transform: translateX(3px);

        box-shadow:
            0 5px 15px rgba(80, 70, 120, 0.06);
    }

    .sidebar .nav-link:hover i {
        color: #7769bd;

        transform: scale(1.08);
    }


    /* =========================================================
       ACTIVE MENU
       ========================================================= */

    .sidebar .nav-link.active {

        color: #6559a8;

        background: linear-gradient(
            135deg,
            #e4ddff,
            #dce9ff
        );

        box-shadow:
            0 7px 18px rgba(105, 91, 170, 0.12);
    }

    .sidebar .nav-link.active i {
        color: #6e5db4;
    }

    .sidebar .nav-link.active::before {

        content: "";

        position: absolute;

        left: 0;

        top: 9px;

        bottom: 9px;

        width: 4px;

        border-radius: 0 8px 8px 0;

        background: #7b6ac5;
    }


    /* =========================================================
       ACTIVE ICON BACKGROUND
       ========================================================= */

    .sidebar .nav-link.active i {

        width: 30px;
        height: 30px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 9px;

        background: rgba(255, 255, 255, 0.55);
    }


    /* =========================================================
       SIDEBAR FOOTER
       ========================================================= */

    .sidebar-footer {

        margin-top: auto;

        padding: 18px 15px !important;

        background: rgba(255, 255, 255, 0.40);

        border-top: 1px solid rgba(120, 110, 170, 0.10);
    }


    /* =========================================================
       ADMIN PROFILE
       ========================================================= */

    .sidebar-footer img {

        object-fit: cover;

        border: 3px solid rgba(255, 255, 255, 0.9) !important;

        box-shadow:
            0 6px 18px rgba(70, 65, 110, 0.15) !important;
    }

    .sidebar-footer strong {

        color: #55596d !important;

        font-size: 13px;

        font-weight: 700;
    }

    .sidebar-footer small {

        color: #989bae !important;

        font-size: 10px;
    }


    /* =========================================================
       LOGOUT
       ========================================================= */

    .sidebar .logout-link {

        justify-content: center;

        background: rgba(255, 235, 239, 0.75);

        color: #c9798a !important;

        border: 1px solid rgba(220, 150, 165, 0.15);

        font-weight: 650;

        margin-top: 12px;
    }

    .sidebar .logout-link i {

        color: #c9798a !important;
    }

    .sidebar .logout-link:hover {

        background: #fbe1e6;

        color: #b95f73 !important;

        transform: translateY(-2px);

        box-shadow:
            0 7px 18px rgba(190, 100, 120, 0.10);
    }

    .sidebar .logout-link:hover i {

        color: #b95f73 !important;

        transform: translateX(2px);
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 992px) {

        .sidebar {
            width: 230px;
        }

        .sidebar .nav-link {
            font-size: 13px;
            padding: 9px 11px;
        }

        .logo h4 {
            font-size: 16px;
        }

    }


    @@media (max-width: 768px) {

        .sidebar {
            width: 220px;
        }

    }

</style>


<div class="sidebar">

    <!-- ===================================================== -->
    <!-- LOGO -->
    <!-- ===================================================== -->

    <div class="logo text-center">

        <div class="logo-icon mb-3">
            <i class="bi bi-buildings-fill"></i>
        </div>

        <h4 class="mb-1">
            Housing Admin
        </h4>

        <small>
            Management System
        </small>

    </div>


    <!-- ===================================================== -->
    <!-- NAVIGATION -->
    <!-- ===================================================== -->

    <ul class="nav flex-column mt-2">


        <!-- ================================================= -->
        <!-- DASHBOARD -->
        <!-- ================================================= -->

        <li class="nav-item">

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="nav-link @(currentController == "Dashboard" ? "active" : "")">

                <i class="bi bi-speedometer2"></i>

                <span>
                    Dashboard
                </span>

            </a>

        </li>


        <!-- ================================================= -->
        <!-- ADMINISTRATION -->
        <!-- ================================================= -->

        <li class="menu-title">
            Administration
        </li>


        <!-- ROLES -->

        <li class="nav-item">

            <a asp-controller="Roles"
               asp-action="Index"
               class="nav-link @(currentController == "Roles" ? "active" : "")">

                <i class="bi bi-person-badge-fill"></i>

                <span>
                    Roles
                </span>

            </a>

        </li>


        <!-- USERS -->

        <li class="nav-item">

            <a asp-controller="Users"
               asp-action="Index"
               class="nav-link @(currentController == "Users" ? "active" : "")">

                <i class="bi bi-people-fill"></i>

                <span>
                    Users
                </span>

            </a>

        </li>


        <!-- ================================================= -->
        <!-- HOUSING -->
        <!-- ================================================= -->

        <li class="menu-title">
            Housing
        </li>


        <!-- HOUSING SCHEMES -->

        <li class="nav-item">

            <a asp-controller="HousingSchemes"
               asp-action="Index"
               class="nav-link @(currentController == "HousingSchemes" ? "active" : "")">

                <i class="bi bi-buildings-fill"></i>

                <span>
                    Housing Schemes
                </span>

            </a>

        </li>


        <!-- EMI PLAN OPTIONS -->

        <li class="nav-item">

            <a asp-controller="EMIPlanOptions"
               asp-action="Index"
               class="nav-link @(currentController == "EMIPlanOptions" ? "active" : "")">

                <i class="bi bi-credit-card-fill"></i>

                <span>
                    EMI Plan Options
                </span>

            </a>

        </li>


        <!-- PROPERTIES -->

        <li class="nav-item">

            <a asp-controller="Properties"
               asp-action="Index"
               class="nav-link @(currentController == "Properties" ? "active" : "")">

                <i class="bi bi-house-door-fill"></i>

                <span>
                    Properties
                </span>

            </a>

        </li>


        <!-- AMENITIES -->

        <li class="nav-item">

            <a asp-controller="Amenities"
               asp-action="Index"
               class="nav-link @(currentController == "Amenities" ? "active" : "")">

                <i class="bi bi-stars"></i>

                <span>
                    Amenities
                </span>

            </a>

        </li>


        <!-- ================================================= -->
        <!-- TRANSACTIONS -->
        <!-- ================================================= -->

        <li class="menu-title">
            Transactions
        </li>


        <!-- APPLICATIONS -->

        <li class="nav-item">

            <a asp-controller="Applications"
               asp-action="Index"
               class="nav-link @(currentController == "Applications" ? "active" : "")">

                <i class="bi bi-file-earmark-text-fill"></i>

                <span>
                    Applications
                </span>

            </a>

        </li>


        <!-- ALLOTMENTS -->

        <li class="nav-item">

            <a asp-controller="Allotments"
               asp-action="Index"
               class="nav-link @(currentController == "Allotments" ? "active" : "")">

                <i class="bi bi-house-check"></i>

                <span>
                    Allotments
                </span>

            </a>

        </li>


        <!-- LOAN APPLICATIONS -->

        <li class="nav-item">

            <a asp-controller="LoanApplications"
               asp-action="Index"
               class="nav-link @(currentController == "LoanApplications" ? "active" : "")">

                <i class="bi bi-file-earmark-text"></i>

                <span>
                    Loan Applications
                </span>

            </a>

        </li>


        <!-- LOANS -->

        <li class="nav-item">

            <a asp-controller="Loans"
               asp-action="Index"
               class="nav-link @(currentController == "Loans" ? "active" : "")">

                <i class="bi bi-bank2"></i>

                <span>
                    Loans
                </span>

            </a>

        </li>


        <!-- ================================================= -->
        <!-- EMI PLANS -->
        <!-- ================================================= -->

        <li class="nav-item">

            <a asp-controller="Emiplans"
               asp-action="Index"
               class="nav-link @(currentController == "Emiplans" ? "active" : "")">

                <i class="bi bi-calendar2-check-fill"></i>

                <span>
                    EMI Plans
                </span>

            </a>

        </li>


        <!-- ================================================= -->
        <!-- INSTALLMENTS -->
        <!-- ================================================= -->

        <li class="nav-item">

            <a asp-controller="Installments"
               asp-action="Index"
               class="nav-link @(currentController == "Installments" ? "active" : "")">

                <i class="bi bi-calendar-check-fill"></i>

                <span>
                    Installments
                </span>

            </a>

        </li>


        <!-- ================================================= -->
        <!-- PAYMENTS -->
        <!-- ================================================= -->

        <li class="nav-item">

            <a asp-controller="Payments"
               asp-action="Index"
               class="nav-link @(currentController == "Payments" ? "active" : "")">

                <i class="bi bi-credit-card-2-front-fill"></i>

                <span>
                    Payments
                </span>

            </a>

        </li>


    </ul>


    <!-- ===================================================== -->
    <!-- SIDEBAR FOOTER -->
    <!-- ===================================================== -->

    <div class="sidebar-footer">

        <div class="text-center">

            <img src="https://ui-avatars.com/api/?name=Admin&background=8b7bc8&color=fff"
                 width="55"
                 height="55"
                 class="rounded-circle shadow"
                 alt="Administrator" />

            <div class="mt-2">

                <strong class="d-block">
                    Administrator
                </strong>

                <small class="d-block">
                    System Administrator
                </small>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- LOGOUT -->
        <!-- ================================================= -->

        <a asp-controller="Account"
           asp-action="Logout"
           class="nav-link logout-link">

            <i class="bi bi-box-arrow-right"></i>

            <span>
                Logout
            </span>

        </a>

    </div>

</div>

