    <!-- ========================================= -->

    <div class="logo text-center py-4">

        <div class="logo-icon mb-3">
            <i class="bi bi-buildings-fill"></i>
        </div>

        <h4 class="mb-1">
            Housing Admin
        </h4>

        <small>
            Management System
        </small>

    </div>


    <!-- ========================================= -->
