    <ul class="nav flex-column mt-3">


        <!-- ========================================= -->
        <!-- DASHBOARD -->
        <!-- ========================================= -->

        <li class="nav-item">

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">

                <i class="bi bi-speedometer2"></i>

                <span>
                    Dashboard
                </span>

            </a>

        </li>


        <!-- ========================================= -->
        <!-- ADMINISTRATION -->
        <!-- ========================================= -->

        <li class="menu-title">
            Administration
        </li>


        <!-- ROLES -->

        <li class="nav-item">

            <a asp-controller="Roles"
               asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Roles" ? "active" : "")">

                <i class="bi bi-person-badge-fill"></i>

                <span>
                    Roles
                </span>

            </a>

        </li>


        <!-- USERS -->

        <li class="nav-item">

            <a asp-controller="Users"
               asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")">

                <i class="bi bi-people-fill"></i>

                <span>
                    Users
                </span>

            </a>

        </li>


