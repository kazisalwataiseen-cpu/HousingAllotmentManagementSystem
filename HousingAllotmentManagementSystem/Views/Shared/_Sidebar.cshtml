        <!-- IMPORTANT:
             Dashboard uses HousingSchemesController/Index
        -->

        <li class="nav-item">

            <a asp-controller="HousingSchemes"
               asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "HousingSchemes" ? "active" : "")">

                <i class="bi bi-buildings-fill"></i>

                <span>
                    Housing Schemes
                </span>

            </a>

        </li>


