@model IEnumerable<HousingAllotmentManagementSystem.Models.Payment>

@{
    ViewData["Title"] = "My Payments";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var payableInstallments =
        ViewBag.PayableInstallments as
        IEnumerable<HousingAllotmentManagementSystem.Models.Installment>
        ?? Enumerable.Empty<HousingAllotmentManagementSystem.Models.Installment>();
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-credit-card me-2"></i>
                My Payments
            </h2>

            <p class="text-muted mb-0">
                View your payment history and pay your pending installments.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Home

        </a>

    </div>


    <!-- ===================================================== -->
    <!-- PAYABLE INSTALLMENTS -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0">
                <i class="bi bi-wallet2 me-2"></i>
                Pending Installments
            </h5>

        </div>

        <div class="card-body p-0">

            @if (payableInstallments.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>EMI No.</th>
                                <th>Loan Number</th>
                                <th>Due Date</th>
                                <th>Installment</th>
                                <th>Late Fee</th>
                                <th>Total Payable</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var installment in payableInstallments)
                            {
                                decimal totalPayable =
                                    installment.InstallmentAmount +
                                    installment.LateFee;

                                <tr>

                                    <td class="fw-semibold">
                                        #@installment.InstallmentNumber
                                    </td>

                                    <td>
                                        @(installment.Emiplan?.Loan?.LoanNumber ?? "N/A")
                                    </td>

                                    <td>
                                        @installment.DueDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        ₹@installment.InstallmentAmount.ToString("N2")
                                    </td>

                                    <td>
                                        ₹@installment.LateFee.ToString("N2")
                                    </td>

                                    <td class="fw-bold text-primary">
                                        ₹@totalPayable.ToString("N2")
                                    </td>

                                    <td>

                                        @if (installment.PaymentStatus == "Overdue")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-exclamation-circle me-1"></i>
                                                Overdue
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock me-1"></i>
                                                Pending
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="ClientPayment"
                                           asp-action="Pay"
                                           asp-route-id="@installment.InstallmentId"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-credit-card me-1"></i>
                                            Pay Now

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-check-circle display-4 text-success"></i>

                    <h5 class="mt-3">
                        No Pending Payments
                    </h5>

                    <p class="text-muted mb-0">
                        You don't have any installments waiting for payment.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- PAYMENT HISTORY -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-dark text-white py-3">

            <h5 class="mb-0">
                <i class="bi bi-clock-history me-2"></i>
                Payment History
            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Receipt No.</th>
                                <th>Transaction ID</th>
                                <th>Payment Date</th>
                                <th>Payment Type</th>
                                <th>EMI No.</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Status</th>
                                <th>Remarks</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var payment in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @(payment.ReceiptNumber ?? $"REC-{payment.PaymentId}")
                                    </td>

                                    <td>
                                        <small class="text-muted">@(payment.TransactionId ?? "N/A")</small>
                                    </td>

                                    <td>
                                        @payment.PaymentDate.ToString("dd-MM-yyyy HH:mm")
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @payment.PaymentType
                                        </span>
                                    </td>

                                    <td class="fw-semibold text-primary">
                                        @(payment.Installment != null ? $"EMI #{payment.Installment.InstallmentNumber}" : "-")
                                    </td>

                                    <td class="fw-bold text-success">
                                        ₹@payment.Amount.ToString("N2")
                                    </td>

                                    <td>
                                        @payment.PaymentMethod
                                    </td>

                                    <td>

                                        @if (payment.PaymentStatus == "Completed" || payment.PaymentStatus == "Success")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                @payment.PaymentStatus
                                            </span>
                                        }
                                        else if (payment.PaymentStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock me-1"></i>
                                                Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                @payment.PaymentStatus
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        <small class="text-muted">@(string.IsNullOrEmpty(payment.Remarks) ? "-" : payment.Remarks)</small>
                                    </td>

                                    <td>

                                        <a asp-controller="ClientPayment"
                                           asp-action="Details"
                                           asp-route-id="@payment.PaymentId"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-receipt display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No Payment History
                    </h5>

                    <p class="text-muted mb-0">
                        Your completed payments will appear here.
                    </p>

                </div>
            }

        </div>

    </div>

</div>