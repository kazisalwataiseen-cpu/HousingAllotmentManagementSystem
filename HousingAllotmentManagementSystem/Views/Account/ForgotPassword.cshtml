@model HousingAllotmentManagementSystem.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Forgot Password - Housing Allotment System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #eff6ff, #f8fafc);
            font-family: Arial, Helvetica, sans-serif;
        }

        .forgot-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .forgot-card {
            width: 100%;
            max-width: 430px;
            background: white;
            border-radius: 18px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.10);
            padding: 38px;
        }

        .forgot-logo {
            width: 75px;
            height: 75px;
            margin: 0 auto 20px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #2563eb;
            color: white;
            font-size: 35px;
        }

        .forgot-title {
            text-align: center;
            font-size: 28px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 8px;
        }

        .forgot-subtitle {
            text-align: center;
            color: #64748b;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .form-label {
            font-weight: 600;
            color: #374151;
        }

        .form-control {
            height: 48px;
            border-radius: 9px;
        }

        .input-group-text {
            background: white;
            border-radius: 9px 0 0 9px;
        }

        .input-group .form-control {
            border-left: none;
        }

        .reset-button {
            width: 100%;
            height: 48px;
            border: none;
            border-radius: 9px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            font-weight: 600;
        }

        .reset-button:hover {
            background: #1d4ed8;
        }

        .back-login {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

        .back-login:hover {
            text-decoration: underline;
        }

        .success-message {
            border-radius: 9px;
            font-size: 14px;
        }

        .validation-summary {
            border-radius: 9px;
        }

    </style>

</head>

<body>

    <div class="forgot-wrapper">

        <div class="forgot-card">

            <!-- LOGO -->

            <div class="forgot-logo">
                <i class="bi bi-key-fill"></i>
            </div>


            <!-- TITLE -->

            <h1 class="forgot-title">
                Forgot Password?
            </h1>

            <p class="forgot-subtitle">
                Enter your registered email address and
                we will send you a link to reset your password.
            </p>


            <!-- SUCCESS MESSAGE -->

            @if (TempData["ForgotPasswordMessage"] != null)
            {
                <div class="alert alert-success success-message">
                    <i class="bi bi-check-circle-fill me-1"></i>

                    @TempData["ForgotPasswordMessage"]
                </div>
            }


            <!-- VALIDATION -->

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger validation-summary">
            </div>


            <!-- FORM -->

            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- EMAIL -->

                <div class="mb-4">

                    <label asp-for="Email"
                           class="form-label">

                        Email Address

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-envelope-fill"></i>
                        </span>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter your registered email"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>

                </div>


                <!-- SEND LINK -->

                <button type="submit"
                        class="reset-button">

                    <i class="bi bi-envelope-arrow-up me-1"></i>

                    Send Reset Link

                </button>


                <!-- BACK TO LOGIN -->

                <a asp-controller="Account"
                   asp-action="Login"
                   class="back-login">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back to Login

                </a>

            </form>

        </div>

    </div>

</body>

</html>