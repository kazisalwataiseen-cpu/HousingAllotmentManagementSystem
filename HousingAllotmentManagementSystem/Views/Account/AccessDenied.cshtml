@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Access Denied</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #f5f7fb;
                font-family: Arial, Helvetica, sans-serif;
            }

            .access-card {
                background: white;
                width: 100%;
                max-width: 500px;
                padding: 45px 35px;
                text-align: center;
                border-radius: 18px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            }

            .access-icon {
                font-size: 70px;
                color: #dc3545;
            }

            .access-card h2 {
                margin-top: 20px;
                font-weight: 700;
                color: #1f2937;
            }

            .access-card p {
                color: #64748b;
                margin-top: 10px;
            }

            .home-btn {
                display: inline-block;
                margin-top: 20px;
                padding: 11px 22px;
                background: #2563eb;
                color: white;
                text-decoration: none;
                border-radius: 9px;
                font-weight: 600;
            }

                .home-btn:hover {
                    background: #1d4ed8;
                    color: white;
                }

    </style>

</head>

<body>

    <div class="access-card">

        <i class="bi bi-shield-lock-fill access-icon"></i>

        <h2>
            Access Denied
        </h2>

        <p>
            You do not have permission to access this page.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="home-btn">

            <i class="bi bi-house-fill me-1"></i>

            Go to Home

        </a>

    </div>

</body>
</html>