@model HousingAllotmentManagementSystem.Models.Amenity

@{
    ViewData["Title"] = "Delete Amenity";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-trash text-danger me-2"></i>
                Delete Amenity
            </h2>

            <p class="text-muted mb-0">
                Review the amenity before permanently deleting it.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Amenities

        </a>

    </div>


    <!-- Delete Card -->
    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card border-0 shadow-sm">

                <!-- Header -->
                <div class="card-header bg-danger text-white py-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">
                            <i class="bi bi-trash fs-5"></i>
                        </div>

                        <div>
                            <h5 class="mb-0">
                                Confirm Deletion
                            </h5>

                            <small class="opacity-75">
                                Amenity ID: #@Model.AmenityId
                            </small>
                        </div>

                    </div>

                </div>


                <!-- Body -->
                <div class="card-body p-4">

                    <!-- Warning -->
                    <div class="alert alert-danger border-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                            <div>

                                <h6 class="fw-bold mb-1">
                                    Are you sure you want to delete this amenity?
                                </h6>

                                <p class="mb-0">
                                    This action cannot be undone. Please review
                                    the information below before continuing.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- Amenity Information -->
                    <div class="border rounded p-4 mt-4">

                        <div class="row g-4">

                            <!-- Amenity ID -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-hash me-1"></i>
                                    Amenity ID
                                </div>

                                <div class="fw-semibold fs-5">
                                    #@Model.AmenityId
                                </div>

                            </div>


                            <!-- Amenity Name -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-tag me-1"></i>
                                    Amenity Name
                                </div>

                                <div class="fw-semibold fs-5">
                                    @Model.AmenityName
                                </div>

                            </div>


                            <!-- Status -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-2">
                                    <i class="bi bi-toggle-on me-1"></i>
                                    Status
                                </div>

                                @if (Model.Status)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2">

                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2">

                                        <i class="bi bi-x-circle-fill me-1"></i>
                                        Inactive

                                    </span>
                                }

                            </div>


                            <!-- Created Date -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    Created Date
                                </div>

                                <div class="fw-semibold">
                                    @Model.CreatedDate.ToString("dd MMM yyyy")
                                </div>

                                <small class="text-muted">
                                    @Model.CreatedDate.ToString("hh:mm tt")
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- Property Warning -->
                    <div class="alert alert-warning border-0 mt-4">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-info-circle-fill fs-5 me-2"></i>

                            <div>

                                <strong>Before deleting:</strong>

                                <p class="mb-0 mt-1">
                                    If this amenity is currently assigned to one
                                    or more properties, the database may prevent
                                    deletion because of the related
                                    PropertyAmenities records.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Footer -->
                <div class="card-footer bg-white border-0 p-4">

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="AmenityId" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>


                            <a asp-action="Details"
                               asp-route-id="@Model.AmenityId"
                               class="btn btn-outline-info px-4">

                                <i class="bi bi-eye me-1"></i>
                                View Details

                            </a>


                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash me-1"></i>
                                Delete Amenity

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>