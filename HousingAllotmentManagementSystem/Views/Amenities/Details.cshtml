@model HousingAllotmentManagementSystem.Models.Amenity

@{
    ViewData["Title"] = "Amenity Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-stars text-primary me-2"></i>
                Amenity Details
            </h2>

            <p class="text-muted mb-0">
                View detailed information about this amenity.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Amenities

        </a>

    </div>


    <!-- Details Card -->
    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card border-0 shadow-sm">

                <!-- Card Header -->
                <div class="card-header bg-primary text-white py-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">

                            <i class="bi bi-star-fill fs-5"></i>

                        </div>

                        <div>

                            <h5 class="mb-0">
                                @Model.AmenityName
                            </h5>

                            <small class="opacity-75">
                                Amenity ID: #@Model.AmenityId
                            </small>

                        </div>

                    </div>

                </div>


                <!-- Card Body -->
                <div class="card-body p-4">

                    <div class="row g-4">

                        <!-- Amenity ID -->
                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-hash me-1"></i>
                                    Amenity ID
                                </div>

                                <div class="fw-semibold fs-5">
                                    #@Model.AmenityId
                                </div>

                            </div>

                        </div>


                        <!-- Amenity Name -->
                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-tag me-1"></i>
                                    Amenity Name
                                </div>

                                <div class="fw-semibold fs-5">
                                    @Model.AmenityName
                                </div>

                            </div>

                        </div>


                        <!-- Status -->
                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small mb-2">
                                    <i class="bi bi-toggle-on me-1"></i>
                                    Status
                                </div>

                                @if (Model.Status)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2 fs-6">

                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 fs-6">

                                        <i class="bi bi-x-circle-fill me-1"></i>
                                        Inactive

                                    </span>
                                }

                            </div>

                        </div>


                        <!-- Created Date -->
                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    Created Date
                                </div>

                                <div class="fw-semibold fs-5">

                                    @Model.CreatedDate.ToString("dd MMM yyyy")

                                </div>

                                <small class="text-muted">

                                    @Model.CreatedDate.ToString("hh:mm tt")

                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- Property Usage -->
                    <div class="mt-4">

                        <div class="alert alert-info border-0 mb-0">

                            <div class="d-flex align-items-start">

                                <i class="bi bi-info-circle-fill fs-5 me-2"></i>

                                <div>

                                    <strong>Property Assignment</strong>

                                    <p class="mb-0 mt-1">
                                        This amenity can be assigned to properties
                                        through the Property Amenities management section.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Card Footer -->
                <div class="card-footer bg-white border-0 p-4">

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary px-4">

                            <i class="bi bi-arrow-left me-1"></i>
                            Back

                        </a>


                        <a asp-action="Edit"
                           asp-route-id="@Model.AmenityId"
                           class="btn btn-primary px-4">

                            <i class="bi bi-pencil me-1"></i>
                            Edit Amenity

                        </a>


                        <a asp-action="Delete"
                           asp-route-id="@Model.AmenityId"
                           class="btn btn-outline-danger px-4">

                            <i class="bi bi-trash me-1"></i>
                            Delete

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>