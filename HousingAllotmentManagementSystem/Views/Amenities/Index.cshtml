@model IEnumerable<HousingAllotmentManagementSystem.Models.Amenity>

@{
    ViewData["Title"] = "Amenities";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-stars text-primary me-2"></i>
                Amenities
            </h2>

            <p class="text-muted mb-0">
                Manage property amenities and their availability.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Amenity
        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">

        <!-- Total -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-stars text-primary fs-4"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Total Amenities
                        </div>

                        <h4 class="fw-bold mb-0">
                            @Model.Count()
                        </h4>
                    </div>

                </div>

            </div>

        </div>


        <!-- Active -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-check-circle text-success fs-4"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Active Amenities
                        </div>

                        <h4 class="fw-bold mb-0">
                            @Model.Count(a => a.Status)
                        </h4>
                    </div>

                </div>

            </div>

        </div>


        <!-- Inactive -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="bg-danger bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-x-circle text-danger fs-4"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Inactive Amenities
                        </div>

                        <h4 class="fw-bold mb-0">
                            @Model.Count(a => !a.Status)
                        </h4>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm">

        <!-- Card Header -->
        <div class="card-header bg-white border-0 py-3">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-list-ul text-primary me-2"></i>
                        Amenity List
                    </h5>

                </div>

                <div class="col-md-6 mt-3 mt-md-0">

                    <div class="input-group">

                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="amenitySearch"
                               class="form-control"
                               placeholder="Search amenities..." />

                    </div>

                </div>

            </div>

        </div>


        <!-- Table -->
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="amenitiesTable">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4">
                                #
                            </th>

                            <th>
                                Amenity Name
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Created Date
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td class="px-4 fw-semibold text-muted">
                                        @item.AmenityId
                                    </td>


                                    <!-- Amenity Name -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">

                                                <i class="bi bi-star-fill text-primary"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold amenity-name">
                                                    @item.AmenityName
                                                </div>

                                                <small class="text-muted">
                                                    Property Amenity
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (item.Status)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2">

                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2">

                                                <i class="bi bi-x-circle-fill me-1"></i>
                                                Inactive

                                            </span>
                                        }

                                    </td>


                                    <!-- Created Date -->
                                    <td>

                                        <span class="text-muted">

                                            <i class="bi bi-calendar3 me-1"></i>

                                            @item.CreatedDate.ToString("dd MMM yyyy")

                                        </span>

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="btn-group"
                                             role="group">

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@item.AmenityId"
                                               class="btn btn-sm btn-outline-info"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@item.AmenityId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit Amenity">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@item.AmenityId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete Amenity">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-stars fs-1 d-block mb-3"></i>

                                        <h5>
                                            No Amenities Found
                                        </h5>

                                        <p class="mb-3">
                                            Start by adding your first property amenity.
                                        </p>

                                        <a asp-action="Create"
                                           class="btn btn-primary">

                                            <i class="bi bi-plus-circle me-1"></i>
                                            Add Amenity

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- Footer -->
        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white border-0 py-3">

                <div class="text-muted small">

                    Showing
                    <strong>@Model.Count()</strong>
                    amenity@(Model.Count() == 1 ? "" : "ies")

                </div>

            </div>
        }

    </div>

</div>


@section Scripts {

    <script>

        // ================================
        // Amenity Search
        // ================================

        document
            .getElementById("amenitySearch")
            .addEventListener("keyup", function() {

                let searchValue =
                    this.value.toLowerCase();

                let rows =
                    document.querySelectorAll(
                        "#amenitiesTable tbody tr"
                    );

                rows.forEach(function(row) {

                    let text =
                        row.innerText.toLowerCase();

                    if (text.includes(searchValue)) {

                        row.style.display = "";

                    }
                    else {

                        row.style.display = "none";

                    }

                });

            });

    </script>

}