@model IEnumerable<HousingAllotmentManagementSystem.Models.PropertyAmenity>

@{
    ViewData["Title"] = "Property Amenities";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    ```
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-tags text-primary me-2"></i>
                Property Amenities
            </h2>

            <p class="text-muted mb-0">
                Manage amenities assigned to properties.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Assign Amenity
        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Main Card -->
    <div class="card border-0 shadow-sm">

        <!-- Card Header -->
        <div class="card-header bg-white border-0 py-3">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-list-check me-2 text-primary"></i>
                        Assigned Amenities
                    </h5>

                    <small class="text-muted">
                        View and manage property amenity assignments
                    </small>

                </div>

                <div class="col-md-6 mt-3 mt-md-0">

                    <div class="input-group">

                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="amenitySearch"
                               class="form-control border-start-0"
                               placeholder="Search property or amenity..." />

                    </div>

                </div>

            </div>

        </div>


        <!-- Table -->
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="propertyAmenityTable">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4">
                                #
                            </th>

                            <th>
                                Property
                            </th>

                            <th>
                                Amenity
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td class="px-4 fw-semibold text-muted">
                                        #@item.PropertyAmenityId
                                    </td>


                                    <!-- Property -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="rounded-circle bg-primary-subtle
                                                text-primary p-2 me-3">

                                                <i class="bi bi-house-door"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">

                                                    @if (item.Property != null)
                                                    {
                                                        @item.Property.UnitNumber
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">
                                                            Property not available
                                                        </span>
                                                    }

                                                </div>

                                                <small class="text-muted">
                                                    Property ID:
                                                    @(item.PropertyId?.ToString() ?? "N/A")
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Amenity -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="rounded-circle bg-success-subtle
                                                text-success p-2 me-3">

                                                <i class="bi bi-star"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">

                                                    @if (item.Amenity != null)
                                                    {
                                                        @item.Amenity.AmenityName
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">
                                                            Amenity not available
                                                        </span>
                                                    }

                                                </div>

                                                <small class="text-muted">
                                                    Amenity ID:
                                                    @(item.AmenityId?.ToString() ?? "N/A")
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (item.Amenity != null && item.Amenity.Status)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2">

                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-3 py-2">

                                                <i class="bi bi-x-circle-fill me-1"></i>
                                                Inactive

                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="btn-group"
                                             role="group">

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@item.PropertyAmenityId"
                                               class="btn btn-sm btn-outline-info"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@item.PropertyAmenityId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@item.PropertyAmenityId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-tags fs-1 d-block mb-3"></i>

                                        <h5 class="fw-semibold">
                                            No Property Amenities Found
                                        </h5>

                                        <p class="mb-3">
                                            No amenities have been assigned
                                            to properties yet.
                                        </p>

                                        <a asp-action="Create"
                                           class="btn btn-primary">

                                            <i class="bi bi-plus-circle me-1"></i>
                                            Assign First Amenity

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- Card Footer -->
        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white border-0 py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <small class="text-muted">

                        <i class="bi bi-info-circle me-1"></i>

                        Total Assignments:
                        <strong>@Model.Count()</strong>

                    </small>

                    <small class="text-muted">
                        Property Amenity Management
                    </small>

                </div>

            </div>
        }

    </div>
    ```

</div>

@section Scripts {

    ```
    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const searchInput = document.getElementById("amenitySearch");
            const table = document.getElementById("propertyAmenityTable");

            if (!searchInput || !table) {
                return;
            }

            searchInput.addEventListener("keyup", function() {

                const searchValue =
                    this.value.toLowerCase().trim();

                const rows =
                    table.querySelectorAll("tbody tr");

                rows.forEach(function(row) {

                    const rowText =
                        row.textContent.toLowerCase();

                    if (rowText.includes(searchValue)) {
                        row.style.display = "";
                    }
                    else {
                        row.style.display = "none";
                    }

                });

            });

        });

    </script>
    ```

}
