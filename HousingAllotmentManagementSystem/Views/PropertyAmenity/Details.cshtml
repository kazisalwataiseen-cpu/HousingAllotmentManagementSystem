@model HousingAllotmentManagementSystem.Models.PropertyAmenity

@{
    ViewData["Title"] = "Property Amenity Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    ```
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-tags text-primary me-2"></i>
                Property Amenity Details
            </h2>

            <p class="text-muted mb-0">
                View details of the property amenity assignment.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Property Amenities

        </a>

    </div>


    <!-- Main Card -->
    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card border-0 shadow-sm">

                <!-- Card Header -->
                <div class="card-header bg-primary text-white py-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">
                            <i class="bi bi-eye fs-5"></i>
                        </div>

                        <div>
                            <h5 class="mb-0">
                                Assignment Information
                            </h5>

                            <small class="opacity-75">
                                Property amenity assignment #@Model.PropertyAmenityId
                            </small>
                        </div>

                    </div>

                </div>


                <!-- Card Body -->
                <div class="card-body p-4">

                    <!-- Assignment ID -->
                    <div class="alert alert-light border mb-4">

                        <div class="d-flex align-items-center">

                            <div class="rounded-circle bg-primary-subtle
                                text-primary p-3 me-3">

                                <i class="bi bi-hash fs-5"></i>

                            </div>

                            <div>

                                <small class="text-muted d-block">
                                    Assignment ID
                                </small>

                                <span class="fw-bold fs-5">
                                    #@Model.PropertyAmenityId
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- Details -->
                    <div class="border rounded p-4">

                        <div class="row g-4">

                            <!-- Property -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-2">

                                    <i class="bi bi-house-door me-1"></i>
                                    Property

                                </div>

                                <div class="d-flex align-items-center">

                                    <div class="rounded-circle bg-primary-subtle
                                        text-primary p-2 me-3">

                                        <i class="bi bi-house"></i>

                                    </div>

                                    <div>

                                        @if (Model.Property != null)
                                        {
                                            <div class="fw-semibold fs-5">
                                                @Model.Property.UnitNumber
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-semibold text-muted">
                                                Property not available
                                            </div>
                                        }

                                        <small class="text-muted">
                                            Property ID:
                                            @(Model.PropertyId?.ToString() ?? "N/A")
                                        </small>

                                    </div>

                                </div>

                            </div>


                            <!-- Amenity -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-2">

                                    <i class="bi bi-star me-1"></i>
                                    Amenity

                                </div>

                                <div class="d-flex align-items-center">

                                    <div class="rounded-circle bg-success-subtle
                                        text-success p-2 me-3">

                                        <i class="bi bi-tag"></i>

                                    </div>

                                    <div>

                                        @if (Model.Amenity != null)
                                        {
                                            <div class="fw-semibold fs-5">
                                                @Model.Amenity.AmenityName
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-semibold text-muted">
                                                Amenity not available
                                            </div>
                                        }

                                        <small class="text-muted">
                                            Amenity ID:
                                            @(Model.AmenityId?.ToString() ?? "N/A")
                                        </small>

                                    </div>

                                </div>

                            </div>


                            <!-- Property ID -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-house-check me-1"></i>
                                    Property ID
                                </div>

                                <div class="fw-semibold">

                                    @(Model.PropertyId?.ToString() ?? "Not Assigned")

                                </div>

                            </div>


                            <!-- Amenity ID -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    <i class="bi bi-tag me-1"></i>
                                    Amenity ID
                                </div>

                                <div class="fw-semibold">

                                    @(Model.AmenityId?.ToString() ?? "Not Assigned")

                                </div>

                            </div>


                            <!-- Amenity Status -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-2">

                                    <i class="bi bi-toggle-on me-1"></i>
                                    Amenity Status

                                </div>

                                @if (Model.Amenity != null && Model.Amenity.Status)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2">

                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-3 py-2">

                                        <i class="bi bi-x-circle-fill me-1"></i>
                                        Inactive

                                    </span>
                                }

                            </div>


                            <!-- Assignment Status -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-2">

                                    <i class="bi bi-link-45deg me-1"></i>
                                    Assignment Status

                                </div>

                                @if (Model.Property != null && Model.Amenity != null)
                                {
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2">

                                        <i class="bi bi-check-circle me-1"></i>
                                        Assigned

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning px-3 py-2">

                                        <i class="bi bi-exclamation-circle me-1"></i>
                                        Incomplete

                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- Information -->
                    <div class="alert alert-info border-0 mt-4">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-info-circle-fill fs-5 me-2"></i>

                            <div>

                                <strong>Assignment Information</strong>

                                <p class="mb-0 mt-1">
                                    This record represents the relationship between
                                    a property and an amenity. Removing this record
                                    will only remove the amenity assignment; it will
                                    not delete the property or amenity itself.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Card Footer -->
                <div class="card-footer bg-white border-0 p-4">

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary px-4">

                            <i class="bi bi-arrow-left me-1"></i>
                            Back

                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model.PropertyAmenityId"
                           class="btn btn-primary px-4">

                            <i class="bi bi-pencil me-1"></i>
                            Edit

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.PropertyAmenityId"
                           class="btn btn-danger px-4">

                            <i class="bi bi-trash me-1"></i>
                            Delete

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>
    ```

</div>
