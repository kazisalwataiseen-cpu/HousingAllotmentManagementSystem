@model HousingAllotmentManagementSystem.Models.PropertyAmenity

@{
    ViewData["Title"] = "Delete Property Amenity";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    ```
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-trash text-danger me-2"></i>
                Delete Property Amenity
            </h2>

            <p class="text-muted mb-0">
                Review the assignment before permanently removing it.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Property Amenities

        </a>

    </div>


    <!-- Delete Card -->
    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card border-0 shadow-sm">

                <!-- Header -->
                <div class="card-header bg-danger text-white py-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">

                            <i class="bi bi-trash fs-5"></i>

                        </div>

                        <div>

                            <h5 class="mb-0">
                                Confirm Removal
                            </h5>

                            <small class="opacity-75">
                                Assignment ID: #@Model.PropertyAmenityId
                            </small>

                        </div>

                    </div>

                </div>


                <!-- Body -->
                <div class="card-body p-4">

                    <!-- Warning -->
                    <div class="alert alert-danger border-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                            <div>

                                <h6 class="fw-bold mb-1">
                                    Are you sure you want to remove this assignment?
                                </h6>

                                <p class="mb-0">
                                    This will remove the amenity from the selected
                                    property. The property and amenity themselves
                                    will not be deleted.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- Assignment Information -->
                    <div class="border rounded p-4 mt-4">

                        <div class="row g-4">

                            <!-- Assignment ID -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">

                                    <i class="bi bi-hash me-1"></i>
                                    Assignment ID

                                </div>

                                <div class="fw-semibold fs-5">
                                    #@Model.PropertyAmenityId
                                </div>

                            </div>


                            <!-- Property -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-2">

                                    <i class="bi bi-house-door me-1"></i>
                                    Property

                                </div>

                                <div class="d-flex align-items-center">

                                    <div class="rounded-circle bg-primary-subtle
                                        text-primary p-2 me-3">

                                        <i class="bi bi-house"></i>

                                    </div>

                                    <div>

                                        @if (Model.Property != null)
                                        {
                                            <div class="fw-semibold">
                                                @Model.Property.UnitNumber
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-semibold text-muted">
                                                Property not available
                                            </div>
                                        }

                                        <small class="text-muted">
                                            Property ID:
                                            @(Model.PropertyId?.ToString() ?? "N/A")
                                        </small>

                                    </div>

                                </div>

                            </div>


                            <!-- Amenity -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-2">

                                    <i class="bi bi-star me-1"></i>
                                    Amenity

                                </div>

                                <div class="d-flex align-items-center">

                                    <div class="rounded-circle bg-success-subtle
                                        text-success p-2 me-3">

                                        <i class="bi bi-tag"></i>

                                    </div>

                                    <div>

                                        @if (Model.Amenity != null)
                                        {
                                            <div class="fw-semibold">
                                                @Model.Amenity.AmenityName
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-semibold text-muted">
                                                Amenity not available
                                            </div>
                                        }

                                        <small class="text-muted">
                                            Amenity ID:
                                            @(Model.AmenityId?.ToString() ?? "N/A")
                                        </small>

                                    </div>

                                </div>

                            </div>


                            <!-- Property ID -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">

                                    <i class="bi bi-house-check me-1"></i>
                                    Property ID

                                </div>

                                <div class="fw-semibold">
                                    @(Model.PropertyId?.ToString() ?? "Not Assigned")
                                </div>

                            </div>


                            <!-- Amenity ID -->
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">

                                    <i class="bi bi-tag me-1"></i>
                                    Amenity ID

                                </div>

                                <div class="fw-semibold">
                                    @(Model.AmenityId?.ToString() ?? "Not Assigned")
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Information Alert -->
                    <div class="alert alert-warning border-0 mt-4">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-info-circle-fill fs-5 me-2"></i>

                            <div>

                                <strong>What will happen?</strong>

                                <p class="mb-0 mt-1">
                                    Only this property-amenity relationship will
                                    be removed. The property and the amenity will
                                    remain available in the system.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Footer -->
                <div class="card-footer bg-white border-0 p-4">

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="PropertyAmenityId" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>


                            <a asp-action="Details"
                               asp-route-id="@Model.PropertyAmenityId"
                               class="btn btn-outline-info px-4">

                                <i class="bi bi-eye me-1"></i>
                                View Details

                            </a>


                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash me-1"></i>
                                Remove Assignment

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
    ```

</div>
