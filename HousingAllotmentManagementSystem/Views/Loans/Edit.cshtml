@model HousingAllotmentManagementSystem.Models.Loan

@{
    ViewData["Title"] = "Edit Loan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-pencil-square me-2"></i>
                Edit Loan
            </h2>

            <p class="text-muted mb-0">
                Update the selected housing loan.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Loans

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-warning py-3">

                    <h5 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>
                        Edit Loan Information
                    </h5>

                </div>


                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="LoanId" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <div class="row g-4">

                            <!-- Allotment -->
                            <div class="col-md-6">

                                <label asp-for="AllotmentId"
                                       class="form-label fw-semibold">
                                    Allotment
                                </label>

                                <select asp-for="AllotmentId"
                                        class="form-select"
                                        asp-items="ViewBag.AllotmentId">
                                </select>

                                <span asp-validation-for="AllotmentId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Loan Number -->
                            <div class="col-md-6">

                                <label asp-for="LoanNumber"
                                       class="form-label fw-semibold">
                                    Loan Number
                                </label>

                                <input asp-for="LoanNumber"
                                       class="form-control" />

                                <span asp-validation-for="LoanNumber"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Loan Amount -->
                            <div class="col-md-6">

                                <label asp-for="LoanAmount"
                                       class="form-label fw-semibold">
                                    Loan Amount
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">₹</span>

                                    <input asp-for="LoanAmount"
                                           class="form-control"
                                           type="number"
                                           step="0.01" />

                                </div>

                                <span asp-validation-for="LoanAmount"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Down Payment -->
                            <div class="col-md-6">

                                <label asp-for="DownPayment"
                                       class="form-label fw-semibold">
                                    Down Payment
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">₹</span>

                                    <input asp-for="DownPayment"
                                           class="form-control"
                                           type="number"
                                           step="0.01" />

                                </div>

                                <span asp-validation-for="DownPayment"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Interest Rate -->
                            <div class="col-md-6">

                                <label asp-for="InterestRate"
                                       class="form-label fw-semibold">
                                    Interest Rate
                                </label>

                                <div class="input-group">

                                    <input asp-for="InterestRate"
                                           class="form-control"
                                           type="number"
                                           step="0.01" />

                                    <span class="input-group-text">%</span>

                                </div>

                                <span asp-validation-for="InterestRate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Tenure -->
                            <div class="col-md-6">

                                <label asp-for="LoanTenure"
                                       class="form-label fw-semibold">
                                    Loan Tenure
                                </label>

                                <div class="input-group">

                                    <input asp-for="LoanTenure"
                                           class="form-control"
                                           type="number" />

                                    <span class="input-group-text">
                                        Months
                                    </span>

                                </div>

                                <span asp-validation-for="LoanTenure"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- EMI -->
                            <div class="col-md-6">

                                <label asp-for="Emiamount"
                                       class="form-label fw-semibold">
                                    EMI Amount
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">₹</span>

                                    <input asp-for="Emiamount"
                                           class="form-control"
                                           type="number"
                                           step="0.01" />

                                </div>

                                <span asp-validation-for="Emiamount"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Sanction Date -->
                            <div class="col-md-6">

                                <label asp-for="SanctionDate"
                                       class="form-label fw-semibold">
                                    Sanction Date
                                </label>

                                <input asp-for="SanctionDate"
                                       class="form-control"
                                       type="date" />

                                <span asp-validation-for="SanctionDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Status -->
                            <div class="col-md-6">

                                <label asp-for="LoanStatus"
                                       class="form-label fw-semibold">
                                    Loan Status
                                </label>

                                <select asp-for="LoanStatus"
                                        class="form-select">

                                    <option value="Pending">Pending</option>
                                    <option value="Active">Active</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Rejected">Rejected</option>

                                </select>

                                <span asp-validation-for="LoanStatus"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-warning">

                                <i class="bi bi-save me-1"></i>
                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}