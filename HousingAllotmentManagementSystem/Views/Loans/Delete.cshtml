@model HousingAllotmentManagementSystem.Models.Loan

@{
    ViewData["Title"] = "Delete Loan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1 text-danger">
                <i class="bi bi-trash me-2"></i>
                Delete Loan
            </h2>

            <p class="text-muted mb-0">
                Review the loan information before deleting it.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Loans

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-danger text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Confirm Loan Deletion
                    </h5>

                </div>


                <div class="card-body p-4">

                    <div class="alert alert-danger">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        <strong>Warning:</strong>
                        Are you sure you want to delete this loan?

                        This action cannot be undone.

                    </div>


                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Loan ID
                                </small>

                                <h5 class="fw-bold mb-0">
                                    @Model.LoanId
                                </h5>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Loan Number
                                </small>

                                <h5 class="fw-bold mb-0">
                                    @Model.LoanNumber
                                </h5>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Loan Amount
                                </small>

                                <h5 class="fw-bold mb-0">
                                    ₹@Model.LoanAmount.ToString("N2")
                                </h5>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Down Payment
                                </small>

                                <h5 class="fw-bold mb-0">
                                    ₹@Model.DownPayment.ToString("N2")
                                </h5>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Interest Rate
                                </small>

                                <h5 class="fw-bold mb-0">
                                    @Model.InterestRate.ToString("0.00")%
                                </h5>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Monthly EMI
                                </small>

                                <h5 class="fw-bold text-primary mb-0">
                                    ₹@Model.Emiamount.ToString("N2")
                                </h5>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Loan Status
                                </small>

                                <h5 class="mb-0">

                                    @if (Model.LoanStatus == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (Model.LoanStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (Model.LoanStatus == "Completed")
                                    {
                                        <span class="badge bg-primary">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @Model.LoanStatus
                                        </span>
                                    }

                                </h5>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Sanction Date
                                </small>

                                <h5 class="fw-bold mb-0">
                                    @Model.SanctionDate.ToString("dd-MM-yyyy")
                                </h5>

                            </div>

                        </div>

                    </div>


                    <form asp-action="Delete"
                          method="post"
                          class="mt-4">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="LoanId" />


                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-trash me-1"></i>
                                Confirm Delete

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>