@model HousingAllotmentManagementSystem.Models.Loan

@{
    ViewData["Title"] = "Delete Loan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-trash-alt"></i>
                        Delete Loan
                    </h4>
                </div>

                <div class="card-body">

                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Warning!</strong>
                        Are you sure you want to delete this loan record?
                    </div>

                    <table class="table table-bordered">

                        <tr>
                            <th width="35%">Loan Number</th>
                            <td>@Model.LoanNumber</td>
                        </tr>

                        <tr>
                            <th>Allotment ID</th>
                            <td>@Model.AllotmentId</td>
                        </tr>

                        <tr>
                            <th>Loan Amount</th>
                            <td>₹ @Model.LoanAmount.ToString("N2")</td>
                        </tr>

                        <tr>
                            <th>Down Payment</th>
                            <td>₹ @Model.DownPayment.ToString("N2")</td>
                        </tr>

                        <tr>
                            <th>Interest Rate</th>
                            <td>@Model.InterestRate %</td>
                        </tr>

                        <tr>
                            <th>Loan Tenure</th>
                            <td>@Model.LoanTenure Months</td>
                        </tr>

                        <tr>
                            <th>EMI Amount</th>
                            <td>₹ @Model.Emiamount.ToString("N2")</td>
                        </tr>

                        <tr>
                            <th>Sanction Date</th>
                            <td>@Model.SanctionDate.ToString("dd-MMM-yyyy")</td>
                        </tr>

                        <tr>
                            <th>Status</th>
                            <td>

                                @if (Model.LoanStatus == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else if (Model.LoanStatus == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Model.LoanStatus</span>
                                }

                            </td>
                        </tr>

                    </table>

                    <form asp-action="Delete">

                        <input type="hidden" asp-for="LoanId" />

                        <div class="mt-4">

                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i>
                                Delete
                            </button>

                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i>
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>