@model HousingAllotmentManagementSystem.Models.Loan

@{
    ViewData["Title"] = "Loan Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-eye me-2"></i>
                Loan Details
            </h2>

            <p class="text-muted mb-0">
                View complete information about this loan.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Loans

        </a>

    </div>


    <!-- SUMMARY CARDS -->

    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Loan Amount
                    </small>

                    <h4 class="fw-bold mt-2">
                        ₹@Model.LoanAmount.ToString("N2")
                    </h4>

                    <i class="bi bi-cash-stack fs-2 text-primary"></i>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Monthly EMI
                    </small>

                    <h4 class="fw-bold text-primary mt-2">
                        ₹@Model.Emiamount.ToString("N2")
                    </h4>

                    <i class="bi bi-calculator fs-2 text-primary"></i>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Interest Rate
                    </small>

                    <h4 class="fw-bold mt-2">
                        @Model.InterestRate.ToString("0.00")%
                    </h4>

                    <i class="bi bi-percent fs-2 text-warning"></i>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Status
                    </small>

                    <div class="mt-2">

                        @if (Model.LoanStatus == "Active")
                        {
                            <span class="badge bg-success fs-6">
                                Active
                            </span>
                        }
                        else if (Model.LoanStatus == "Pending")
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                Pending
                            </span>
                        }
                        else if (Model.LoanStatus == "Completed")
                        {
                            <span class="badge bg-primary fs-6">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                @Model.LoanStatus
                            </span>
                        }

                    </div>

                    <i class="bi bi-info-circle fs-2 text-secondary"></i>

                </div>

            </div>

        </div>

    </div>


    <!-- LOAN DETAILS -->

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-bank me-2"></i>
                        Loan Information
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row mb-3">
                        <div class="col-6 text-muted">
                            Loan ID
                        </div>
                        <div class="col-6 fw-bold">
                            @Model.LoanId
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">
                            Loan Number
                        </div>
                        <div class="col-6 fw-bold">
                            @Model.LoanNumber
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">
                            Allotment ID
                        </div>
                        <div class="col-6 fw-bold">
                            @Model.AllotmentId
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">
                            Loan Amount
                        </div>
                        <div class="col-6 fw-bold">
                            ₹@Model.LoanAmount.ToString("N2")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">
                            Down Payment
                        </div>
                        <div class="col-6 fw-bold">
                            ₹@Model.DownPayment.ToString("N2")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">
                            Interest Rate
                        </div>
                        <div class="col-6 fw-bold">
                            @Model.InterestRate.ToString("0.00")%
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">
                            Tenure
                        </div>
                        <div class="col-6 fw-bold">
                            @Model.LoanTenure Months
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">
                            Monthly EMI
                        </div>
                        <div class="col-6 fw-bold text-primary">
                            ₹@Model.Emiamount.ToString("N2")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6 text-muted">
                            Sanction Date
                        </div>
                        <div class="col-6 fw-bold">
                            @Model.SanctionDate.ToString("dd MMMM yyyy")
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 text-muted">
                            Created Date
                        </div>
                        <div class="col-6 fw-bold">
                            @Model.CreatedDate.ToString("dd MMMM yyyy")
                        </div>
                    </div>

                </div>

            </div>

        </div>


        <!-- ALLOTMENT -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-house-check me-2"></i>
                        Allotment Information
                    </h5>

                </div>

                <div class="card-body">

                    @if (Model.Allotment != null)
                    {
                        <div class="row mb-3">

                            <div class="col-6 text-muted">
                                Allotment ID
                            </div>

                            <div class="col-6 fw-bold">
                                @Model.AllotmentId
                            </div>

                        </div>

                        <div class="row mb-3">

                            <div class="col-6 text-muted">
                                Allotment Number
                            </div>

                            <div class="col-6 fw-bold">
                                @Model.Allotment.AllotmentNumber
                            </div>

                        </div>

                        <div class="row mb-3">

                            <div class="col-6 text-muted">
                                Allotment Date
                            </div>

                            <div class="col-6 fw-bold">
                                @Model.Allotment.AllotmentDate.ToString("dd MMMM yyyy")
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-6 text-muted">
                                Allotment Status
                            </div>

                            <div class="col-6">

                                <span class="badge bg-success">
                                    @Model.Allotment.AllotmentStatus
                                </span>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <i class="bi bi-house-x display-5 text-muted"></i>

                            <p class="text-muted mt-3">
                                No allotment information available.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- EMI PLANS -->

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">
                <i class="bi bi-calculator me-2"></i>
                EMI Plans
            </h5>

        </div>

        <div class="card-body">

            @if (Model.Emiplans != null && Model.Emiplans.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Plan ID</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Total EMIs</th>
                                <th>Paid</th>
                                <th>Remaining</th>
                                <th>Monthly EMI</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var emi in Model.Emiplans)
                            {
                                <tr>

                                    <td>
                                        #@emi.EmiplanId
                                    </td>

                                    <td>
                                        @emi.EmistartDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        @emi.EmiendDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        @emi.TotalEmis
                                    </td>

                                    <td class="text-success">
                                        @emi.PaidEmis
                                    </td>

                                    <td class="text-danger">
                                        @emi.RemainingEmis
                                    </td>

                                    <td>
                                        ₹@emi.MonthlyEmi.ToString("N2")
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            @emi.PlanStatus
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-4">

                    <i class="bi bi-calculator display-5 text-muted"></i>

                    <p class="text-muted mt-3 mb-0">
                        No EMI plans have been created for this loan.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ACTIONS -->

    <div class="d-flex justify-content-between mt-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back

        </a>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.LoanId"
               class="btn btn-warning">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.LoanId"
               class="btn btn-danger">

                <i class="bi bi-trash me-1"></i>
                Delete

            </a>

        </div>

    </div>

</div>